# LifeCompanion-Rebuild - cloud models (template)
# Copy to the PROJECT PARENT as model_api_keys.env and fill only the providers used.
# The real file must never be committed or copied into a frontend/build context.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
OPENAI_API_KEY=

# SiliconFlow Kolors image generation. Both names are accepted for compatibility;
# IMAGE_PROVIDER_API_KEY is preferred by life-core.
IMAGE_PROVIDER_API_KEY=
SILICONFLOW_API_KEY=
