FROM python:3.12-slim

WORKDIR /app

COPY services/life-core/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY services/life-core/app ./app

ENV PYTHONUNBUFFERED=1 \
    LIFE_HOST=0.0.0.0 \
    LIFE_PORT=8010

EXPOSE 8010

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
