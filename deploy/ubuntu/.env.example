# LifeCompanion V0.3 candidate deployment.
# Copy to .env, then replace every "change_me" value with a secret.
# Never commit .env or this file's real values.

# --- Public exposure -------------------------------------------------------
# Public origin used for CORS and browser links. Use the server IP/domain.
PUBLIC_ORIGIN=http://127.0.0.1:3001
GATEWAY_PORT=3001
# Business timezone. China deployments should use Asia/Shanghai.
TZ=Asia/Shanghai

# --- Shared JWT identity (LibreChat and life-core must match) ---------------
JWT_SECRET=change_me_64_hex
JWT_REFRESH_SECRET=change_me_64_hex
LIFE_INTERNAL_TOKEN=change_me_64_hex
LIFE_ALLOWED_ORIGINS=http://127.0.0.1:3001

# --- life-core credential vault (Linux Fernet key, any long random string) --
LIFE_CREDENTIAL_MASTER_KEY=change_me_long_random

# --- LLM (chat + memory extraction) -----------------------------------------
LIFE_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- LibreChat encryption ---------------------------------------------------
CREDS_KEY=change_me_64_hex
CREDS_IV=change_me_16_hex
MEILI_MASTER_KEY=change_me_32_hex

# --- LibreChat account access (public registration) -------------------------
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_PASSWORD_RESET=false

# --- Memos (V0.2 memory recall, optional) -----------------------------------
# Leave empty to run without the Memos recall upstream.
MEMOS_API_TOKEN=

# --- Reminder push (ntfy admin used by life-core's HTTP provisioning) -------
LIFE_NTFY_ADMIN_USER=lc-admin
LIFE_NTFY_ADMIN_PASSWORD=change_me

# --- Reminder tasks (Vikunja) ------------------------------------------------
VIKUNJA_JWT_SECRET=change_me_64_hex

# --- Moment image generation (optional) -------------------------------------
# SiliconFlow Kolors provider key; leave empty to disable image generation.
IMAGE_PROVIDER_API_KEY=

# --- Admin-only moment direct-test (optional debug capability) ---------------
# The account must match BOTH the LibreChat username and the LibreChat user id.
# Run deploy/ubuntu/scripts/bootstrap-admin.sh after registration to discover
# and write these values automatically for admin@shiguang.test.
LIFE_DIRECT_MOMENT_TEST_ENABLED=false
LIFE_DIRECT_MOMENT_TEST_USERNAME=
LIFE_DIRECT_MOMENT_TEST_USER_ID=
LIFE_DIRECT_MOMENT_TEST_UNLIMITED=false
