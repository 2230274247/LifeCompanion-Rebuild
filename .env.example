# Copy to infra/.env and replace non-secret values. Never commit the real file.
# Cloud model keys belong only in ../model_api_keys.env (sibling of the repo).
POSTGRES_PASSWORD=replace-me
LIFE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
JWT_SECRET=replace-with-a-random-librechat-access-secret
JWT_REFRESH_SECRET=replace-with-the-librechat-refresh-secret
CREDS_KEY=replace-with-64-hex-characters
CREDS_IV=replace-with-32-hex-characters
MEILI_MASTER_KEY=replace-with-a-random-meilisearch-master-key
MEMOS_API_TOKEN=replace-with-a-memos-personal-access-token
MEMOS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-local-password
MEMOS_BASE_URL=http://127.0.0.1:5230
# Optional absolute path. Start scripts default to infra/runtime/memos-tokens.json.
LIFE_MEMOS_TOKENS_FILE=
LIFE_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
LIFE_PUBLIC_URL=http://127.0.0.1:3001
LIFE_CHAT_INTERNAL_URL=http://127.0.0.1:3080
LIFE_ALLOW_REGISTRATION=true
LIFE_TIMEZONE=Asia/Hong_Kong
LIFE_COMPOSE_PROJECT=lifecompanion-upstream
LIFE_REMINDERS_COMPOSE_PROJECT=lifecompanion-reminders
LIFE_BIND_ADDRESS=127.0.0.1
LIFE_LIBRECHAT_PORT=3080
LIFE_MEMOS_PORT=5230
LIFE_CORE_HOST_URL=http://host.docker.internal:8010
LIFE_NTFY_CONTAINER=lifecompanion-ntfy
LIFE_LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
MEMORY_LLM_MAX_TOKENS=2048
# Optional cap across all attempts in this database, including failures/restarts.
# 0 means no database-wide request cap; each extraction still allows at most 3.
MEMORY_LLM_REQUEST_BUDGET=0
# Enable only when a separate reminder scheduler is actually running.
LIFE_REMINDER_SCHEDULER_EXTERNAL=false
# Only trusted HTTPS SiliconFlow hosts may use the generic-binary MIME fallback.
IMAGE_PROVIDER_ALLOW_GENERIC_BINARY_MIME=false
# Recollection scoring has a separate persistent cap. 0 disables paid scoring.
LIFE_MOMENT_SCORING_REQUEST_BUDGET=0
LIFE_MOMENT_SCORING_MAX_TOKENS=1800
LIFE_MOMENT_SCORING_MAX_CANDIDATES=8
# V0.3 stage A stays dark until the isolated acceptance environment enables it.
LIFE_MOMENT_WINDOWS_V03=false
LIFE_MOMENT_SETTLEMENT_SCAN_LIMIT=96
LIFE_MOMENT_SCORE_LEASE_SECONDS=120
# The existing APScheduler may write settlement intents; workers still score separately.
LIFE_MOMENT_SCHEDULER_EXTERNAL=false
LIFE_MOMENT_WORKERS_ENABLED=true
# Stage A never calls an image provider; stage B must opt in explicitly.
LIFE_MOMENT_IMAGE_GENERATION_ENABLED=false
LIFE_MOMENT_IMAGE_REQUEST_BUDGET=0
# No image provider is enabled by A++. Use kolors only with a separate B-phase consent.
LIFE_MOMENT_IMAGE_PROVIDER=
LIFE_MOMENT_IMAGE_MODEL=Kwai-Kolors/Kolors
# Private filesystem root; keep outside tracked source and public static folders.
LIFE_MOMENT_MEDIA_ROOT=

# Explicit read-only tool egress; 0 disables network requests.
# Open-Meteo free tier is for non-commercial use; OSRM demo has no traffic/SLA.
LIFE_TOOL_REQUEST_BUDGET=0
LIFE_TOOL_WEATHER_PROVIDER=
LIFE_TOOL_ROUTE_PROVIDER=
# Optional isolated SearXNG on a loopback HTTP URL; never a client-supplied URL.
LIFE_TOOL_SEARCH_URL=

