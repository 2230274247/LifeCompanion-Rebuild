# Copy to infra/.env and replace every value. Never commit the real file.
POSTGRES_PASSWORD=replace-me
LIFE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-the-librechat-refresh-secret
MEMOS_API_TOKEN=replace-with-a-memos-personal-access-token
MEMOS_BASE_URL=http://127.0.0.1:5230
LIFE_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
LIFE_TIMEZONE=Asia/Hong_Kong
DEEPSEEK_API_KEY=
LIFE_LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
MEMORY_LLM_MAX_TOKENS=2048
# Optional cap across all attempts in this database, including failures/restarts.
# 0 means no database-wide request cap; each extraction still allows at most 3.
MEMORY_LLM_REQUEST_BUDGET=0
# Enable only when a separate reminder scheduler is actually running.
LIFE_REMINDER_SCHEDULER_EXTERNAL=false
IMAGE_PROVIDER_API_KEY=
# Recollection scoring has a separate persistent cap. 0 disables paid scoring.
LIFE_MOMENT_SCORING_REQUEST_BUDGET=0
LIFE_MOMENT_SCORING_MAX_TOKENS=1800
LIFE_MOMENT_SCORING_MAX_CANDIDATES=8

# Explicit read-only tool egress; 0 disables network requests.
# Open-Meteo free tier is for non-commercial use; OSRM demo has no traffic/SLA.
LIFE_TOOL_REQUEST_BUDGET=0
LIFE_TOOL_WEATHER_PROVIDER=
LIFE_TOOL_ROUTE_PROVIDER=
# Optional isolated SearXNG on a loopback HTTP URL; never a client-supplied URL.
LIFE_TOOL_SEARCH_URL=

