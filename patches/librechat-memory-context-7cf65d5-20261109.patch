+import { Button } from '@librechat/client';
+import { useQuery } from '@tanstack/react-query';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+const statusKeys = {
+  queued: 'com_life_pipeline_queued', saved: 'com_life_pipeline_saved',
+  rejected: 'com_life_pipeline_rejected', failed: 'com_life_pipeline_failed',
+  retrying: 'com_life_pipeline_retrying', matched: 'com_life_pipeline_matched',
+  no_match: 'com_life_pipeline_no_match', permission_denied: 'com_life_pipeline_permission',
+  injected: 'com_life_pipeline_injected', unavailable: 'com_life_pipeline_unavailable',
+  excluded: 'com_life_pipeline_excluded', expired: 'com_life_pipeline_expired',
+  disabled: 'com_life_pipeline_disabled', empty_input: 'com_life_pipeline_empty',
+  not_attempted: 'com_life_pipeline_not_attempted',
+  published: 'com_life_pipeline_published',
+  user_not_mapped: 'com_life_pipeline_user_not_mapped',
+} as const;
+
+const stageKeys = {
+  enqueue: 'com_life_pipeline_stage_enqueue',
+  extraction: 'com_life_pipeline_stage_extraction',
+  recall: 'com_life_pipeline_stage_recall',
+  delivery: 'com_life_pipeline_stage_delivery',
+  publication: 'com_life_pipeline_stage_publication',
+} as const;
+
+export default function MemoryStatus() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const status = useQuery({
+    queryKey: [QueryKeys.lifeMemoryStatus, user?.id],
+    queryFn: lifeService.memoryStatus,
+    enabled: Boolean(user?.id),
+    retry: false,
+  });
+  return (
+    <section aria-label={localize('com_life_pipeline_title')} className="space-y-3 rounded-2xl border border-border-light p-5">
+      <div className="flex items-center justify-between gap-3">
+        <h2 className="text-lg font-semibold">{localize('com_life_pipeline_title')}</h2>
+        <Button variant="outline" disabled={status.isFetching} onClick={() => void status.refetch()}>
+          {localize('com_life_pipeline_refresh')}
+        </Button>
+      </div>
+      <p className="text-sm text-text-secondary">{localize('com_life_pipeline_notice')}</p>
+      {status.isLoading ? <p role="status">{localize('com_life_pipeline_loading')}</p> : null}
+      {status.isError ? <p role="alert">{localize('com_life_pipeline_unavailable')}</p> : null}
+      {status.data ? (
+        <>
+          <p>{localize(status.data.permissions.recall_consent ? 'com_life_pipeline_recall_on' : 'com_life_pipeline_recall_off')}</p>
+          {status.data.traces.length === 0 ? <p>{localize('com_life_pipeline_no_records')}</p> : null}
+          <ol className="space-y-2">
+            {status.data.traces.slice(0, 8).map((trace) => (
+              <li key={trace.trace_id} className="flex flex-wrap justify-between gap-2 border-t border-border-light pt-2 text-sm">
+                <span>
+                  {localize(stageKeys[trace.stage as keyof typeof stageKeys] ?? 'com_life_pipeline_title')}
+                  {' · '}
+                  {localize(statusKeys[trace.status as keyof typeof statusKeys] ?? 'com_life_pipeline_not_attempted')}
+                </span>
+                <time dateTime={trace.created_at} className="text-text-secondary">{new Date(trace.created_at).toLocaleString()}</time>
+              </li>
+            ))}
+          </ol>
+        </>
+      ) : null}
+    </section>
+  );
+}
