@@ -0,0 +1,36 @@
+import React from 'react';
+import { lifeService } from 'librechat-data-provider';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen } from '@testing-library/react';
+import MemoryStatus from '../MemoryStatus';
+
+jest.mock('~/hooks', () => ({
+  useAuthContext: () => ({ user: { id: 'synthetic-owner' } }),
+  useLocalize: () => (key: string) => key,
+}));
+
+function mount() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false, cacheTime: 0 } } });
+  render(<QueryClientProvider client={client}><MemoryStatus /></QueryClientProvider>);
+}
+
+test('distinguishes a completed search without a match from injected evidence', async () => {
+  jest.spyOn(lifeService, 'memoryStatus').mockResolvedValue({
+    traces: [
+      { trace_id: 2, stage: 'recall', status: 'no_match', reason: '', item_count: 0, created_at: '2026-11-08T10:00:00Z' },
+      { trace_id: 1, stage: 'recall', status: 'injected', reason: '', item_count: 2, created_at: '2026-11-08T09:00:00Z' },
+    ], jobs: {}, permissions: { recall_consent: true, sensitive_consent: false },
+    memory_consent: true, database_id: 'synthetic', extractor_configured: false,
+  });
+  mount();
+  expect(await screen.findByText('com_life_pipeline_no_match')).toBeInTheDocument();
+  expect(screen.getByText('com_life_pipeline_injected')).toBeInTheDocument();
+});
+
+test('shows an unavailable service and provides a retry', async () => {
+  const fetchStatus = jest.spyOn(lifeService, 'memoryStatus').mockRejectedValue(new Error('unavailable'));
+  mount();
+  expect(await screen.findByRole('alert')).toHaveTextContent('com_life_pipeline_unavailable');
+  fireEvent.click(screen.getByRole('button', { name: 'com_life_pipeline_refresh' }));
+  expect(fetchStatus.mock.calls.length).toBeGreaterThanOrEqual(2);
+});
