+import { Link, useParams } from 'react-router-dom';
+import { Button, Spinner } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function KnowledgeDetail() {
+  const { knowledgeId = '' } = useParams();
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const exclude = useMutation(() => lifeService.excludeMoments(knowledgeId), {
+    onSuccess: () => {
+      void cache.invalidateQueries([QueryKeys.lifeMoments, user?.id]);
+      void cache.invalidateQueries([QueryKeys.lifeMoment, user?.id]);
+      void cache.invalidateQueries([QueryKeys.lifeChatLinks, user?.id]);
+    },
+  });
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeKnowledgeDetail, user?.id, knowledgeId],
+    queryFn: () => lifeService.knowledgeDetail(knowledgeId),
+    retry: false,
+  });
+  const item = query.data?.item;
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-5">
+        <Link
+          to="/memory-settings"
+          className="inline-flex min-h-11 items-center text-link underline"
+        >
+          {localize('com_life_memory_settings')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_view_knowledge')}</h1>
+        {query.isLoading ? <Spinner /> : null}
+        {query.isError ? (
+          <div role="alert">
+            {localize('com_life_entity_unavailable')}
+            <Button onClick={() => void query.refetch()}>{localize('com_ui_retry')}</Button>
+          </div>
+        ) : null}
+        {item ? (
+          <article className="space-y-4 rounded-2xl border border-border-light bg-surface-primary-alt p-5">
+            <p className="break-words leading-7">
+              {item.canonical_text || localize('com_life_forgotten')}
+            </p>
+            <p>
+              {localize(
+                item.kind === 'future_plan'
+                  ? 'com_life_plan_record'
+                  : item.kind === 'life_event'
+                    ? 'com_life_event_record'
+                    : 'com_life_fact_record',
+              )}
+            </p>
+            <p>
+              {localize('com_life_entity_status')}: {item.state}
+            </p>
+            <time>{item.valid_from}</time>
+            {item.sources
+              ?.filter((source) => source.conversation_id)
+              .map((source) => (
+                <Link
+                  key={source.message_id}
+                  className="block min-h-11 text-link underline"
+                  to={`/c/${encodeURIComponent(source.conversation_id ?? '')}?message=${encodeURIComponent(source.message_id)}`}
+                >
+                  {localize('com_life_open_chat')} · {source.evidence_date}
+                </Link>
+              ))}
+            {item.event_id && item.state === 'active' && item.event_status === 'published' ? (
+              <Link
+                className="block min-h-11 text-link underline"
+                to={`/memories/${item.event_id}`}
+              >
+                {localize('com_life_view_event')}
+              </Link>
+            ) : null}
+            {item.kind === 'life_event' && item.state === 'active' ? (
+              <>
+                <Button
+                  variant="outline"
+                  disabled={exclude.isLoading || exclude.isSuccess}
+                  onClick={() => exclude.mutate()}
+                >
+                  {localize('com_life_exclude_moment')}
+                </Button>
+                {exclude.isSuccess ? (
+                  <p role="status">{localize('com_life_excluded_moment')}</p>
+                ) : null}
+                {exclude.isError ? <p role="alert">{localize('com_life_error')}</p> : null}
+              </>
+            ) : null}
+            <Link className="block min-h-11 text-link underline" to="/memory-settings">
+              {localize('com_life_correct_fact')} / {localize('com_life_forget')}
+            </Link>
+          </article>
+        ) : null}
+      </div>
+    </main>
+  );
+}
