diff --git a/packages/data-provider/src/life.ts b/packages/data-provider/src/life.ts
new file mode 100644
index 000000000..a134854aa
--- /dev/null
+++ b/packages/data-provider/src/life.ts
@@ -0,0 +1,316 @@
+import request from './request';
+
+export type LifeMemory = {
+  event_id: string;
+  title: string;
+  summary: string;
+  content: string;
+  occurred_at: string;
+  source_type: string;
+  source_message_ids: string[];
+  conversation_id: string | null;
+  event_type: string;
+  tags: string[];
+};
+
+export type LifeMemories = {
+  memories: LifeMemory[];
+  total: number;
+  page: number;
+  page_size: number;
+  has_more: boolean;
+};
+
+export type LifePermissions = {
+  timezone?: string;
+  memory_consent: boolean;
+  recall_consent: boolean;
+  sensitive_consent: boolean;
+  image_consent: boolean;
+  notification_consent: boolean;
+};
+
+export type LifeFact = {
+  memory_id: string;
+  canonical_text: string;
+  kind: 'stable_fact' | 'life_event' | 'future_plan';
+  state: string;
+  evidence_count: number;
+  event_id?: string | null;
+  event_status?: string | null;
+  valid_from?: string;
+  sources?: Array<{ message_id: string; conversation_id: string | null; evidence_date: string }>;
+};
+
+export type LifeChatLink = {
+  message_id: string;
+  memory_id: string;
+  event_id: string | null;
+  canonical_text: string;
+  url: string;
+  moments?: Array<{ moment_id: string; status: string }>;
+};
+
+export type LifeMoment = {
+  moment_id: string;
+  window_start: string;
+  window_end: string;
+  timezone: string;
+  slot: number;
+  status: string;
+  caption: string;
+  source_memory_ids: string[];
+  ai_generated: boolean;
+  attempts: number;
+  error_code: string | null;
+  image_data?: string | null;
+  retry_allowed?: boolean;
+  selection?: Array<{
+    memory_id: string;
+    score: number;
+    dimensions: Record<string, number>;
+    eligible?: boolean;
+    reason_code?: string;
+    source_message_ids?: string[];
+  }>;
+};
+
+export type LifeMomentSettings = {
+  enabled: boolean;
+  timezone: string;
+  ends: string[];
+  weights: Record<string, number>;
+  proposed?: boolean;
+};
+
+export type LifeReminder = {
+  reminder_id: string;
+  title: string;
+  scheduled_at: string;
+  timezone: string;
+  status: 'scheduled' | 'due' | 'cancelled' | 'completed';
+  delivery_channel: 'push';
+  notification_status?: 'waiting' | 'pending' | 'sending' | 'accepted' | 'suppressed';
+  created_at: string;
+  updated_at: string;
+  source?: { conversation_id: string; source_message_id: string; fields: LifeDraftFields } | null;
+};
+
+export type ReminderAvailability = {
+  configured: boolean;
+  status?:
+    | 'not_configured'
+    | 'consent_required'
+    | 'provisioning'
+    | 'ready'
+    | 'service_unavailable'
+    | 'permission_denied';
+  error_code?: string | null;
+};
+
+export type LifeReminderDraft = {
+  quick_choice?: {
+    field: 'event_date' | 'event_time';
+    options: Array<{ label: string; value: string }>;
+    other: 'date' | 'time';
+  } | null;
+  parsed_at?: string;
+  reminder_date?: string | null;
+  reminder_time?: string | null;
+  reference_options?: Array<{
+    draft_id: string;
+    source_message_id: string;
+    title: string | null;
+    event_date: string | null;
+    event_time: string | null;
+  }>;
+  draft_id: string;
+  conversation_id: string;
+  source_message_id: string;
+  source_text: string;
+  title: string | null;
+  event_date: string | null;
+  event_time: string | null;
+  timezone: string | null;
+  lead_minutes: number | null;
+  place: string | null;
+  revision: number;
+  status:
+    | 'needs_input'
+    | 'ready_to_confirm'
+    | 'creating'
+    | 'scheduled'
+    | 'unknown'
+    | 'cancelled'
+    | 'completed'
+    | 'expired'
+    | 'unavailable';
+  expires_at: string;
+  missing_fields: string[];
+  preview: { event_at: string; scheduled_at: string; timezone: string } | null;
+  error_code: string | null;
+  reminder: (LifeReminder & { upstream_task_id: number }) | null;
+  availability: ReminderAvailability;
+};
+
+export type LifeDraftFields = Pick<
+  LifeReminderDraft,
+  'title' | 'event_date' | 'event_time' | 'timezone' | 'lead_minutes' | 'place'
+>;
+
+export type LifeToolChat = {
+  interaction_id: string;
+  conversation_id: string | null;
+  source_message_id: string | null;
+  status: string;
+  revision: number;
+  forecast_date: string | null;
+  timezone: string | null;
+  places: Array<{ name: string; country: string; admin1: string }> | null;
+  execution: {
+    status: string;
+    name: string;
+    error_code: string | null;
+    result: {
+      place_label?: string;
+      current?: { time: string; temperature_2m: number; precipitation: number };
+      daily?: {
+        time: string[];
+        temperature_2m_max: number[];
+        temperature_2m_min: number[];
+        precipitation_sum: number[];
+      };
+      units?: {
+        temperature_2m?: string;
+        precipitation?: string;
+        temperature_2m_max?: string;
+        precipitation_sum?: string;
+      };
+      sources?: Array<{ title: string; url: string; fetched_at: string }>;
+    };
+  } | null;
+};
+
+export const lifeService = {
+  toolChats: (conversationId: string, signal?: AbortSignal) =>
+    request.get<{ interactions: LifeToolChat[] }>(
+      `/life-api/api/v1/tool-chats?conversation_id=${encodeURIComponent(conversationId)}`,
+      { signal },
+    ),
+  selectToolPlace: (
+    id: string,
+    revision: number,
+    choice: { place_index?: number; place_query?: string },
+  ): Promise<LifeToolChat> =>
+    request.post(`/life-api/api/v1/tool-chats/${encodeURIComponent(id)}/select`, {
+      revision,
+      ...choice,
+    }),
+  cancelToolChat: (id: string) =>
+    request.delete(`/life-api/api/v1/tool-chats/${encodeURIComponent(id)}`),
+  moments: () => request.get<{ moments: LifeMoment[] }>('/life-api/api/v1/moments'),
+  moment: (id: string) =>
+    request.get<{ moment: LifeMoment }>(`/life-api/api/v1/moments/${encodeURIComponent(id)}`),
+  momentSettings: () => request.get<LifeMomentSettings>('/life-api/api/v1/moment-settings'),
+  saveMomentSettings: (body: LifeMomentSettings): Promise<LifeMomentSettings> =>
+    request.put('/life-api/api/v1/moment-settings', body),
+  retryMoment: (id: string) =>
+    request.post(`/life-api/api/v1/moments/${encodeURIComponent(id)}/retry`),
+  deleteMoment: (id: string) =>
+    request.delete(`/life-api/api/v1/moments/${encodeURIComponent(id)}`),
+  excludeMoments: (id: string) =>
+    request.post(`/life-api/api/v1/knowledge/${encodeURIComponent(id)}/exclude-moments`),
+  permissions: () => request.get<LifePermissions>('/life-api/api/v1/me'),
+  setPermissions: (body: Partial<LifePermissions>): Promise<LifePermissions> =>
+    request.patch('/life-api/api/v1/me/settings', body),
+  knowledge: () => request.get<{ items: LifeFact[] }>('/life-api/api/v1/knowledge'),
+  knowledgeDetail: (id: string) =>
+    request.get<{ item: LifeFact }>(`/life-api/api/v1/knowledge/${encodeURIComponent(id)}`),
+  chatLinks: (id: string, signal?: AbortSignal) =>
+    request.get<{
+      links: LifeChatLink[];
+      actions?: Array<{
+        message_id: string;
+        status: string;
+        code: string | null;
+        memory_id: string | null;
+      }>;
+    }>(`/life-api/api/v1/chat-links?conversation_id=${encodeURIComponent(id)}`, { signal }),
+  correctFact: (id: string, text: string) =>
+    request.patch(`/life-api/api/v1/knowledge/${encodeURIComponent(id)}`, { text }),
+  forget: (id: string) =>
+    request.delete<{ state: string; cleanup: string }>(
+      `/life-api/api/v1/knowledge/${encodeURIComponent(id)}`,
+    ),
+  memories: (params: string, signal?: AbortSignal) =>
+    request.get<LifeMemories>(`/life-api/api/v1/memories?${params}`, { signal }),
+  memory: (id: string, signal?: AbortSignal) =>
+    request.get<{ memory: LifeMemory }>(`/life-api/api/v1/memories/${encodeURIComponent(id)}`, {
+      signal,
+    }),
+  reminders: (signal?: AbortSignal) =>
+    request.get<ReminderAvailability & { reminders: LifeReminder[] }>(
+      '/life-api/api/v1/reminders',
+      {
+        signal,
+      },
+    ),
+  reminder: (id: string, signal?: AbortSignal) =>
+    request.get<{ reminder: LifeReminder }>(
+      `/life-api/api/v1/reminders/${encodeURIComponent(id)}`,
+      { signal },
+    ),
+  selectReminderDraft: (
+    id: string,
+    revision: number,
+    fields: Partial<LifeDraftFields>,
+  ): Promise<LifeReminderDraft> =>
+    request.post(`/life-api/api/v1/reminder-drafts/${encodeURIComponent(id)}/select`, {
+      revision,
+      fields,
+    }),
+  provisionReminders: (): Promise<ReminderAvailability> =>
+    request.post('/life-api/api/v1/reminder-provisioning'),
+  reminderDrafts: (conversationId: string, signal?: AbortSignal) =>
+    request.get<{ drafts: LifeReminderDraft[] }>(
+      `/life-api/api/v1/reminder-drafts?conversation_id=${encodeURIComponent(conversationId)}`,
+      { signal },
+    ),
+  updateReminderDraft: (
+    id: string,
+    revision: number,
+    body: Partial<LifeDraftFields>,
+  ): Promise<LifeReminderDraft> =>
+    request.patch(`/life-api/api/v1/reminder-drafts/${encodeURIComponent(id)}`, body, {
+      headers: { 'If-Match': String(revision) },
+    }),
+  confirmReminderDraft: (id: string, revision: number): Promise<LifeReminderDraft> =>
+    request.post(`/life-api/api/v1/reminder-drafts/${encodeURIComponent(id)}/confirm`, {
+      revision,
+      idempotency_key: `${id}:${revision}`,
+    }),
+  cancelReminderDraft: (id: string) =>
+    request.delete<LifeReminderDraft>(`/life-api/api/v1/reminder-drafts/${encodeURIComponent(id)}`),
+  reconcileReminderDraft: (id: string): Promise<LifeReminderDraft> =>
+    request.post(`/life-api/api/v1/reminder-drafts/${encodeURIComponent(id)}/reconcile`),
+  reminderNotifications: (signal?: AbortSignal) =>
+    request.get<{ messages: Array<{ id: string; title: string; message: string; time: number }> }>(
+      '/life-api/api/v1/reminder-notifications',
+      { signal },
+    ),
+  createReminder: (body: {
+    title: string;
+    scheduled_at: string;
+    timezone: string;
+    delivery_channel: 'push';
+  }): Promise<{ reminder: LifeReminder }> => request.post('/life-api/api/v1/reminders', body),
+  updateReminder: (
+    id: string,
+    body: { title?: string; scheduled_at?: string; timezone?: string; done?: boolean },
+  ): Promise<{ reminder: LifeReminder }> =>
+    request.patch(`/life-api/api/v1/reminders/${encodeURIComponent(id)}`, body),
+  cancelReminder: (id: string) =>
+    request.delete<{ reminder: LifeReminder }>(
+      `/life-api/api/v1/reminders/${encodeURIComponent(id)}`,
+    ),
+};
