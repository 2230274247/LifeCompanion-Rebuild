+  delivery_channel: 'push' as const,
+  created_at: '2026-11-02T12:00:00Z',
+  updated_at: '2026-11-02T12:00:00Z',
+};
+
+function mount() {
+  const client = new QueryClient({
+    defaultOptions: { queries: { retry: false, cacheTime: 0 } },
+  });
+  render(
+    <QueryClientProvider client={client}>
+      <MemoryRouter initialEntries={['/reminders']}>
+        <Reminders />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+
+beforeEach(() => {
+  jest.spyOn(lifeService, 'permissions').mockResolvedValue({
+    memory_consent: true,
+    recall_consent: true,
+    sensitive_consent: false,
+    image_consent: false,
+    notification_consent: true,
+  });
+  jest.spyOn(lifeService, 'reminderNotifications').mockResolvedValue({ messages: [] });
+});
+
+test('creates a real push reminder without a redundant channel selector', async () => {
+  jest.spyOn(lifeService, 'reminders').mockResolvedValue({ configured: true, reminders: [] });
+  const create = jest.spyOn(lifeService, 'createReminder').mockResolvedValue({ reminder });
+  mount();
+  fireEvent.click(screen.getByText('com_life_reminder_manual'));
+  fireEvent.change(await screen.findByLabelText('com_life_reminder_title'), {
+    target: { value: '带上身份证' },
+  });
+  fireEvent.click(screen.getByRole('button', { name: /com_life_reminder_add/ }));
+  await waitFor(() =>
+    expect(create).toHaveBeenCalledWith(
+      expect.objectContaining({
+        title: '带上身份证',
+        delivery_channel: 'push',
+        timezone: expect.any(String),
+      }),
+    ),
+  );
+  expect(screen.queryByLabelText(/channel|通知方式/i)).not.toBeInTheDocument();
+});
+
+test('edits and cancels through the API and shows server status', async () => {
+  jest
+    .spyOn(lifeService, 'reminders')
+    .mockResolvedValue({ configured: true, reminders: [reminder] });
+  const update = jest.spyOn(lifeService, 'updateReminder').mockResolvedValue({
+    reminder: { ...reminder, title: '更新后的提醒' },
+  });
+  const cancel = jest.spyOn(lifeService, 'cancelReminder').mockResolvedValue({
+    reminder: { ...reminder, status: 'cancelled' },
+  });
+  jest.spyOn(window, 'confirm').mockReturnValue(true);
+  mount();
+  expect(await screen.findByText('带上身份证')).toBeInTheDocument();
+  expect(screen.getByText(/com_life_reminder_scheduled/)).toBeInTheDocument();
+  fireEvent.click(screen.getByRole('button', { name: 'com_life_reminder_edit' }));
+  fireEvent.change(screen.getAllByLabelText('com_life_reminder_title')[1], {
+    target: { value: '更新后的提醒' },
+  });
+  fireEvent.click(screen.getByRole('button', { name: 'com_ui_save' }));
+  await waitFor(() =>
+    expect(update).toHaveBeenCalledWith(
