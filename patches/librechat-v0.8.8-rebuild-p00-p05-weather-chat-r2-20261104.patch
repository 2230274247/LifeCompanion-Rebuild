+        <Link
+          className="inline-flex min-h-11 items-center text-link underline"
+          to="/moments/settings"
+        >
+          {localize('com_life_moment_settings')}
+        </Link>
+      </div>
+      {query.isLoading ? <Spinner /> : null}
+      {query.isError ? (
+        <Button onClick={() => void query.refetch()}>{localize('com_life_sources_retry')}</Button>
+      ) : null}
+      {query.isSuccess && !query.data.moments.length ? (
+        <p>{localize('com_life_no_moments')}</p>
+      ) : null}
+      <div className="grid gap-3 sm:grid-cols-2">
+        {query.data?.moments.map((item) => (
+          <Link
+            key={item.moment_id}
+            className="space-y-2 rounded-2xl border border-border-light bg-surface-primary-alt p-4 text-text-primary"
