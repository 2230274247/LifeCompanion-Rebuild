+import { useEffect, useRef, useState } from 'react';
+import { useQuery } from '@tanstack/react-query';
+import { Button, Spinner } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { Link, useLocation, useParams, useSearchParams } from 'react-router-dom';
+import { useAuthContext, useLocalize } from '~/hooks';
+import { MomentList } from './Moments';
+
+const formatTime = (value: string) =>
+  new Intl.DateTimeFormat('zh-CN', {
+    timeZone: 'Asia/Hong_Kong',
+    dateStyle: 'long',
+    timeStyle: 'short',
+  }).format(new Date(value));
+
+function readableContent(content: string, title: string) {
+  const footer = content.indexOf('\n\n> AI 生活伙伴记录 · 事件 `');
+  if (footer < 0) {
+    return content;
+  }
+  const body = content.slice(0, footer);
+  const heading = `# ${title}\n\n`;
+  return body.startsWith(heading) ? body.slice(heading.length) : body;
+}
+
+export default function Memories() {
+  const { user, isAuthenticated } = useAuthContext();
+  const localize = useLocalize();
+  const { memoryId } = useParams();
+  const location = useLocation();
+  const [params, setParams] = useSearchParams();
+  const [search, setSearch] = useState(params.get('q') ?? '');
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const queryString = params.toString();
+  const scrollKey = `life:scroll:${user?.id}:${queryString}`;
+  const list = useQuery({
+    queryKey: [QueryKeys.lifeMemories, user?.id, queryString],
+    queryFn: ({ signal }) => lifeService.memories(queryString, signal),
+    enabled: isAuthenticated && !memoryId,
+    retry: false,
+    staleTime: 0,
+  });
+  const detail = useQuery({
+    queryKey: [QueryKeys.lifeMemory, user?.id, memoryId],
+    queryFn: ({ signal }) => lifeService.memory(memoryId ?? '', signal),
+    enabled: isAuthenticated && !!memoryId,
+    retry: false,
+    staleTime: 0,
+  });
+  const query = memoryId ? detail : list;
+  useEffect(() => {
+    setSearch(params.get('q') ?? '');
+  }, [queryString, params]);
+  useEffect(() => {
+    const element = scrollRef.current;
+    if (element && !memoryId && list.isSuccess) {
+      element.scrollTop = Number(sessionStorage.getItem(scrollKey) ?? 0);
+    }
+  }, [memoryId, list.isSuccess, scrollKey]);
+  const updateFilter = (key: string, value: string) => {
+    const next = new URLSearchParams(params);
+    next.delete('page');
+    if (value) {
+      next.set(key, value);
+    } else {
+      next.delete(key);
+    }
+    setParams(next);
+  };
+  const memory = detail.data?.memory;
+  const page = list.data?.page ?? 1;
+
+  return (
+    <div
+      ref={scrollRef}
+      className="min-h-0 flex-1 overflow-y-auto overscroll-contain bg-surface-primary"
+      onScroll={(event) => {
+        if (!memoryId) {
+          sessionStorage.setItem(scrollKey, String(event.currentTarget.scrollTop));
+        }
+      }}
+    >
+      <main className="not-prose mx-auto w-full max-w-4xl px-4 py-8 text-text-primary sm:px-8 sm:py-12">
+        <p className="mb-3 text-xs font-semibold tracking-widest text-text-secondary">
+          {localize('com_life_journal')}
+        </p>
+        <h1 className="font-serif mb-3 break-words text-3xl sm:text-4xl">
+          {localize(memoryId ? 'com_life_detail' : 'com_life_memories')}
+        </h1>
+        <p className="mb-8 text-sm leading-7 text-text-secondary">{localize('com_life_intro')}</p>
+        {!memoryId ? <MomentList /> : null}
+        <Link
+          className="mb-6 inline-flex min-h-11 items-center text-link underline"
+          to="/memory-settings"
+        >
+          {localize('com_life_memory_settings')}
+        </Link>
+        {memoryId ? (
+          <Link
+            className="mb-6 inline-flex rounded-lg border border-border-medium px-4 py-2 text-sm text-text-primary no-underline hover:bg-surface-hover"
+            to={`/memories${location.search}`}
+          >
+            {localize('com_life_back')}
+          </Link>
+        ) : (
+          <form
+            className="mb-8 grid gap-3 rounded-2xl border border-border-light bg-surface-primary-alt p-4 sm:grid-cols-2"
+            onSubmit={(event) => {
+              event.preventDefault();
+              updateFilter('q', search);
+            }}
+          >
+            <label className="grid gap-2 text-sm">
+              {localize('com_life_search')}
+              <input
+                className="min-w-0 rounded-lg border border-border-medium bg-surface-primary px-3 py-2 text-text-primary"
+                type="search"
+                value={search}
+                maxLength={200}
+                onChange={(event) => setSearch(event.target.value)}
+              />
+            </label>
+            <label className="grid min-w-0 gap-2 text-sm">
+              {localize('com_life_date')}
+              <input
+                className="min-w-0 rounded-lg border border-border-medium bg-surface-primary px-3 py-2 text-text-primary"
+                type="date"
+                value={params.get('on_date') ?? ''}
+                onChange={(event) => updateFilter('on_date', event.target.value)}
+              />
+            </label>
+            <label className="flex items-center gap-3 text-sm">
+              {localize('com_life_order')}
+              <select
+                className="min-w-0 rounded-lg border border-border-medium bg-surface-primary px-3 py-2"
+                value={params.get('order') ?? 'desc'}
+                onChange={(event) => updateFilter('order', event.target.value)}
+              >
+                <option value="desc">{localize('com_life_newest')}</option>
+                <option value="asc">{localize('com_life_oldest')}</option>
+              </select>
+            </label>
+            <div className="flex flex-wrap justify-end gap-2">
+              <Button type="button" variant="ghost" onClick={() => setParams({})}>
+                {localize('com_life_clear')}
+              </Button>
+              <Button type="submit">{localize('com_life_search_button')}</Button>
+            </div>
+          </form>
+        )}
+        {query.isLoading ? (
+          <div role="status" className="flex items-center justify-center gap-3 py-16">
+            <Spinner />
+            <span>{localize('com_life_loading')}</span>
+          </div>
+        ) : null}
+        {query.isError ? (
+          <div
+            role="alert"
+            className="rounded-2xl border border-border-medium bg-surface-primary-alt p-6"
+          >
+            <p className="mb-4 leading-7">{localize('com_life_error')}</p>
+            <Button onClick={() => query.refetch()}>{localize('com_ui_retry')}</Button>
+          </div>
+        ) : null}
+        {query.isSuccess && memoryId && memory ? (
+          <article className="rounded-2xl border border-border-light bg-surface-primary-alt p-6 sm:p-9">
+            <time dateTime={memory.occurred_at} className="text-sm text-text-secondary">
+              {formatTime(memory.occurred_at)}
+            </time>
+            <h2 className="font-serif mb-6 mt-4 break-words text-2xl leading-relaxed">
+              {memory.title}
+            </h2>
+            <p className="mb-6 text-sm text-text-secondary">{localize('com_life_event_type')}</p>
+            <div className="whitespace-pre-wrap break-words text-base leading-8">
+              {readableContent(memory.content, memory.title)}
+            </div>
+            <ul aria-label={localize('com_life_tags')} className="mt-6 flex flex-wrap gap-2">
+              {memory.tags.map((tag) => (
+                <li key={tag} className="rounded-full bg-surface-active px-3 py-1 text-xs">
+                  #{tag}
+                </li>
+              ))}
+            </ul>
+            <p className="mt-8 text-sm text-text-secondary">
+              {localize('com_life_source')} ·{' '}
+              {memory.source_type === 'chat'
+                ? localize('com_life_chat')
+                : localize('com_life_manual')}
+            </p>
+            {memory.conversation_id ? (
+              <Link
+                className="mt-3 inline-flex rounded-lg border border-border-medium px-4 py-2 text-sm text-text-primary no-underline hover:bg-surface-hover"
+                to={`/c/${encodeURIComponent(memory.conversation_id)}`}
+              >
+                {localize('com_life_open_chat')}
+              </Link>
+            ) : null}
+          </article>
+        ) : null}
+        {query.isSuccess && !memoryId && list.data?.memories.length === 0 ? (
+          <div
+            role="status"
+            className="rounded-2xl border border-dashed border-border-medium px-6 py-16 text-center"
+          >
+            <h2 className="font-serif mb-3 text-2xl">{localize('com_life_empty')}</h2>
+            <p className="text-sm leading-7 text-text-secondary">
+              {localize('com_life_empty_hint')}
+            </p>
+          </div>
+        ) : null}
+        {query.isSuccess && !memoryId && (list.data?.memories.length ?? 0) > 0 ? (
+          <>
+            <p role="status" className="mb-4 text-sm text-text-secondary">
+              {localize('com_life_count', { count: list.data?.total ?? 0 })}
+            </p>
+            <ol className="grid gap-5">
+              {list.data?.memories.map((item) => (
+                <li key={item.event_id}>
+                  <Link
+                    className="block rounded-2xl border border-border-light bg-surface-primary-alt p-5 text-text-primary no-underline hover:border-border-heavy focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring-primary sm:p-7"
+                    to={`/memories/${encodeURIComponent(item.event_id)}${location.search}`}
+                  >
+                    <time
+                      className="text-xs tracking-wide text-text-secondary"
+                      dateTime={item.occurred_at}
+                    >
+                      {formatTime(item.occurred_at)}
+                    </time>
+                    <h2 className="font-serif my-3 break-words text-xl leading-relaxed">
+                      {item.title}
+                    </h2>
+                    <p className="line-clamp-3 whitespace-pre-wrap break-words text-sm leading-7 text-text-secondary">
+                      {item.summary}
+                    </p>
+                    <p className="mt-4 text-xs text-text-secondary">
+                      {localize('com_life_event_type')} · {localize('com_life_source')} ·{' '}
+                      {item.source_type === 'chat'
+                        ? localize('com_life_chat')
+                        : localize('com_life_manual')}
+                    </p>
+                    <div className="mt-3 flex flex-wrap gap-2 text-xs text-text-secondary">
+                      {item.tags.map((tag) => (
+                        <span key={tag}>#{tag}</span>
+                      ))}
+                    </div>
+                    <span className="mt-5 inline-block text-sm font-semibold">
+                      {localize('com_life_read')}
+                    </span>
+                  </Link>
+                </li>
+              ))}
+            </ol>
+            <nav
+              aria-label={localize('com_life_pagination')}
+              className="mt-8 flex items-center justify-between gap-3"
+            >
+              <Button
+                disabled={page <= 1}
+                onClick={() => {
+                  const next = new URLSearchParams(params);
+                  next.set('page', String(page - 1));
+                  setParams(next);
+                }}
+              >
+                {localize('com_life_previous')}
+              </Button>
+              <span className="text-sm">{page}</span>
+              <Button
+                disabled={!list.data?.has_more}
+                onClick={() => {
+                  const next = new URLSearchParams(params);
+                  next.set('page', String(page + 1));
+                  setParams(next);
+                }}
+              >
+                {localize('com_life_next')}
+              </Button>
+            </nav>
+          </>
+        ) : null}
+        <p className="mt-12 text-xs leading-6 text-text-secondary">
+          {localize('com_life_private')}
+        </p>
+      </main>
+    </div>
+  );
+}
