@@ -0,0 +1,206 @@
+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Button, Spinner, Switch } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { LifePermissions } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function Knowledge() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const [editing, setEditing] = useState<string | null>(null);
+  const [text, setText] = useState('');
+  const [notice, setNotice] = useState('');
+  const [timezone, setTimezone] = useState<string>();
+  const permissions = useQuery({
+    queryKey: [QueryKeys.lifePermissions, user?.id],
+    queryFn: lifeService.permissions,
+    retry: false,
+  });
+  const knowledge = useQuery({
+    queryKey: [QueryKeys.lifeKnowledge, user?.id],
+    queryFn: lifeService.knowledge,
+    retry: false,
+  });
+  const refresh = () => {
+    void cache.invalidateQueries([QueryKeys.lifePermissions, user?.id]);
+    void cache.invalidateQueries([QueryKeys.lifeKnowledge, user?.id]);
+    void cache.invalidateQueries([QueryKeys.lifeMemories, user?.id]);
+    void cache.invalidateQueries([QueryKeys.lifeMemory, user?.id]);
+    void cache.invalidateQueries([QueryKeys.lifeKnowledgeDetail, user?.id]);
+    void cache.invalidateQueries([QueryKeys.lifeChatLinks, user?.id]);
+  };
+  const settings = useMutation(lifeService.setPermissions, { onSuccess: refresh });
+  const correct = useMutation(
+    ({ id, value }: { id: string; value: string }) => lifeService.correctFact(id, value),
+    {
+      onSuccess: () => {
+        setEditing(null);
+        setNotice(localize('com_life_fact_updated'));
+        refresh();
+      },
+    },
+  );
+  const forget = useMutation(lifeService.forget, {
+    onSuccess: (result) => {
+      setNotice(
+        localize(result.cleanup === 'pending' ? 'com_life_cleanup_pending' : 'com_life_forgotten'),
+      );
+      refresh();
+    },
+  });
+  const pending = settings.isLoading || correct.isLoading || forget.isLoading;
+  const failed =
+    permissions.isError ||
+    knowledge.isError ||
+    settings.isError ||
+    correct.isError ||
+    forget.isError;
+  const facts = knowledge.data?.items ?? [];
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-6">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/memories">
+          {localize('com_life_back')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_memory_settings')}</h1>
+        <p className="leading-7 text-text-secondary">{localize('com_life_consent_notice')}</p>
+        <details className="rounded-2xl border border-border-light p-4">
+          <summary className="min-h-11 cursor-pointer">
+            {localize('com_life_memory_eligibility')}
+          </summary>
+          <p className="leading-8">{localize('com_life_memory_included')}</p>
+          <p className="leading-8">{localize('com_life_memory_excluded')}</p>
+          <p className="leading-8">{localize('com_life_memory_receipt_rule')}</p>
+        </details>
+        {permissions.isLoading || knowledge.isLoading ? <Spinner /> : null}
+        {failed ? (
+          <div role="alert">
+            <p>{localize('com_life_error')}</p>
+            <Button
+              onClick={() => {
+                void permissions.refetch();
+                void knowledge.refetch();
+              }}
+            >
+              {localize('com_ui_retry')}
+            </Button>
+          </div>
+        ) : null}
+        {permissions.data ? (
+          <section className="space-y-4 rounded-2xl border border-border-light bg-surface-primary-alt p-5">
+            <form
+              className="space-y-3"
+              onSubmit={(event) => {
+                event.preventDefault();
+                settings.mutate({ timezone: timezone ?? permissions.data?.timezone });
+              }}
+            >
+              <label className="grid gap-2">
+                {localize('com_life_draft_timezone')}
+                <input
+                  className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                  value={timezone ?? permissions.data.timezone ?? ''}
+                  required
+                  onChange={(event) => setTimezone(event.target.value)}
+                />
+              </label>
+              <Button type="submit" disabled={pending}>
+                {localize('com_ui_save')}
+              </Button>
+            </form>
+            {(
+              [
+                ['memory_consent', 'com_life_auto_memory'],
+                ['recall_consent', 'com_life_recall_memory'],
+                ['sensitive_consent', 'com_life_sensitive_memory'],
+              ] as const
+            ).map(([key, label]) => (
+              <label key={key} className="flex min-h-11 items-center justify-between gap-4">
+                <span>{localize(label)}</span>
+                <Switch
+                  aria-label={localize(label)}
+                  checked={permissions.data?.[key] ?? false}
+                  disabled={pending}
+                  onCheckedChange={(value) =>
+                    settings.mutate({ [key]: value } as Partial<LifePermissions>)
+                  }
+                />
+              </label>
+            ))}
+          </section>
+        ) : null}
+        <h2 className="text-xl font-semibold">{localize('com_life_known_facts')}</h2>
+        {notice ? <p role="status">{notice}</p> : null}
+        {knowledge.isSuccess && facts.length === 0 ? <p>{localize('com_life_no_facts')}</p> : null}
+        {facts.map((item) => (
+          <article key={item.memory_id} className="space-y-3 border-b border-border-light py-4">
+            {editing === item.memory_id ? (
+              <form
+                onSubmit={(event) => {
+                  event.preventDefault();
+                  correct.mutate({ id: item.memory_id, value: text });
+                }}
+              >
+                <label className="grid gap-2">
+                  {localize('com_life_correct_fact')}
+                  <input
+                    className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                    value={text}
+                    onChange={(event) => setText(event.target.value)}
+                    maxLength={500}
+                    required
+                  />
+                </label>
+                <div className="mt-3 flex gap-3">
+                  <Button type="submit" disabled={pending}>
+                    {localize('com_ui_save')}
+                  </Button>
+                  <Button
+                    type="button"
+                    variant="ghost"
+                    disabled={pending}
+                    onClick={() => setEditing(null)}
+                  >
+                    {localize('com_ui_cancel')}
+                  </Button>
+                </div>
+              </form>
+            ) : (
+              <>
+                <Link
+                  className="block min-h-11 break-words leading-7 text-link underline"
+                  to={`/knowledge/${item.memory_id}`}
+                >
+                  {item.canonical_text}
+                </Link>
+                <div className="flex gap-3">
+                  <Button
+                    variant="outline"
+                    disabled={pending}
+                    onClick={() => {
+                      setEditing(item.memory_id);
+                      setText(item.canonical_text);
+                      setNotice('');
+                    }}
+                  >
+                    {localize('com_life_correct_fact')}
+                  </Button>
+                  <Button
+                    variant="ghost"
+                    disabled={pending}
+                    onClick={() => forget.mutate(item.memory_id)}
+                  >
+                    {localize('com_life_forget')}
+                  </Button>
+                </div>
+              </>
+            )}
+          </article>
+        ))}
+      </div>
+    </main>
+  );
+}
