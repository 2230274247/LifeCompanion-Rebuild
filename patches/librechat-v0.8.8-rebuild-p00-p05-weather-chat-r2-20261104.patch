+import React from 'react';
+import { MemoryRouter } from 'react-router-dom';
+import { lifeService } from 'librechat-data-provider';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import Knowledge from '../Knowledge';
+
+jest.mock('~/hooks', () => ({
+  useAuthContext: () => ({ user: { id: 'owner-a' }, isAuthenticated: true }),
+  useLocalize: () => (key: string) => key,
+}));
+
+const permissions = {
+  memory_consent: true,
+  recall_consent: false,
+  sensitive_consent: false,
+  image_consent: false,
+  notification_consent: false,
+};
+
+function mount() {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false, cacheTime: 0 } } });
+  render(
+    <QueryClientProvider client={client}>
+      <MemoryRouter>
+        <Knowledge />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+
+test('changes only the selected permission using the real data-provider boundary', async () => {
+  jest.spyOn(lifeService, 'permissions').mockResolvedValue(permissions);
+  jest.spyOn(lifeService, 'knowledge').mockResolvedValue({ items: [] });
+  const update = jest
+    .spyOn(lifeService, 'setPermissions')
+    .mockResolvedValue({ ...permissions, recall_consent: true });
+  mount();
+  fireEvent.click(await screen.findByRole('switch', { name: 'com_life_recall_memory' }));
+  await waitFor(() => expect(update.mock.calls[0][0]).toEqual({ recall_consent: true }));
+  expect(screen.queryByRole('switch', { name: /image|notification/ })).not.toBeInTheDocument();
+});
+
+test('failed deletion stays visible and never reports success', async () => {
+  jest.spyOn(lifeService, 'permissions').mockResolvedValue(permissions);
+  jest.spyOn(lifeService, 'knowledge').mockResolvedValue({
+    items: [
+      {
+        memory_id: 'mem_test',
+        kind: 'stable_fact',
+        canonical_text: '喜欢喝龙井茶',
+        state: 'active',
+        evidence_count: 1,
+      },
+    ],
+  });
+  jest.spyOn(lifeService, 'forget').mockRejectedValue(new Error('upstream failed'));
+  mount();
+  fireEvent.click(await screen.findByRole('button', { name: 'com_life_forget' }));
+  expect(await screen.findByRole('alert')).toBeInTheDocument();
+  expect(screen.getByText('喜欢喝龙井茶')).toBeInTheDocument();
+  expect(screen.queryByText('com_life_forgotten')).not.toBeInTheDocument();
+});
