+          {localize('com_life_back')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_view_moment')}</h1>
+        {query.isLoading ? <Spinner /> : null}
+        {query.isError ? <p role="alert">{localize('com_life_entity_unavailable')}</p> : null}
+        {item ? (
+          <>
+            <p>
+              {localize(item.image_data ? 'com_life_ai_moment' : 'com_life_moment_text_record')}
+            </p>
+            <p role="status">
+              {localize('com_life_entity_status')}: {localize(statusKey(item.status))}
+            </p>
+            {item.status === 'unknown' ? (
+              <p role="status">{localize('com_life_moment_unknown')}</p>
+            ) : null}
+            {['blocked_scoring', 'score_failed', 'score_unknown'].includes(item.status) ? (
+              <p role="status">{localize('com_life_score_paused_notice')}</p>
+            ) : null}
+            <p>
+              {windowTime(item.window_start, item.timezone)} →{' '}
+              {windowTime(item.window_end, item.timezone)} · {item.timezone}
+            </p>
+            {item.image_data ? (
+              <img
+                className="h-auto w-full rounded-2xl"
+                src={item.image_data}
+                alt={localize('com_life_ai_moment')}
+              />
+            ) : null}
+            {!item.image_data && item.caption ? <p>{localize('com_life_moment_pending')}</p> : null}
+            <p className="break-words leading-8">{item.caption}</p>
+            {item.source_memory_ids.map((id) => (
+              <Link key={id} className="block min-h-11 text-link underline" to={`/knowledge/${id}`}>
+                {localize('com_life_view_knowledge')}
+              </Link>
+            ))}
+            {item.selection?.length ? (
+              <details>
+                <summary className="min-h-11 cursor-pointer">
+                  {localize('com_life_selection_reason')}
+                </summary>
+                <ol className="space-y-4">
+                  {item.selection.map((candidate) => (
+                    <li
+                      key={candidate.memory_id}
+                      className="space-y-2 border-t border-border-light py-3"
+                    >
+                      <Link
+                        className="inline-flex min-h-11 items-center text-link underline"
+                        to={`/knowledge/${candidate.memory_id}`}
+                      >
+                        {localize('com_life_view_knowledge')}
+                      </Link>
+                      <p>
+                        {localize(
+                          item.source_memory_ids.includes(candidate.memory_id)
+                            ? 'com_life_score_selected'
+                            : 'com_life_score_not_selected',
+                        )}
+                        {' · '}
+                        {localize('com_life_score_points', {
+                          score: Math.round(candidate.score * 100),
+                        })}
+                      </p>
+                      <p>
+                        {localize(
+                          reasonLabels[candidate.reason_code as keyof typeof reasonLabels] ??
+                            'com_life_score_recorded',
+                        )}
+                      </p>
+                      <dl className="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
+                        {Object.entries(dimensionLabels).map(([dimension, label]) =>
+                          typeof candidate.dimensions[dimension] === 'number' ? (
+                            <div key={dimension}>
+                              <dt>{localize(label)}</dt>
+                              <dd>
+                                {localize('com_life_score_points', {
+                                  score: Math.round(candidate.dimensions[dimension] * 100),
+                                })}
+                              </dd>
+                            </div>
+                          ) : null,
+                        )}
+                      </dl>
+                    </li>
+                  ))}
+                </ol>
+              </details>
+            ) : null}
+            {item.retry_allowed === true ? (
+              <>
+                <p>{localize('com_life_moment_retry_notice')}</p>
+                <Button disabled={retry.isLoading} onClick={() => retry.mutate()}>
+                  {localize('com_ui_retry')}
+                </Button>
+              </>
+            ) : null}
+            {item.status !== 'cancelled' ? (
+              <Button variant="outline" disabled={remove.isLoading} onClick={() => remove.mutate()}>
+                {localize('com_life_delete_moment')}
