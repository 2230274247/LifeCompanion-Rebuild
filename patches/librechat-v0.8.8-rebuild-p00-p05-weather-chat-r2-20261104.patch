+    </section>
+  );
+}
+
+export default function MomentDetail() {
+  const { momentId = '' } = useParams();
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const refresh = () => {
+    void cache.invalidateQueries([QueryKeys.lifeMoment, user?.id, momentId]);
+    void cache.invalidateQueries([QueryKeys.lifeMoments, user?.id]);
+    void cache.invalidateQueries([QueryKeys.lifeChatLinks, user?.id]);
+  };
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeMoment, user?.id, momentId],
+    queryFn: () => lifeService.moment(momentId),
+    retry: false,
+    refetchInterval: (data) => (data && activeStatuses.includes(data.moment.status) ? 3000 : false),
+  });
+  const retry = useMutation(() => lifeService.retryMoment(momentId), { onSuccess: refresh });
+  const remove = useMutation(() => lifeService.deleteMoment(momentId), { onSuccess: refresh });
+  const item = query.data?.moment;
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-5">
