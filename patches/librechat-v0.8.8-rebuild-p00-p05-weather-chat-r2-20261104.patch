+  privacy_suitability: 'com_life_dimension_privacy',
+  novelty_or_development: 'com_life_dimension_development',
+} as const;
+
+function statusKey(status: string) {
+  return statusLabels[status as keyof typeof statusLabels] ?? 'com_life_entity_unavailable';
+}
+
+function windowTime(value: string, timezone: string) {
+  return new Intl.DateTimeFormat(undefined, {
+    timeZone: timezone,
+    dateStyle: 'medium',
+    timeStyle: 'short',
