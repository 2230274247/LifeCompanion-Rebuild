+            ) : null}
+            <Link className="block min-h-11 text-link underline" to="/moments/settings">
+              {localize('com_life_moment_settings')}
+            </Link>
+          </>
+        ) : null}
+        {retry.isError || remove.isError ? <p role="alert">{localize('com_life_error')}</p> : null}
