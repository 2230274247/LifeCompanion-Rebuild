+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+const activeStatuses = ['awaiting_score', 'scoring', 'queued', 'generating'];
+const statusLabels = {
+  awaiting_score: 'com_life_score_waiting',
+  scoring: 'com_life_score_running',
+  blocked_scoring: 'com_life_score_blocked',
+  score_failed: 'com_life_score_failed',
+  score_unknown: 'com_life_score_unknown',
+  queued: 'com_life_moment_queued',
+  generating: 'com_life_moment_generating',
+  pending_provider: 'com_life_moment_text_only',
+  generated: 'com_life_moment_generated',
+  failed: 'com_life_moment_failed',
+  unknown: 'com_life_moment_result_unknown',
+  cancelled: 'com_life_moment_cancelled',
+} as const;
+const reasonLabels = {
+  MEANINGFUL_EVENT: 'com_life_score_meaningful',
+  ROUTINE_EVENT: 'com_life_score_routine',
+  NO_CLEAR_EVENT: 'com_life_score_unclear',
+  SOURCE_INSUFFICIENT: 'com_life_score_insufficient',
+  PRIVATE_OR_SENSITIVE: 'com_life_score_private',
+  DUPLICATE_EVENT: 'com_life_score_duplicate',
+  OUTSIDE_WINDOW: 'com_life_score_outside',
+  LOW_PERSONAL_MEANING: 'com_life_score_low_meaning',
+} as const;
+const dimensionLabels = {
+  personal_meaning: 'com_life_dimension_meaning',
+  uniqueness: 'com_life_dimension_unique',
+  expressed_feeling: 'com_life_dimension_feeling',
+  event_clarity: 'com_life_dimension_clarity',
