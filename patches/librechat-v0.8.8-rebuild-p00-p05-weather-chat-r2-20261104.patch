diff --git a/client/src/components/Life/ChatSources.tsx b/client/src/components/Life/ChatSources.tsx
new file mode 100644
index 000000000..da138eeaf
--- /dev/null
+++ b/client/src/components/Life/ChatSources.tsx
@@ -0,0 +1,104 @@
+import { useEffect } from 'react';
+import { useQuery } from '@tanstack/react-query';
+import { Link, useSearchParams } from 'react-router-dom';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function ChatSources({
+  conversationId,
+  sourceMessageId,
+  isSubmitting,
+}: {
+  conversationId: string;
+  sourceMessageId: string;
+  isSubmitting?: boolean;
+}) {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const [search] = useSearchParams();
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeChatLinks, user?.id, conversationId],
+    queryFn: ({ signal }) => lifeService.chatLinks(conversationId, signal),
+    enabled: Boolean(user?.id && conversationId !== 'new'),
+    refetchInterval: isSubmitting ? 1500 : false,
+    retry: false,
+  });
+  useEffect(() => {
+    if (search.get('message') !== sourceMessageId) {
+      return;
+    }
+    const element = document.getElementById(sourceMessageId);
+    element?.scrollIntoView({ block: 'center', behavior: 'instant' });
+  }, [search, sourceMessageId]);
+  const links = query.data?.links.filter((item) => item.message_id === sourceMessageId) ?? [];
+  if (query.isError) {
+    return (
+      <button className="min-h-11 text-link underline" onClick={() => void query.refetch()}>
+        {localize('com_life_sources_retry')}
+      </button>
+    );
+  }
+  return (
+    <div className="flex flex-wrap gap-2" aria-label={localize('com_life_sources')}>
+      {query.data?.actions
+        ?.filter((action) => action.message_id === sourceMessageId)
+        .map((action) => (
+          <div
+            key={action.message_id}
+            role="status"
+            className="w-full rounded-xl border border-border-light p-3"
+          >
+            <p>
+              {localize(
+                action.status === 'succeeded'
+                  ? 'com_life_memory_saved_receipt'
+                  : action.status === 'withdrawn'
+                    ? 'com_life_forgotten'
+                    : 'com_life_memory_not_saved',
+              )}
+            </p>
+            {action.status === 'succeeded' && action.memory_id ? (
+              <Link
+                className="inline-flex min-h-11 items-center text-link underline"
+                to={`/knowledge/${action.memory_id}`}
+              >
+                {localize('com_life_view_knowledge')}
+              </Link>
+            ) : null}
+            {action.status === 'permission_required' ? (
+              <Link
+                className="inline-flex min-h-11 items-center text-link underline"
+                to="/memory-settings"
+              >
+                {localize('com_life_memory_settings')}
+              </Link>
+            ) : null}
+          </div>
+        ))}
+      {links.map((item) => (
+        <Link
+          className="inline-flex min-h-11 items-center rounded-xl border border-border-light px-3 text-link underline"
+          key={item.memory_id}
+          to={item.url}
+        >
+          {localize('com_life_view_knowledge')} · {item.canonical_text.slice(0, 45)}
+        </Link>
+      ))}
+      {links
+        .flatMap((item) => item.moments ?? [])
+        .filter(
+          (item, index, all) =>
+            all.findIndex((other) => other.moment_id === item.moment_id) === index,
+        )
+        .map((item) => (
+          <Link
+            key={item.moment_id}
+            className="inline-flex min-h-11 items-center text-link underline"
+            to={`/moments/${item.moment_id}`}
+          >
+            {localize('com_life_view_moment')} · {item.status}
+          </Link>
+        ))}
+    </div>
+  );
+}
