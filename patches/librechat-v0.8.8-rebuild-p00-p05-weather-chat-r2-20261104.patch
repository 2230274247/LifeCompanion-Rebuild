+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Button, Spinner, Switch } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { LifeMomentSettings } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function MomentSettings() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const [edited, setEdited] = useState<LifeMomentSettings>();
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeMomentSettings, user?.id],
+    queryFn: lifeService.momentSettings,
+    retry: false,
+  });
+  const permissions = useQuery({
+    queryKey: [QueryKeys.lifePermissions, user?.id],
+    queryFn: lifeService.permissions,
+    retry: false,
+  });
+  const settings = edited ?? query.data;
+  const refresh = () => void cache.invalidateQueries([QueryKeys.lifePermissions, user?.id]);
+  const consent = useMutation(lifeService.setPermissions, { onSuccess: refresh });
+  const save = useMutation(lifeService.saveMomentSettings, {
+    onSuccess: (value) => {
+      setEdited(undefined);
+      cache.setQueryData([QueryKeys.lifeMomentSettings, user?.id], value);
+    },
+  });
+  const pending = consent.isLoading || save.isLoading;
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-5">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/memories">
+          {localize('com_life_back')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_moment_settings')}</h1>
+        <p className="leading-8">{localize('com_life_moment_consent_notice')}</p>
+        {query.isLoading || permissions.isLoading ? <Spinner /> : null}
+        {query.isError || permissions.isError ? (
+          <p role="alert">{localize('com_life_error')}</p>
+        ) : null}
+        {permissions.data
+          ? (
+              [
+                ['memory_consent', 'com_life_auto_memory'],
+                ['image_consent', 'com_life_image_consent'],
+              ] as const
+            ).map(([key, label]) => (
+              <label key={key} className="flex min-h-11 items-center justify-between gap-3">
+                <span>{localize(label)}</span>
+                <Switch
+                  aria-label={localize(label)}
+                  checked={permissions.data[key]}
+                  disabled={pending}
+                  onCheckedChange={(value) => consent.mutate({ [key]: value })}
+                />
+              </label>
+            ))
+          : null}
+        {settings ? (
+          <form
+            className="space-y-5 rounded-2xl border border-border-light bg-surface-primary-alt p-5"
+            onSubmit={(event) => {
+              event.preventDefault();
+              save.mutate(settings);
+            }}
+          >
+            <label className="flex min-h-11 items-center justify-between gap-3">
+              {localize('com_life_automatic_moments')}
+              <Switch
+                aria-label={localize('com_life_automatic_moments')}
+                checked={settings.enabled}
+                disabled={pending}
+                onCheckedChange={(value) => setEdited({ ...settings, enabled: value })}
+              />
+            </label>
+            <p className="leading-7">{localize('com_life_moment_windows_notice')}</p>
+            <label className="grid gap-2">
+              {localize('com_life_draft_timezone')}
+              <input
+                className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                value={settings.timezone}
+                required
+                onChange={(event) => setEdited({ ...settings, timezone: event.target.value })}
+              />
+            </label>
+            <div className="grid gap-3 sm:grid-cols-3">
+              {settings.ends.map((end, index) => (
+                <label className="grid gap-2" key={index}>
+                  {localize(
+                    index === 0
+                      ? 'com_life_morning'
+                      : index === 1
+                        ? 'com_life_noon'
+                        : 'com_life_evening',
+                  )}
+                  <input
+                    type="time"
+                    className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                    value={end}
+                    required
+                    onChange={(event) =>
+                      setEdited({
+                        ...settings,
+                        ends: settings.ends.map((value, i) =>
+                          i === index ? event.target.value : value,
+                        ),
+                      })
+                    }
+                  />
+                </label>
+              ))}
+            </div>
+            <Button type="submit" disabled={pending}>
+              {localize('com_ui_save')}
+            </Button>
+            {save.isSuccess && !edited ? (
+              <p role="status">{localize('com_life_moment_settings_saved')}</p>
+            ) : null}
+          </form>
+        ) : null}
+        {save.isError || consent.isError ? (
+          <p role="alert">{localize('com_life_moment_settings_error')}</p>
+        ) : null}
+      </div>
+    </main>
+  );
+}
