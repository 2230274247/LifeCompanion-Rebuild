+import { Button } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQueryClient } from '@tanstack/react-query';
+import type { ReminderAvailability } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function Provisioning({ availability }: { availability: ReminderAvailability }) {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const action = useMutation(
+    async () => {
+      if (availability.status === 'consent_required') {
+        await lifeService.setPermissions({ notification_consent: true });
+      }
+      return lifeService.provisionReminders();
+    },
+    {
+      onSuccess: () => {
+        void cache.invalidateQueries([QueryKeys.lifePermissions, user?.id]);
+        void cache.invalidateQueries([QueryKeys.lifeReminders, user?.id]);
+        void cache.invalidateQueries([QueryKeys.lifeReminderDrafts, user?.id]);
+      },
+    },
+  );
+  if (availability.status === 'ready' || (availability.configured && !availability.status)) {
+    return null;
+  }
+  let message = localize('com_life_draft_provision_intro');
+  if (availability.status === 'consent_required') {
+    message = localize('com_life_draft_consent');
+  } else if (availability.status === 'permission_denied') {
+    message = localize('com_life_draft_permission_denied');
+  } else if (availability.status === 'service_unavailable') {
+    message = localize('com_life_draft_service_unavailable');
+  }
+  return (
+    <div className="space-y-3 rounded-xl border border-border-medium bg-surface-primary-alt p-4">
+      <p role="status">{message}</p>
+      {availability.error_code ? (
+        <p className="break-words text-sm">{availability.error_code}</p>
+      ) : null}
+      <Button
+        className="min-h-11"
+        disabled={action.isLoading || availability.status === 'provisioning'}
+        onClick={() => action.mutate()}
+      >
+        {localize(
+          availability.status === 'consent_required'
+            ? 'com_life_draft_authorize'
+            : 'com_life_draft_provision',
+        )}
+      </Button>
+      {action.isError ? <p role="alert">{localize('com_life_draft_service_unavailable')}</p> : null}
+    </div>
+  );
+}
