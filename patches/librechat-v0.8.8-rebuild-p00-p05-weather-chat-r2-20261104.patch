+import { Link, useParams } from 'react-router-dom';
+import { Button, Spinner } from '@librechat/client';
+import { lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function ReminderDetail() {
+  const { reminderId = '' } = useParams();
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const query = useQuery({
+    queryKey: ['life-reminder-detail', user?.id, reminderId],
+    queryFn: ({ signal }) => lifeService.reminder(reminderId, signal),
+    retry: false,
+  });
+  const cancel = useMutation(() => lifeService.cancelReminder(reminderId), {
+    onSuccess: () => void cache.invalidateQueries(),
+  });
+  const item = query.data?.reminder;
+  const format = (value: string) =>
+    new Intl.DateTimeFormat('zh-CN', {
+      dateStyle: 'full',
+      timeStyle: 'short',
+      timeZone: item?.timezone,
+    }).format(new Date(value));
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <article className="mx-auto max-w-3xl space-y-5 rounded-2xl border border-border-light bg-surface-primary-alt p-5">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/reminders">
+          {localize('com_life_reminders')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_view_reminder')}</h1>
+        {query.isLoading ? <Spinner /> : null}
+        {query.isError ? <p role="alert">{localize('com_life_entity_unavailable')}</p> : null}
+        {item ? (
+          <>
+            <h2 className="break-words text-xl">{item.title}</h2>
+            <p>
+              {localize('com_life_draft_remind_at')}：{format(item.scheduled_at)} · {item.timezone}
+            </p>
+            {item.source?.fields.event_date && item.source.fields.event_time ? (
+              <p>
+                {localize('com_life_draft_event_at')}：{item.source.fields.event_date}{' '}
+                {item.source.fields.event_time}
+              </p>
+            ) : null}
+            <p role="status">
+              {localize('com_life_entity_status')}：{item.status}
+            </p>
+            <p className="text-sm text-text-secondary">{localize('com_life_draft_delivery')}</p>
+            {item.source ? (
+              <Link
+                className="inline-flex min-h-11 items-center text-link underline"
+                to={`/c/${encodeURIComponent(item.source.conversation_id)}?message=${encodeURIComponent(item.source.source_message_id)}`}
+              >
+                {localize('com_life_open_chat')}
+              </Link>
+            ) : (
+              <p>{localize('com_life_source_unavailable')}</p>
+            )}
+            {item.status === 'scheduled' || item.status === 'due' ? (
+              <Button
+                className="min-h-11"
+                variant="outline"
+                disabled={cancel.isLoading}
+                onClick={() => cancel.mutate()}
+              >
+                {localize('com_life_reminder_cancel')}
+              </Button>
+            ) : null}
+          </>
+        ) : null}
+        {cancel.isError ? <p role="alert">{localize('com_life_reminder_error')}</p> : null}
+      </article>
+    </main>
+  );
+}
diff --git a/client/src/components/Life/Reminders.tsx b/client/src/components/Life/Reminders.tsx
