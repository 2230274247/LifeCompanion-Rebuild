diff --git a/client/src/components/Life/ToolCards.tsx b/client/src/components/Life/ToolCards.tsx
new file mode 100644
index 000000000..14099c75e
--- /dev/null
+++ b/client/src/components/Life/ToolCards.tsx
@@ -0,0 +1,188 @@
+import { useState } from 'react';
+import { Button } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { LifeToolChat } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+import useLifeMode from './useLifeMode';
+
+function WeatherCard({ item, refresh }: { item: LifeToolChat; refresh: () => void }) {
+  const localize = useLocalize();
+  const [place, setPlace] = useState('');
+  const select = useMutation(
+    (choice: { place_index?: number; place_query?: string }) =>
+      lifeService.selectToolPlace(item.interaction_id, item.revision, choice),
+    { onSuccess: refresh, onError: refresh },
+  );
+  const cancel = useMutation(() => lifeService.cancelToolChat(item.interaction_id), {
+    onSuccess: refresh,
+  });
+  const pending = select.isLoading || cancel.isLoading;
+  const result = item.execution?.result;
+  const weather = item.status === 'succeeded' && item.execution?.name === 'weather';
+  const failed = ['blocked', 'failed', 'unknown', 'no_places'].includes(item.status);
+  return (
+    <section
+      data-testid="weather-tool-card"
+      aria-label={localize('com_life_tool_weather')}
+      className="my-4 max-w-xl space-y-3 rounded-2xl border border-border-medium bg-surface-primary-alt p-4"
+      aria-busy={pending}
+    >
+      <h3 className="font-serif text-xl">{localize('com_life_tool_weather')}</h3>
+      {item.forecast_date ? (
+        <p>
+          {item.forecast_date} · {item.timezone}
+        </p>
+      ) : null}
+      {item.status === 'needs_place' ? (
+        <form
+          className="space-y-3"
+          onSubmit={(event) => {
+            event.preventDefault();
+            if (!pending && place.trim()) {
+              select.mutate({ place_query: place.trim() });
+            }
+          }}
+        >
+          <label className="grid gap-2">
+            {localize('com_life_tool_place_question')}
+            <input
+              required
+              maxLength={80}
+              value={place}
+              disabled={pending}
+              className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3 text-text-primary"
+              onChange={(event) => setPlace(event.target.value)}
+              onKeyDown={(event) => {
+                if (event.nativeEvent.isComposing && event.key === 'Enter') {
+                  event.preventDefault();
+                }
+              }}
+            />
+          </label>
+          <Button className="min-h-11" type="submit" disabled={pending || !place.trim()}>
+            {localize('com_life_tool_find_place')}
+          </Button>
+        </form>
+      ) : null}
+      {item.status === 'choose_place' ? (
+        <div className="space-y-2">
+          <p>{localize('com_life_tool_choose_place')}</p>
+          {item.places?.map((candidate, index) => (
+            <Button
+              key={index}
+              variant="outline"
+              className="h-auto min-h-11 w-full whitespace-normal text-left"
+              disabled={pending}
+              onClick={() => select.mutate({ place_index: index })}
+            >
+              {[candidate.name, candidate.admin1, candidate.country].filter(Boolean).join(' · ')}
+            </Button>
+          ))}
+        </div>
+      ) : null}
+      {weather && result ? (
+        <div role="status" className="space-y-2">
+          <p>{result.place_label}</p>
+          {result.current ? (
+            <p>
+              {localize('com_life_tool_temperature')}: {result.current.temperature_2m}{' '}
+              {result.units?.temperature_2m}
+              {' · '}
+              {localize('com_life_tool_precipitation')}: {result.current.precipitation}{' '}
+              {result.units?.precipitation}
+            </p>
+          ) : null}
+          {result.daily ? (
+            <p>
+              {result.daily.time[0]} · {result.daily.temperature_2m_min[0]}–
+              {result.daily.temperature_2m_max[0]} {result.units?.temperature_2m_max}
+              {' · '}
+              {localize('com_life_tool_precipitation')}: {result.daily.precipitation_sum[0]}{' '}
+              {result.units?.precipitation_sum}
+            </p>
+          ) : null}
+          <p className="text-sm text-text-secondary">{localize('com_life_tool_modeled')}</p>
+        </div>
+      ) : null}
+      {item.status === 'running' ? <p role="status">{localize('com_life_tool_running')}</p> : null}
+      {failed ? (
+        <p role="status">
+          {localize(
+            item.execution?.error_code === 'TOOL_REQUEST_BUDGET'
+              ? 'com_life_tool_budget'
+              : 'com_life_tool_unavailable',
+          )}
+        </p>
+      ) : null}
+      {result?.sources?.map((source) => (
+        <p className="break-words text-sm" key={source.url}>
+          <a className="text-link underline" href={source.url} target="_blank" rel="noreferrer">
+            {source.title}
+          </a>
+          {' · '}
+          {localize('com_life_tool_fetched')}: {new Date(source.fetched_at).toLocaleString()}
+        </p>
+      ))}
+      <Button
+        variant="ghost"
+        className="min-h-11"
+        disabled={pending}
+        onClick={() => cancel.mutate()}
+      >
+        {localize('com_life_tool_dismiss')}
+      </Button>
+      {select.isError || cancel.isError ? (
+        <p role="alert">{localize('com_life_tool_action_error')}</p>
+      ) : null}
+    </section>
+  );
+}
+
+export default function ToolCards({
+  conversationId,
+  sourceMessageId,
+  isSubmitting,
+}: {
+  conversationId: string;
+  sourceMessageId: string;
+  isSubmitting?: boolean;
+}) {
+  const { user } = useAuthContext();
+  const mode = useLifeMode();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const key = [QueryKeys.lifeToolChats, user?.id, conversationId];
+  const query = useQuery({
+    queryKey: key,
+    queryFn: ({ signal }) => lifeService.toolChats(conversationId, signal),
+    enabled: Boolean(mode && user?.id && conversationId !== 'new'),
+    retry: false,
+    refetchInterval: (data) =>
+      isSubmitting || data?.interactions.some((item) => item.status === 'running') ? 1500 : false,
+  });
+  if (!mode) {
+    return null;
+  }
+  return (
+    <>
+      {query.isError ? (
+        <p role="alert">
+          {localize('com_life_tool_load_error')}
+          <Button className="min-h-11" onClick={() => void query.refetch()}>
+            {localize('com_ui_retry')}
+          </Button>
+        </p>
+      ) : null}
+      {query.data?.interactions
+        .filter((item) => item.source_message_id === sourceMessageId)
+        .map((item) => (
+          <WeatherCard
+            key={item.interaction_id}
+            item={item}
+            refresh={() => void cache.invalidateQueries(key)}
+          />
+        ))}
+    </>
+  );
+}
