@@ -0,0 +1,362 @@
+import { useMemo, useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Button, Spinner, Switch } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { CalendarClock, Check, Pencil, Plus, X } from 'lucide-react';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { LifeReminder } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+import Provisioning from './Provisioning';
+
+function toLocalInput(value?: string) {
+  const date = value ? new Date(value) : new Date(Date.now() + 60 * 60 * 1000);
+  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000);
+  return local.toISOString().slice(0, 16);
+}
+
+function toIso(value: string) {
+  return new Date(value).toISOString();
+}
+
+function formatDate(value: string, locale: string) {
+  return new Intl.DateTimeFormat(locale, {
+    dateStyle: 'medium',
+    timeStyle: 'short',
+  }).format(new Date(value));
+}
+
+function statusLabel(status: LifeReminder['status']) {
+  if (status === 'completed') {
+    return 'com_life_reminder_completed' as const;
+  }
+  if (status === 'due') {
+    return 'com_life_reminder_due' as const;
+  }
+  if (status === 'cancelled') {
+    return 'com_life_reminder_cancelled_status' as const;
+  }
+  return 'com_life_reminder_scheduled' as const;
+}
+
+export default function Reminders() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const locale = useMemo(() => navigator.language || 'zh-CN', []);
+  const [title, setTitle] = useState('');
+  const [scheduledAt, setScheduledAt] = useState(() => toLocalInput());
+  const [editing, setEditing] = useState<string | null>(null);
+  const [editTitle, setEditTitle] = useState('');
+  const [editTime, setEditTime] = useState('');
+  const [notice, setNotice] = useState('');
+
+  const permissions = useQuery({
+    queryKey: [QueryKeys.lifePermissions, user?.id],
+    queryFn: lifeService.permissions,
+    retry: false,
+  });
+  const consent = useMutation(lifeService.setPermissions, {
+    onSuccess: () => void cache.invalidateQueries([QueryKeys.lifePermissions, user?.id]),
+  });
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeReminders, user?.id],
+    queryFn: ({ signal }) => lifeService.reminders(signal),
+    refetchInterval: 30_000,
+    retry: false,
+  });
+  const notifications = useQuery({
+    queryKey: [QueryKeys.lifeReminderNotifications, user?.id],
+    queryFn: ({ signal }) => lifeService.reminderNotifications(signal),
+    enabled: Boolean(query.data?.configured && permissions.data?.notification_consent),
+    refetchInterval: 15_000,
+    retry: false,
+  });
+  const refresh = () => {
+    void cache.invalidateQueries([QueryKeys.lifeReminders, user?.id]);
+  };
+  const create = useMutation(lifeService.createReminder, {
+    onSuccess: () => {
+      setTitle('');
+      setScheduledAt(toLocalInput());
+      setNotice(localize('com_life_reminder_created'));
+      refresh();
+    },
+  });
+  const update = useMutation(
+    ({ id, value, at }: { id: string; value: string; at: string }) =>
+      lifeService.updateReminder(id, {
+        title: value,
+        scheduled_at: toIso(at),
+        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC',
+      }),
+    {
+      onSuccess: () => {
+        setEditing(null);
+        setNotice(localize('com_life_reminder_updated'));
+        refresh();
+      },
+    },
+  );
+  const cancel = useMutation(lifeService.cancelReminder, {
+    onSuccess: () => {
+      setNotice(localize('com_life_reminder_cancelled'));
+      refresh();
+    },
+  });
+  const complete = useMutation((id: string) => lifeService.updateReminder(id, { done: true }), {
+    onSuccess: () => {
+      setNotice(localize('com_life_reminder_completed'));
+      refresh();
+    },
+  });
+  const pending =
+    create.isLoading ||
+    update.isLoading ||
+    cancel.isLoading ||
+    consent.isLoading ||
+    complete.isLoading;
+  const failed =
+    query.isError ||
+    create.isError ||
+    update.isError ||
+    cancel.isError ||
+    consent.isError ||
+    permissions.isError ||
+    notifications.isError ||
+    complete.isError;
+
+  const beginEdit = (item: LifeReminder) => {
+    setEditing(item.reminder_id);
+    setEditTitle(item.title);
+    setEditTime(toLocalInput(item.scheduled_at));
+    setNotice('');
+  };
+
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-6">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/c/new">
+          {localize('com_life_chat')}
+        </Link>
+        <header className="flex items-start gap-4">
+          <span className="grid size-12 shrink-0 place-items-center rounded-2xl bg-surface-primary-alt text-accent-primary">
+            <CalendarClock aria-hidden="true" className="size-6" />
+          </span>
+          <div>
+            <h1 className="font-serif text-3xl">{localize('com_life_reminders')}</h1>
+            <p className="mt-2 leading-7 text-text-secondary">
+              {localize('com_life_reminder_intro')}
+            </p>
+          </div>
+        </header>
+        {permissions.data ? (
+          <label className="flex min-h-11 items-center justify-between gap-4">
+            <span>{localize('com_life_notification_consent')}</span>
+            <Switch
+              aria-label={localize('com_life_notification_consent')}
+              checked={permissions.data.notification_consent}
+              disabled={pending}
+              onCheckedChange={(value) => consent.mutate({ notification_consent: value })}
+            />
+          </label>
+        ) : null}
+        {query.isSuccess ? <Provisioning availability={query.data} /> : null}
+
+        <details>
+          <summary className="cursor-pointer py-3 text-link">
+            {localize('com_life_reminder_manual')}
+          </summary>
+          <form
