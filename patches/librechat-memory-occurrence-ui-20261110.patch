index 000000000..fb7b226d2
--- /dev/null
+++ b/client/src/components/Life/occurrence.ts
@@ -0,0 +1,39 @@
+import type { LifeOccurrence } from 'librechat-data-provider';
+
+function isCalendarDate(value: string | null | undefined): value is string {
+  if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
+    return false;
+  }
+  const date = new Date(`${value}T00:00:00Z`);
+  return Number.isFinite(date.getTime()) && date.toISOString().slice(0, 10) === value;
+}
+
+export function occurrenceDay(value: LifeOccurrence | undefined): string | undefined {
+  const start = value?.occurrence_start;
+  return value?.occurrence_precision === 'day' &&
+    isCalendarDate(start) &&
+    start === value.occurrence_end
+    ? start
+    : undefined;
+}
+
+/** Dates remain calendar strings: no clock time or missing day is invented. */
+export function occurrenceLabel(value: LifeOccurrence | undefined, unknown: string): string {
+  const start = value?.occurrence_start;
+  const end = value?.occurrence_end;
+  if (!isCalendarDate(start) || !isCalendarDate(end) || start > end) {
+    return unknown;
+  }
+  switch (value?.occurrence_precision) {
+    case 'day':
+      return occurrenceDay(value) ?? unknown;
+    case 'month':
+      return start.slice(0, 7) === end.slice(0, 7) ? start.slice(0, 7) : unknown;
+    case 'year':
+      return start.slice(0, 4) === end.slice(0, 4) ? start.slice(0, 4) : unknown;
+    case 'week':
+      return `${start} – ${end}`;
+    default:
+      return unknown;
+  }
+}
