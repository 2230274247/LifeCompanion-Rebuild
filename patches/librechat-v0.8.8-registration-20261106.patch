diff --git a/api/strategies/localStrategy.spec.js b/api/strategies/localStrategy.spec.js
new file mode 100644
index 000000000..66f987315
--- /dev/null
+++ b/api/strategies/localStrategy.spec.js
@@ -0,0 +1,80 @@
+jest.mock('passport-local', () => ({
+  Strategy: class MockStrategy {
+    constructor(options, verify) {
+      this.options = options;
+      this.verify = verify;
+    }
+  },
+}));
+jest.mock(
+  '@librechat/data-schemas',
+  () => ({ logger: { info: jest.fn(), error: jest.fn(), warn: jest.fn() } }),
+  { virtual: true },
+);
+jest.mock(
+  'librechat-data-provider',
+  () => ({ errorsToString: jest.fn((errors) => errors.map((e) => e.message).join(' ')) }),
+  { virtual: true },
+);
+jest.mock(
+  '@librechat/api',
+  () => ({
+    isEnabled: jest.fn((value) => value === 'true' || value === true),
+    checkEmailConfig: jest.fn(() => false),
+    comparePassword: jest.fn(async (_user, _password) => true),
+  }),
+  { virtual: true },
+);
+jest.mock('~/models', () => ({ findUser: jest.fn(), updateUser: jest.fn() }), { virtual: true });
+jest.mock('./validators', () => ({ loginSchema: { safeParse: jest.fn(() => ({ success: true })) } }), {
+  virtual: true,
+});
+
+const { Strategy } = require('passport-local');
+const { findUser } = require('~/models');
+const localStrategyFactory = require('./localStrategy');
+
+describe('localStrategy', () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  it('supports username login by matching the lowercased username field', async () => {
+    const strategy = localStrategyFactory();
+    expect(strategy).toBeInstanceOf(Strategy);
+    expect(strategy.options.usernameField).toBe('email');
+
+    const user = {
+      _id: 'u1',
+      email: 'bob@example.com',
+      username: 'bob',
+      password: 'hashed',
+      emailVerified: true,
+      createdAt: new Date(),
+    };
+    findUser.mockResolvedValue(user);
+    const done = jest.fn();
+
+    await strategy.verify({ body: { email: 'Bob' }, ip: '1.2.3.4' }, 'Bob', 'Password123!', done);
+
+    expect(findUser).toHaveBeenCalledWith(
+      { $or: [{ email: 'Bob' }, { username: 'bob' }] },
+      '+password',
+    );
+    expect(done).toHaveBeenCalledWith(null, user);
+  });
+
+  it('returns a clear error when no account matches', async () => {
+    const strategy = localStrategyFactory();
+    findUser.mockResolvedValue(null);
+    const done = jest.fn();
+
+    await strategy.verify({ body: { email: 'nobody' }, ip: '1.2.3.4' }, 'nobody', 'Password123!', done);
+
+    expect(done).toHaveBeenCalledWith(
+      null,
+      false,
+      expect.objectContaining({ message: 'Username or email does not exist.' }),
+    );
+  });
+});
