diff --git a/client/src/components/Life/OtisPet/otis-pet.css b/client/src/components/Life/OtisPet/otis-pet.css
new file mode 100644
index 0000000000000000000000000000000000000000..711c4cd533bccfb5afec76edad383d56de9143fa
--- /dev/null
+++ b/client/src/components/Life/OtisPet/otis-pet.css
@@ -0,0 +1,213 @@
+/* Otis in the app shell: a fixed character, not a themed surface. Layout and
+   motion live here; colors come from the shared theme classes in OtisPet.tsx. */
+
+.otis-pet {
+  position: fixed;
+  right: 16px;
+  bottom: 136px;
+  z-index: 40;
+  width: 200px;
+  height: 256px;
+  pointer-events: none;
+  user-select: none;
+}
+
+.otis-pet.is-collapsed {
+  width: 54px;
+  height: 54px;
+}
+
+@media (max-width: 899px) {
+  .otis-pet {
+    display: none;
+  }
+}
+
+.otis-pet-face {
+  position: absolute;
+  top: 0;
+  left: 0;
+  width: 200px;
+  height: 200px;
+}
+
+.otis-pet-stage {
+  position: absolute;
+  inset: 0;
+  z-index: 40;
+  pointer-events: none;
+}
+
+/* The hit layer is a square; useFacePassthrough() switches it on only over
+   opaque pixels so the rest of the page stays clickable. */
+.otis-pet [role='img'] {
+  pointer-events: none;
+}
+
+/* Sits above the face, clear of the hair, so it keeps its contrast in both themes. */
+.otis-pet-hint {
+  position: absolute;
+  top: -12px;
+  right: 4px;
+  margin: 0;
+  font-family: Georgia, 'Times New Roman', serif;
+  font-size: 11px;
+  font-style: italic;
+  line-height: 1.1;
+  white-space: nowrap;
+  opacity: 0.85;
+  transform: rotate(6deg);
+  transition:
+    opacity 0.4s,
+    transform 0.4s;
+  pointer-events: none;
+}
+
+.otis-pet-hint.is-off {
+  opacity: 0;
+  transform: translateY(8px) rotate(6deg);
+}
+
+.otis-pet-arrow {
+  display: inline-block;
+  width: 20px;
+  height: 14px;
+  margin-left: 2px;
+  vertical-align: -2px;
+  transform: scaleX(-1);
+}
+
+.otis-pet-meter {
+  position: absolute;
+  left: 50%;
+  bottom: 0;
+  width: 184px;
+  padding: 7px 24px 8px 10px;
+  border-radius: 13px;
+  transform: translateX(-50%);
+  backdrop-filter: blur(10px);
+  pointer-events: auto;
+}
+
+.otis-pet-mood {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 1px;
+  margin-bottom: 5px;
+  font-size: 8px;
+  font-weight: 500;
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+}
+
+.otis-pet-mood strong {
+  max-width: 100%;
+  overflow: hidden;
+  font-size: 11px;
+  letter-spacing: -0.01em;
+  text-overflow: ellipsis;
+  text-transform: none;
+  white-space: nowrap;
+}
+
+.otis-pet-bar {
+  height: 4px;
+  overflow: hidden;
+  border-radius: 999px;
+}
+
+.otis-pet-bar i {
+  display: block;
+  height: 100%;
+  border-radius: 999px;
+  transition: width 0.15s;
+}
+
+.otis-pet-hide {
+  position: absolute;
+  top: 4px;
+  right: 4px;
+  display: grid;
+  width: 20px;
+  height: 20px;
+  place-items: center;
+  border-radius: 999px;
+  font-size: 14px;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.otis-pet-bubble {
+  display: block;
+  width: 54px;
+  height: 54px;
+  padding: 0;
+  overflow: hidden;
+  border-radius: 999px;
+  cursor: pointer;
+  pointer-events: auto;
+}
+
+.otis-pet-bubble img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+  transform: scale(1.55) translateY(4%);
+}
+
+/* Grab cursor: a ring over the face that tightens while held. */
+.grab-ring {
+  position: fixed;
+  left: 0;
+  top: 0;
+  z-index: 45;
+  pointer-events: none;
+}
+
+.grab-ring::before,
+.grab-ring::after {
+  position: absolute;
+  border-radius: 999px;
+  content: '';
+  opacity: 0;
+  transition:
+    transform 0.18s cubic-bezier(0.3, 1.6, 0.5, 1),
+    opacity 0.18s;
+}
+
+.grab-ring::before {
+  width: 34px;
+  height: 34px;
+  margin: -17px 0 0 -17px;
+  border: 1.5px solid #fff;
+  mix-blend-mode: difference;
+  transform: scale(0.6);
+}
+
+.grab-ring::after {
+  width: 6px;
+  height: 6px;
+  margin: -3px 0 0 -3px;
+  background: #fff;
+  mix-blend-mode: difference;
+}
+
+.grab-ring[data-on='1']::before,
+.grab-ring[data-on='1']::after {
+  opacity: 1;
+  transform: scale(1);
+}
+
+.grab-ring[data-held='1']::before {
+  transform: scale(0.62);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .grab-ring::before,
+  .grab-ring::after,
+  .otis-pet-hint,
+  .otis-pet-bar i {
+    transition: none;
+  }
+}
diff --git a/client/src/components/Life/ParlorMemoryPanel.css b/client/src/components/Life/ParlorMemoryPanel.css
new file mode 100644
index 0000000000000000000000000000000000000000..af0eed6c54edea390cb6c00a91e732b3133ace5d
--- /dev/null
+++ b/client/src/components/Life/ParlorMemoryPanel.css
@@ -0,0 +1,613 @@
+.lc-parlor {
+  --parlor-ink: #141414;
+  --parlor-cream: #fff4e0;
+  --parlor-yellow: #ffd23f;
+  --parlor-blue: #5ec8ff;
+  --parlor-pink: #ff7eb6;
+  --parlor-line: 2.5px solid var(--parlor-ink);
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  height: min(680px, calc(100dvh - 9rem));
+  overflow: hidden;
+  border: var(--parlor-line);
+  border-radius: 24px;
+  background:
+    radial-gradient(circle at 1px 1px, rgb(20 20 20 / 0.14) 1px, transparent 0) 0 0 / 22px
+      22px,
+    var(--parlor-cream);
+  color: var(--parlor-ink);
+  box-shadow: 9px 9px 0 var(--parlor-ink);
+  isolation: isolate;
+  font-family: ui-rounded, 'Arial Rounded MT Bold', 'Microsoft YaHei', sans-serif;
+}
+
+/* Floating desktop companion: a normal-sized box that never squeezes the
+   memory text and images in the reading column. */
+.lc-parlor-float {
+  width: min(400px, calc(100vw - 2rem));
+  height: min(560px, calc(100dvh - 5rem));
+}
+
+.lc-parlor-float .lc-parlor {
+  width: 100%;
+  height: 100%;
+  max-height: none;
+}
+
+.lc-parlor-float-toggle {
+  position: fixed;
+  right: 1.25rem;
+  bottom: 1.25rem;
+  z-index: 80;
+  animation: lc-parlor-float-in 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+
+@media (min-width: 1024px) {
+  .lc-parlor-float {
+    position: fixed;
+    right: 1.25rem;
+    bottom: 1.25rem;
+    z-index: 80;
+    animation: lc-parlor-float-in 360ms cubic-bezier(0.22, 1, 0.36, 1) both;
+  }
+}
+
+@media (max-width: 1023px) {
+  .lc-parlor-float {
+    position: static;
+    width: 100%;
+    height: min(78dvh, 680px);
+  }
+
+  .lc-parlor-float-toggle {
+    position: static;
+    width: 100%;
+    margin-top: 1rem;
+  }
+}
+
+.lc-parlor,
+.lc-parlor * {
+  box-sizing: border-box;
+}
+
+.lc-parlor button,
+.lc-parlor input {
+  font: inherit;
+}
+
+.lc-parlor button {
+  color: inherit;
+}
+
+.lc-parlor :focus-visible {
+  outline: 3px solid var(--parlor-ink);
+  outline-offset: 3px;
+}
+
+.lc-parlor__header {
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  padding: 11px 12px;
+  border-bottom: var(--parlor-line);
+  background: var(--parlor-yellow);
+}
+
+.lc-parlor__face {
+  width: 46px;
+  height: 46px;
+  flex: none;
+  filter: drop-shadow(2px 2px 0 rgb(20 20 20 / 0.18));
+}
+
+.lc-parlor__face-body {
+  fill: var(--parlor-yellow);
+  stroke: var(--parlor-ink);
+  stroke-width: 3.5;
+}
+
+.lc-parlor__face-white {
+  fill: white;
+  stroke: var(--parlor-ink);
+  stroke-width: 3;
+}
+
+.lc-parlor__face-pupil {
+  fill: var(--parlor-ink);
+  transition: transform 80ms linear;
+}
+
+.lc-parlor__face-mouth {
+  fill: none;
+  stroke: var(--parlor-ink);
+  stroke-width: 3.5;
+  stroke-linecap: round;
+  transform-box: fill-box;
+  transform-origin: center;
+}
+
+.lc-parlor.is-talking .lc-parlor__face-mouth {
+  fill: #7a1530;
+  animation: lc-parlor-talk 220ms ease-in-out infinite alternate;
+}
+
+.lc-parlor.is-talking .lc-parlor__face-body {
+  animation: lc-parlor-bounce 440ms ease-in-out infinite alternate;
+  transform-box: fill-box;
+  transform-origin: center;
+}
+
+.lc-parlor__title {
+  min-width: 0;
+  flex: 1;
+}
+
+.lc-parlor__title strong {
+  display: block;
+  overflow: hidden;
+  font-size: 15px;
+  font-weight: 900;
+  letter-spacing: -0.02em;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.lc-parlor__title span {
+  display: block;
+  margin-top: 1px;
+  font-size: 11px;
+  font-weight: 700;
+  opacity: 0.7;
+}
+
+.lc-parlor__icon-button {
+  display: grid;
+  width: 34px;
+  height: 34px;
+  flex: none;
+  place-items: center;
+  border: var(--parlor-line);
+  border-radius: 10px;
+  background: white;
+  box-shadow: 2px 2px 0 var(--parlor-ink);
+  cursor: pointer;
+  transition:
+    transform 150ms ease,
+    box-shadow 150ms ease;
+}
+
+.lc-parlor__icon-button:hover {
+  transform: translate(-1px, -1px);
+  box-shadow: 3px 3px 0 var(--parlor-ink);
+}
+
+.lc-parlor__icon-button:active {
+  transform: translate(2px, 2px);
+  box-shadow: none;
+}
+
+.lc-parlor__members {
+  display: flex;
+  gap: 5px;
+  padding: 8px 12px 7px;
+  overflow-x: auto;
+  border-bottom: 2px solid rgb(20 20 20 / 0.16);
+  scrollbar-width: none;
+}
+
+.lc-parlor__members span {
+  flex: none;
+  padding: 3px 8px;
+  border: 1.5px solid var(--parlor-ink);
+  border-radius: 99px;
+  background: white;
+  font-size: 10.5px;
+  font-weight: 800;
+}
+
+.lc-parlor__messages {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 12px;
+  padding: 14px 12px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  scrollbar-width: thin;
+}
+
+.lc-parlor__empty {
+  margin: auto;
+  max-width: 260px;
+  padding: 18px;
+  border: 2px dashed rgb(20 20 20 / 0.35);
+  border-radius: 16px;
+  background: rgb(255 255 255 / 0.55);
+  font-size: 13px;
+  font-weight: 700;
+  line-height: 1.55;
+  text-align: center;
+}
+
+.lc-parlor--invite {
+  height: auto;
+  min-height: 0;
+}
+
+.lc-parlor__invite-body {
+  display: grid;
+  gap: 12px;
+  padding: 18px;
+}
+
+.lc-parlor__invite-body p {
+  margin: 0;
+  font-size: 13px;
+  font-weight: 700;
+  line-height: 1.55;
+}
+
+.lc-parlor__invite-body .muted {
+  color: rgb(20 20 20 / 0.62);
+}
+
+.lc-parlor__invite-button {
+  display: inline-flex;
+  min-height: 40px;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 0 16px;
+  border: var(--parlor-line);
+  border-radius: 12px;
+  background: var(--parlor-yellow);
+  box-shadow: 3px 3px 0 var(--parlor-ink);
+  font-size: 13px;
+  font-weight: 900;
+  cursor: pointer;
+  transition:
+    transform 140ms ease,
+    box-shadow 140ms ease;
+}
+
+.lc-parlor__invite-button:hover {
+  transform: translate(-1px, -1px);
+  box-shadow: 4px 4px 0 var(--parlor-ink);
+}
+
+.lc-parlor__invite-button:active {
+  transform: translate(3px, 3px);
+  box-shadow: none;
+}
+
+.lc-parlor__picker {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 8px 12px;
+  border-bottom: 2px solid rgb(20 20 20 / 0.16);
+  background: #fffaf0;
+}
+
+.lc-parlor__picker label {
+  font-size: 11px;
+  font-weight: 850;
+}
+
+.lc-parlor__picker select {
+  min-width: 0;
+  flex: 1;
+  height: 30px;
+  padding: 0 8px;
+  border: 2px solid var(--parlor-ink);
+  border-radius: 9px;
+  background: white;
+  font: inherit;
+  font-size: 12px;
+  font-weight: 750;
+}
+
+.lc-parlor__message {
+  position: relative;
+  max-width: 86%;
+  animation: lc-parlor-bubble 420ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
+}
+
+.lc-parlor__message.is-user {
+  align-self: flex-end;
+  transform-origin: 100% 100%;
+}
+
+.lc-parlor__message.is-other {
+  align-self: flex-start;
+  transform-origin: 0 100%;
+}
+
+.lc-parlor__message-name {
+  margin: 0 0 4px 4px;
+  font-size: 10px;
+  font-weight: 900;
+}
+
+.lc-parlor__message.is-user .lc-parlor__message-name {
+  margin-right: 4px;
+  text-align: right;
+}
+
+.lc-parlor__bubble {
+  position: relative;
+  margin: 0;
+  padding: 9px 12px;
+  border: var(--parlor-line);
+  border-radius: 15px;
+  font-size: 13px;
+  font-weight: 650;
+  line-height: 1.42;
+  overflow-wrap: anywhere;
+  white-space: pre-wrap;
+  box-shadow: 3px 3px 0 var(--parlor-ink);
+}
+
+.lc-parlor__message.is-other .lc-parlor__bubble {
+  border-bottom-left-radius: 4px;
+  background: white;
+}
+
+.lc-parlor__message.is-user .lc-parlor__bubble {
+  border-bottom-right-radius: 4px;
+  background: var(--parlor-ink);
+  color: white;
+  box-shadow: 3px 3px 0 var(--parlor-yellow);
+}
+
+.lc-parlor__message.is-ai .lc-parlor__bubble {
+  background: var(--parlor-yellow);
+}
+
+.lc-parlor__reactions {
+  display: flex;
+  gap: 1px;
+  margin-top: 4px;
+  opacity: 0;
+  transform: translateY(-3px);
+  transition:
+    opacity 150ms ease,
+    transform 180ms ease;
+}
+
+.lc-parlor__message:hover .lc-parlor__reactions,
+.lc-parlor__message:focus-within .lc-parlor__reactions,
+.lc-parlor__reactions:has(.is-mine) {
+  opacity: 1;
+  transform: none;
+}
+
+.lc-parlor__reactions button {
+  display: inline-flex;
+  min-width: 24px;
+  min-height: 22px;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  padding: 0 3px;
+  border: 1px solid var(--parlor-ink);
+  border-radius: 99px;
+  background: white;
+  font-size: 11px;
+  cursor: pointer;
+}
+
+.lc-parlor__reactions button:hover,
+.lc-parlor__reactions button.is-mine {
+  background: var(--parlor-yellow);
+}
+
+.lc-parlor__typing {
+  display: flex;
+  align-self: flex-start;
+  gap: 5px;
+  padding: 11px 14px;
+  border: var(--parlor-line);
+  border-radius: 14px 14px 14px 4px;
+  background: var(--parlor-yellow);
+  box-shadow: 3px 3px 0 var(--parlor-ink);
+}
+
+.lc-parlor__typing i {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: var(--parlor-ink);
+  animation: lc-parlor-hop 900ms infinite;
+}
+
+.lc-parlor__typing i:nth-child(2) {
+  animation-delay: 120ms;
+}
+
+.lc-parlor__typing i:nth-child(3) {
+  animation-delay: 240ms;
+}
+
+.lc-parlor__chips {
+  display: flex;
+  gap: 6px;
+  padding: 0 12px 9px;
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+
+.lc-parlor__chips button {
+  flex: none;
+  min-height: 28px;
+  padding: 4px 10px;
+  border: 2px solid var(--parlor-ink);
+  border-radius: 99px;
+  background: white;
+  box-shadow: 2px 2px 0 var(--parlor-ink);
+  font-size: 11px;
+  font-weight: 850;
+  cursor: pointer;
+}
+
+.lc-parlor__chips button:hover {
+  background: var(--parlor-yellow);
+}
+
+.lc-parlor__error {
+  margin: 0 12px 8px;
+  padding: 7px 9px;
+  border: 2px solid #9d2f24;
+  border-radius: 9px;
+  background: #ffe2dc;
+  color: #5f160f;
+  font-size: 11px;
+  font-weight: 750;
+  line-height: 1.4;
+}
+
+.lc-parlor__form {
+  display: flex;
+  gap: 8px;
+  padding: 10px 12px 12px;
+  border-top: var(--parlor-line);
+  background: #fffaf0;
+  padding-bottom: max(12px, env(safe-area-inset-bottom));
+}
+
+.lc-parlor__form input {
+  min-width: 0;
+  flex: 1;
+  height: 42px;
+  padding: 0 12px;
+  border: var(--parlor-line);
+  border-radius: 12px;
+  background: white;
+  color: var(--parlor-ink);
+  outline: 0;
+  font-size: 13px;
+  font-weight: 650;
+}
+
+.lc-parlor__form input:focus {
+  box-shadow: 3px 3px 0 var(--parlor-yellow);
+}
+
+.lc-parlor__send {
+  display: inline-flex;
+  height: 42px;
+  align-items: center;
+  gap: 6px;
+  padding: 0 14px;
+  border: var(--parlor-line);
+  border-radius: 11px;
+  background: var(--parlor-yellow);
+  box-shadow: 3px 3px 0 var(--parlor-ink);
+  font-size: 12px;
+  font-weight: 900;
+  cursor: pointer;
+  transition:
+    transform 140ms ease,
+    box-shadow 140ms ease;
+}
+
+.lc-parlor__send:hover:not(:disabled) {
+  transform: translate(-1px, -1px);
+  box-shadow: 4px 4px 0 var(--parlor-ink);
+}
+
+.lc-parlor__send:active:not(:disabled) {
+  transform: translate(3px, 3px);
+  box-shadow: none;
+}
+
+.lc-parlor__send:disabled {
+  cursor: default;
+  filter: saturate(0.3);
+  opacity: 0.65;
+}
+
+.lc-parlor__send svg {
+  width: 14px;
+  height: 14px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 2.5;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+@media (max-width: 1023px) {
+  .lc-parlor {
+    position: fixed;
+    inset: auto 0 0;
+    z-index: 80;
+    width: 100%;
+    height: min(78dvh, 680px);
+    max-height: calc(100dvh - 1rem);
+    border-right: 0;
+    border-bottom: 0;
+    border-left: 0;
+    border-radius: 24px 24px 0 0;
+    box-shadow: 0 -7px 0 var(--parlor-ink);
+    animation: lc-parlor-sheet-in 400ms cubic-bezier(0.22, 1, 0.36, 1) both;
+  }
+}
+
+@keyframes lc-parlor-sheet-in {
+  from {
+    transform: translateY(105%);
+  }
+}
+
+@keyframes lc-parlor-float-in {
+  from {
+    opacity: 0;
+    transform: translateY(24px) scale(0.96);
+  }
+}
+
+@keyframes lc-parlor-talk {
+  from {
+    transform: scaleY(0.55);
+  }
+  to {
+    transform: scaleY(2) scaleX(0.85);
+  }
+}
+
+@keyframes lc-parlor-bounce {
+  to {
+    transform: scale(1.04, 0.97);
+  }
+}
+
+@keyframes lc-parlor-hop {
+  0%,
+  60%,
+  100% {
+    transform: none;
+  }
+  30% {
+    transform: translateY(-5px);
+  }
+}
+
+@keyframes lc-parlor-bubble {
+  from {
+    opacity: 0;
+    transform: scale(0.45) translateY(9px);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .lc-parlor *,
+  .lc-parlor *::before,
+  .lc-parlor *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+  }
+}
diff --git a/client/src/components/Life/ParlorMemoryPanel.tsx b/client/src/components/Life/ParlorMemoryPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..96abbd6b4e06bc66bfad5930dea9166b2ccda68b
--- /dev/null
+++ b/client/src/components/Life/ParlorMemoryPanel.tsx
@@ -0,0 +1,319 @@
+import { useEffect, useRef, useState } from 'react';
+import type { LifeSharedMemoryMessage } from 'librechat-data-provider';
+import { X } from 'lucide-react';
+import './ParlorMemoryPanel.css';
+
+const REACTIONS = ['❤️', '👍', '😂', '✨', '👀'] as const;
+
+type Props = {
+  title: string;
+  members: Array<{ user_id: string; display_name: string }>;
+  currentUserId?: string;
+  messages: LifeSharedMemoryMessage[];
+  pending?: boolean;
+  error?: string;
+  onClose: () => void;
+  onSend: (body: string) => Promise<void>;
+  onReact: (
+    messageId: string,
+    emoji: (typeof REACTIONS)[number],
+  ) => Promise<void>;
+};
+
+function codeFromError(error: unknown) {
+  const value = error as {
+    response?: { data?: { detail?: { code?: string } | string } };
+    message?: string;
+  };
+  const detail = value.response?.data?.detail;
+  return typeof detail === 'string'
+    ? detail
+    : detail?.code || value.message || 'REQUEST_FAILED';
+}
+
+function useReducedMotion() {
+  const [reduced, setReduced] = useState(false);
+  useEffect(() => {
+    const media = window.matchMedia('(prefers-reduced-motion: reduce)');
+    const update = () => setReduced(media.matches);
+    update();
+    media.addEventListener('change', update);
+    return () => media.removeEventListener('change', update);
+  }, []);
+  return reduced;
+}
+
+function ParlorFace({
+  look,
+  talking,
+  reduced,
+}: {
+  look: { x: number; y: number };
+  talking: boolean;
+  reduced: boolean;
+}) {
+  const [blink, setBlink] = useState(false);
+  useEffect(() => {
+    if (reduced) {
+      return;
+    }
+    let timer = 0;
+    let cancelled = false;
+    const loop = () => {
+      timer = window.setTimeout(() => {
+        if (cancelled) {
+          return;
+        }
+        setBlink(true);
+        window.setTimeout(() => setBlink(false), 120);
+        loop();
+      }, 2300 + Math.random() * 2800);
+    };
+    loop();
+    return () => {
+      cancelled = true;
+      window.clearTimeout(timer);
+    };
+  }, [reduced]);
+  const dx = Math.max(-4, Math.min(4, look.x * 4));
+  const dy = Math.max(-3, Math.min(3, look.y * 3));
+  return (
+    <svg
+      className="lc-parlor__face"
+      viewBox="0 0 100 100"
+      aria-hidden="true"
+      focusable="false"
+    >
+      <circle className="lc-parlor__face-body" cx="50" cy="51" r="41" />
+      {[36, 64].map((x) => (
+        <g key={x}>
+          <ellipse
+            className="lc-parlor__face-white"
+            cx={x}
+            cy="45"
+            rx="10"
+            ry={blink ? 1 : 11}
+          />
+          {!blink ? (
+            <circle
+              className="lc-parlor__face-pupil"
+              cx={x + dx}
+              cy={45 + dy}
+              r="4.6"
+            />
+          ) : null}
+        </g>
+      ))}
+      <path className="lc-parlor__face-mouth" d="M37 65q13 11 26 0" />
+    </svg>
+  );
+}
+
+export default function ParlorMemoryPanel({
+  title,
+  members,
+  currentUserId,
+  messages,
+  pending = false,
+  error,
+  onClose,
+  onSend,
+  onReact,
+}: Props) {
+  const reduced = useReducedMotion();
+  const [draft, setDraft] = useState('');
+  const [localError, setLocalError] = useState('');
+  const [sending, setSending] = useState(false);
+  const [look, setLook] = useState({ x: 0, y: 0 });
+  const listRef = useRef<HTMLDivElement>(null);
+  const inputRef = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    const element = listRef.current;
+    if (element) {
+      element.scrollTo({
+        top: element.scrollHeight,
+        behavior: reduced ? 'auto' : 'smooth',
+      });
+    }
+  }, [messages, pending, reduced]);
+
+  const send = async () => {
+    const body = draft.trim();
+    if (!body || sending || pending) {
+      return;
+    }
+    setSending(true);
+    setLocalError('');
+    try {
+      await onSend(body);
+      setDraft('');
+    } catch (sendError) {
+      setLocalError(`发送失败，草稿已保留：${codeFromError(sendError)}`);
+    } finally {
+      setSending(false);
+      inputRef.current?.focus();
+    }
+  };
+
+  return (
+    <section
+      className={`lc-parlor ${pending ? 'is-talking' : ''}`}
+      aria-label={`${title} 的共同回忆协作窗口`}
+      onPointerMove={(event) => {
+        const bounds = event.currentTarget.getBoundingClientRect();
+        setLook({
+          x: ((event.clientX - bounds.left) / bounds.width - 0.5) * 2,
+          y: ((event.clientY - bounds.top) / bounds.height - 0.35) * 2,
+        });
+      }}
+    >
+      <header className="lc-parlor__header">
+        <ParlorFace look={look} talking={pending} reduced={reduced} />
+        <div className="lc-parlor__title">
+          <strong>{title}</strong>
+          <span>
+            {members.length} 位成员 · {pending ? 'Agent 正在核对权限…' : '共同回忆进行中'}
+          </span>
+        </div>
+        <button
+          type="button"
+          className="lc-parlor__icon-button"
+          aria-label="收起共同回忆窗口"
+          onClick={onClose}
+        >
+          <X size={17} aria-hidden="true" />
+        </button>
+      </header>
+
+      <div className="lc-parlor__members" aria-label="共同回忆成员">
+        {members.map((member) => (
+          <span key={member.user_id}>{member.display_name}</span>
+        ))}
+        <span>拾光 AI</span>
+      </div>
+
+      <div
+        ref={listRef}
+        className="lc-parlor__messages"
+        aria-live="polite"
+        aria-busy={pending || sending}
+      >
+        {messages.length === 0 ? (
+          <p className="lc-parlor__empty">
+            这段共同回忆还没有聊天。补充一个细节，或问拾光 AI 整理已有材料。
+          </p>
+        ) : null}
+        {messages.map((message) => {
+          const mine = message.sender_id === currentUserId;
+          const isAi = message.sender_kind === 'ai';
+          return (
+            <article
+              key={message.message_id}
+              className={`lc-parlor__message ${
+                mine ? 'is-user' : 'is-other'
+              } ${isAi ? 'is-ai' : ''}`}
+            >
+              <p className="lc-parlor__message-name">
+                {isAi ? '拾光 AI' : message.sender_display_name}
+              </p>
+              <p className="lc-parlor__bubble">{message.body}</p>
+              <div className="lc-parlor__reactions" aria-label="消息回应">
+                {REACTIONS.map((emoji) => {
+                  const count =
+                    message.reactions?.find((item) => item.emoji === emoji)?.count ?? 0;
+                  const active =
+                    message.reactions?.find((item) => item.emoji === emoji)?.mine ?? false;
+                  return (
+                    <button
+                      key={emoji}
+                      type="button"
+                      className={active ? 'is-mine' : ''}
+                      aria-label={`回应 ${emoji}${count ? `，共 ${count} 个` : ''}`}
+                      onClick={() => void onReact(message.message_id, emoji)}
+                    >
+                      {emoji}
+                      {count ? <span>{count}</span> : null}
+                    </button>
+                  );
+                })}
+              </div>
+            </article>
+          );
+        })}
+        {pending ? (
+          <div className="lc-parlor__typing" aria-label="拾光 AI 正在响应">
+            <i />
+            <i />
+            <i />
+          </div>
+        ) : null}
+      </div>
+
+      <div className="lc-parlor__chips">
+        <button
+          type="button"
+          onClick={() => {
+            setDraft('@AI 请只根据这段共同回忆里已授权的内容，整理一份可审阅的摘要。');
+            inputRef.current?.focus();
+          }}
+        >
+          ✦ 整理共同回忆
+        </button>
+        <button
+          type="button"
+          onClick={() => {
+            setDraft('我还记得一个细节：');
+            inputRef.current?.focus();
+          }}
+        >
+          补充一个细节
+        </button>
+        <button
+          type="button"
+          onClick={() => {
+            setDraft('那时我们');
+            inputRef.current?.focus();
+          }}
+        >
+          接着聊
+        </button>
+      </div>
+
+      {error || localError ? (
+        <p className="lc-parlor__error" role="alert">
+          {localError || error}
+        </p>
+      ) : null}
+
+      <form
+        className="lc-parlor__form"
+        onSubmit={(event) => {
+          event.preventDefault();
+          void send();
+        }}
+      >
+        <input
+          ref={inputRef}
+          value={draft}
+          maxLength={4000}
+          placeholder="@AI 或输入消息…"
+          aria-label="共同回忆消息"
+          onChange={(event) => setDraft(event.target.value)}
+          onFocus={() => setLook({ x: 0.7, y: 0.7 })}
+          onBlur={() => setLook({ x: 0, y: 0 })}
+        />
+        <button
+          type="submit"
+          className="lc-parlor__send"
+          disabled={!draft.trim() || sending || pending}
+        >
+          发送
+          <svg viewBox="0 0 16 16" aria-hidden="true">
+            <path d="M2 8h11M9 4l4 4-4 4" />
+          </svg>
+        </button>
+      </form>
+    </section>
+  );
+}
