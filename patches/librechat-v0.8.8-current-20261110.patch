+import { useEffect, useRef, useState } from 'react';
+import { Button } from '@librechat/client';
+import { useQuery } from '@tanstack/react-query';
+import { Search, SlidersHorizontal } from 'lucide-react';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { Link, useLocation, useParams, useSearchParams } from 'react-router-dom';
+import type { LifeMemory } from 'librechat-data-provider';
+import { occurrenceDay, occurrenceLabel } from './occurrence';
+import { useAuthContext, useLocalize } from '~/hooks';
+import SharedMemoryCard from './SharedMemoryCard';
+import MemorySkeleton from './MemorySkeleton';
+import MemoryDetail from './MemoryDetail';
+import MemoryCard from './MemoryCard';
+
+const timezone = 'Asia/Hong_Kong';
+const dateKeyFormatter = new Intl.DateTimeFormat('en-CA', {
+  timeZone: timezone,
+  year: 'numeric',
+  month: '2-digit',
+  day: '2-digit',
+});
+const dateLabelFormatter = new Intl.DateTimeFormat('zh-CN', {
+  timeZone: timezone,
+  month: 'long',
+  day: 'numeric',
+  weekday: 'short',
+});
+
+function dateGroupLabel(value: string, localize: ReturnType<typeof useLocalize>) {
+  const key = dateKeyFormatter.format(new Date(value));
+  const today = dateKeyFormatter.format(new Date());
+  const yesterday = dateKeyFormatter.format(new Date(Date.now() - 24 * 60 * 60 * 1000));
+  const label = dateLabelFormatter.format(new Date(`${key}T12:00:00+08:00`));
+  if (key === today) {
+    return `${localize('com_life_today')} · ${label}`;
+  }
+  if (key === yesterday) {
+    return `${localize('com_life_yesterday')} · ${label}`;
+  }
+  return label;
+}
+
+function groupMemories(memories: LifeMemory[], localize: ReturnType<typeof useLocalize>) {
+  const groups: Array<{ key: string; label: string; items: LifeMemory[] }> = [];
+  for (const memory of memories) {
+    const key = `${memory.occurrence_precision ?? 'unknown'}:${memory.occurrence_start ?? ''}:${memory.occurrence_end ?? ''}`;
+    const day = occurrenceDay(memory);
+    const current = groups[groups.length - 1];
+    if (current?.key === key) {
+      current.items.push(memory);
+    } else {
+      groups.push({
+        key,
+        label: day
+          ? dateGroupLabel(`${day}T12:00:00+08:00`, localize)
+          : occurrenceLabel(memory, localize('com_life_date_unknown')),
+        items: [memory],
+      });
+    }
+  }
+  return groups;
+}
+
+export default function Memories() {
+  const { user, isAuthenticated } = useAuthContext();
+  const localize = useLocalize();
+  const { memoryId } = useParams();
+  const location = useLocation();
+  const [params, setParams] = useSearchParams();
+  const [search, setSearch] = useState(params.get('q') ?? '');
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const queryString = params.toString();
+  const scrollKey = `life:scroll:${user?.id}:${queryString}`;
+  const list = useQuery({
+    queryKey: [QueryKeys.lifeMemories, user?.id, queryString],
+    queryFn: ({ signal }) => lifeService.memories(queryString, signal),
+    enabled: isAuthenticated && !memoryId,
+    retry: false,
+    staleTime: 0,
+  });
+  const shared = useQuery({
+    queryKey: [QueryKeys.lifeSharedMemories, user?.id],
+    queryFn: ({ signal }) => lifeService.sharedMemories(signal),
+    enabled: isAuthenticated && !memoryId,
+    retry: false,
+    staleTime: 0,
+  });
+  const detail = useQuery({
+    queryKey: [QueryKeys.lifeMemory, user?.id, memoryId],
+    queryFn: ({ signal }) => lifeService.memory(memoryId ?? '', signal),
+    enabled: isAuthenticated && !!memoryId,
+    retry: false,
+    staleTime: 0,
+  });
+  const query = memoryId ? detail : list;
+  useEffect(() => {
+    setSearch(params.get('q') ?? '');
+  }, [queryString, params]);
+  useEffect(() => {
+    const element = scrollRef.current;
+    if (element && !memoryId && list.isSuccess) {
+      element.scrollTop = Number(sessionStorage.getItem(scrollKey) ?? 0);
+    }
+  }, [memoryId, list.isSuccess, scrollKey]);
+  const updateFilter = (key: string, value: string) => {
+    const next = new URLSearchParams(params);
+    next.delete('page');
+    if (value) {
+      next.set(key, value);
+    } else {
+      next.delete(key);
+    }
+    setParams(next);
+  };
+  const memory = detail.data?.memory;
+  const page = list.data?.page ?? 1;
+  const groups = groupMemories(list.data?.memories ?? [], localize);
+  const hasFilters = Boolean(params.get('q') || params.get('on_date') || params.get('order'));
+
+  return (
+    <div
+      ref={scrollRef}
+      className="min-h-0 flex-1 overflow-y-auto overscroll-contain bg-surface-primary"
+      onScroll={(event) => {
+        if (!memoryId) {
+          sessionStorage.setItem(scrollKey, String(event.currentTarget.scrollTop));
+        }
+      }}
+    >
+      <main className="not-prose mx-auto w-full max-w-[1180px] px-4 py-8 text-text-primary sm:px-6 sm:py-10 lg:px-8">
+        <header className="mb-8 flex flex-wrap items-end justify-between gap-5">
+          <div className="min-w-0 max-w-2xl">
+            <p className="mb-3 text-xs font-semibold tracking-[0.2em] text-text-secondary">
+              {localize(memoryId ? 'com_life_journal' : 'com_life_gallery')}
+            </p>
+            <h1 className="font-serif mb-3 break-words text-3xl sm:text-4xl">
+              {localize(memoryId ? 'com_life_detail' : 'com_life_memories')}
+            </h1>
+            {!memoryId ? (
+              <p className="text-sm leading-7 text-text-secondary">{localize('com_life_intro')}</p>
+            ) : null}
+          </div>
+          {!memoryId ? (
+            <Link
+              className="inline-flex min-h-11 items-center rounded-lg px-3 text-sm text-link underline underline-offset-4 hover:bg-surface-hover"
+              to="/memory-settings"
+            >
+              {localize('com_life_memory_settings')}
+            </Link>
+          ) : null}
+        </header>
+
+        {memoryId && query.isSuccess && memory ? (
+          <MemoryDetail memory={memory} backTo={`/memories${location.search}`} />
+        ) : null}
+        {!memoryId ? (
+          <>
+            <form
+              className="mb-6 rounded-2xl border border-border-light bg-surface-primary-alt p-3 sm:p-4"
+              onSubmit={(event) => {
+                event.preventDefault();
+                updateFilter('q', search);
+              }}
+            >
+              <div className="flex flex-col gap-3 sm:flex-row">
+                <label className="relative min-w-0 flex-1">
+                  <span className="sr-only">{localize('com_life_search')}</span>
+                  <Search
+                    className="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-text-secondary"
+                    aria-hidden="true"
+                  />
+                  <input
+                    className="min-h-11 w-full rounded-xl border border-border-medium bg-surface-primary py-2 pl-10 pr-3 text-text-primary placeholder:text-text-secondary"
+                    type="search"
+                    value={search}
+                    maxLength={200}
+                    placeholder={localize('com_life_search')}
+                    onChange={(event) => setSearch(event.target.value)}
+                  />
+                </label>
+                <Button type="submit" className="min-h-11">
+                  {localize('com_life_search_button')}
+                </Button>
+              </div>
+              <details className="mt-3 border-t border-border-light pt-3">
+                <summary className="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg px-2 text-sm text-text-secondary hover:bg-surface-hover">
+                  <SlidersHorizontal className="size-4" aria-hidden="true" />
+                  {localize('com_life_advanced_filters')}
+                  {hasFilters ? (
+                    <span className="rounded-full bg-surface-active px-2 py-0.5 text-[11px] text-text-primary">
+                      {localize('com_life_filters_on')}
+                    </span>
+                  ) : null}
+                </summary>
+                <div className="grid gap-4 pt-3 sm:grid-cols-2">
+                  <label className="grid min-w-0 gap-2 text-sm">
+                    {localize('com_life_date')}
+                    <input
+                      className="min-h-11 min-w-0 rounded-lg border border-border-medium bg-surface-primary px-3 py-2 text-text-primary"
+                      type="date"
+                      value={params.get('on_date') ?? ''}
+                      onChange={(event) => updateFilter('on_date', event.target.value)}
+                    />
+                  </label>
+                  <label className="grid min-w-0 gap-2 text-sm">
+                    {localize('com_life_order')}
+                    <select
+                      className="min-h-11 min-w-0 rounded-lg border border-border-medium bg-surface-primary px-3 py-2 text-text-primary"
+                      value={params.get('order') ?? 'desc'}
+                      onChange={(event) => updateFilter('order', event.target.value)}
+                    >
+                      <option value="desc">{localize('com_life_newest')}</option>
+                      <option value="asc">{localize('com_life_oldest')}</option>
+                    </select>
+                  </label>
+                </div>
+                {hasFilters ? (
+                  <div className="mt-3 flex justify-end">
+                    <Button type="button" variant="ghost" onClick={() => setParams({})}>
+                      {localize('com_life_clear')}
+                    </Button>
+                  </div>
+                ) : null}
+              </details>
+            </form>
+
+            {shared.data?.shared_memories.length ? (
+              <section className="mb-10" aria-labelledby="shared-memories-heading">
+                <div className="mb-4 flex items-end justify-between gap-4">
+                  <div className="min-w-0">
+                    <h2 id="shared-memories-heading" className="font-serif text-2xl">
+                      {localize('com_life_shared_title')}
+                    </h2>
+                    <p className="mt-1 text-sm leading-6 text-text-secondary">
+                      {localize('com_life_shared_intro')}
+                    </p>
+                  </div>
+                  <span className="shrink-0 text-xs text-text-secondary">
+                    {localize('com_life_shared_count', {
+                      count: shared.data.shared_memories.length,
+                    })}
+                  </span>
+                </div>
+                <div className="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
+                  {shared.data.shared_memories.map((item, index) => (
+                    <SharedMemoryCard key={item.shared_memory_id} shared={item} index={index} />
+                  ))}
+                </div>
+              </section>
+            ) : null}
+
+            {query.isLoading ? <MemorySkeleton /> : null}
+            {query.isError ? (
+              <div
+                role="alert"
+                className="rounded-2xl border border-border-medium bg-surface-primary-alt p-6"
+              >
+                <p className="mb-4 leading-7">{localize('com_life_error')}</p>
+                <Button onClick={() => query.refetch()}>{localize('com_ui_retry')}</Button>
+              </div>
+            ) : null}
+          </>
+        ) : null}
+
+        {query.isLoading && memoryId ? (
+          <div role="status" className="mx-auto max-w-4xl">
+            <div className="aspect-[4/3] animate-pulse rounded-3xl bg-surface-secondary motion-reduce:animate-none" />
+            <p className="mt-5 text-sm text-text-secondary">{localize('com_life_loading')}</p>
+          </div>
+        ) : null}
+        {query.isError && memoryId ? (
+          <div
+            role="alert"
+            className="mx-auto max-w-4xl rounded-2xl border border-border-medium bg-surface-primary-alt p-6"
+          >
+            <p className="mb-4 leading-7">{localize('com_life_error')}</p>
+            <Button onClick={() => query.refetch()}>{localize('com_ui_retry')}</Button>
+          </div>
+        ) : null}
+        {query.isSuccess && !memoryId && list.data?.memories.length === 0 ? (
+          <div
+            role="status"
+            className="rounded-2xl border border-dashed border-border-medium px-6 py-16 text-center"
+          >
+            <h2 className="font-serif mb-3 text-2xl">{localize('com_life_empty')}</h2>
+            <p className="text-sm leading-7 text-text-secondary">
+              {localize('com_life_empty_hint')}
+            </p>
+          </div>
+        ) : null}
+        {query.isSuccess && !memoryId && (list.data?.memories.length ?? 0) > 0 ? (
+          <>
+            <p role="status" className="mb-4 text-sm text-text-secondary">
+              {localize('com_life_count', { count: list.data?.total ?? 0 })}
+            </p>
+            <div className="space-y-10">
+              {groups.map((group) => (
+                <section key={group.key} aria-labelledby={`memory-day-${group.key}`}>
+                  <div className="mb-4 flex items-baseline justify-between gap-4">
+                    <h2 id={`memory-day-${group.key}`} className="font-serif text-2xl">
+                      {group.label}
+                    </h2>
+                    <p className="text-xs text-text-secondary">
+                      {localize('com_life_day_count', { count: group.items.length })}
+                    </p>
+                  </div>
+                  <div className="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
+                    {group.items.map((item, index) => (
+                      <MemoryCard key={item.event_id} memory={item} index={index} />
+                    ))}
+                  </div>
+                </section>
+              ))}
+            </div>
+            <nav
+              aria-label={localize('com_life_pagination')}
+              className="mt-8 flex items-center justify-between gap-3"
+            >
+              <Button
+                disabled={page <= 1}
+                onClick={() => {
+                  const next = new URLSearchParams(params);
+                  next.set('page', String(page - 1));
+                  setParams(next);
+                }}
+              >
+                {localize('com_life_previous')}
+              </Button>
+              <span className="text-sm">{page}</span>
+              <Button
+                disabled={!list.data?.has_more}
+                onClick={() => {
+                  const next = new URLSearchParams(params);
+                  next.set('page', String(page + 1));
+                  setParams(next);
+                }}
+              >
+                {localize('com_life_next')}
+              </Button>
+            </nav>
+          </>
+        ) : null}
+        <p className="mt-12 text-xs leading-6 text-text-secondary">
+          {localize('com_life_private')}
+        </p>
+      </main>
+    </div>
+  );
+}
