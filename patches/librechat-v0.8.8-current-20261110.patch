@@ -0,0 +1,270 @@
+import { useState } from 'react';
+import { Link, useParams } from 'react-router-dom';
+import { Button, Spinner } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+function statusLabel(status: string, localize: ReturnType<typeof useLocalize>) {
+  switch (status) {
+    case 'queued':
+      return localize('com_life_moment_status_queued');
+    case 'generating':
+      return localize('com_life_moment_status_generating');
+    case 'generated':
+      return localize('com_life_moment_status_generated');
+    case 'pending_provider':
+      return localize('com_life_moment_status_pending_provider');
+    case 'failed':
+      return localize('com_life_moment_status_failed');
+    case 'cancelled':
+      return localize('com_life_moment_status_cancelled');
+    default:
+      return localize('com_life_moment_status_unknown');
+  }
+}
+
+function formatMomentWindow(value: string, timeZone: string) {
+  return new Intl.DateTimeFormat('zh-CN', {
+    timeZone,
+    month: 'long',
+    day: 'numeric',
+    hour: '2-digit',
+    minute: '2-digit',
+    hour12: false,
+  }).format(new Date(value));
+}
+
+export function MomentList() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const [notice, setNotice] = useState('');
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeMoments, user?.id],
+    queryFn: lifeService.moments,
+    retry: false,
+    refetchInterval: (data) =>
+      data?.moments.some((m) => ['queued', 'generating'].includes(m.status)) ? 3000 : false,
+  });
+  const adminStatus = useQuery({
+    queryKey: [QueryKeys.lifeDirectMomentTest, user?.id],
+    queryFn: ({ signal }) => lifeService.directMomentTestStatus(signal),
+    enabled: Boolean(user?.id),
+    retry: false,
+  });
+  const publish = useMutation((momentId: string) => lifeService.publishMoment(momentId), {
+    onSuccess: async () => {
+      setNotice(localize('com_life_moment_added'));
+      await Promise.all([
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMemories] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMemory] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMoments] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMoment] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeChatLinks] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeKnowledge] }),
+      ]);
+    },
+    onError: () => setNotice(''),
+  });
+  return (
+    <section className="my-6 space-y-4" aria-label={localize('com_life_moments')}>
+      <div className="flex flex-wrap items-center justify-between gap-3">
+        <h2 className="font-serif text-2xl">{localize('com_life_moments')}</h2>
+        <Link
+          className="inline-flex min-h-11 items-center text-link underline"
+          to="/moments/settings"
+        >
+          {localize('com_life_moment_settings')}
+        </Link>
+      </div>
+      {query.isLoading ? <Spinner /> : null}
+      {query.isError ? (
+        <Button onClick={() => void query.refetch()}>{localize('com_life_sources_retry')}</Button>
+      ) : null}
+      {query.isSuccess && !query.data.moments.length ? (
+        <p>{localize('com_life_no_moments')}</p>
+      ) : null}
+      <p className="text-sm leading-7 text-text-secondary">{localize('com_life_moment_relation')}</p>
+      <div className="grid gap-3 sm:grid-cols-2">
+        {query.data?.moments.map((item) => (
+          <article
+            key={item.moment_id}
+            className="space-y-2 rounded-2xl border border-border-light bg-surface-primary-alt p-4 text-text-primary"
+          >
+            <Link className="block space-y-2 text-text-primary" to={`/moments/${item.moment_id}`}>
+              <p className="text-sm text-text-secondary">
+                {formatMomentWindow(item.window_end, item.timezone)}
+              </p>
+              <p className="break-words leading-7">
+                {item.caption || localize('com_life_forgotten')}
+              </p>
+              <p>
+                {localize('com_life_ai_moment')} · {statusLabel(item.status, localize)}
+              </p>
+            </Link>
+            {adminStatus.data?.enabled && item.status !== 'cancelled' ? (
+              <div className="mt-3 flex flex-wrap items-center gap-3 border-t border-border-light pt-3">
+                <Button
+                  variant="outline"
+                  size="sm"
+                  disabled={publish.isLoading && publish.variables === item.moment_id}
+                  onClick={() => publish.mutate(item.moment_id)}
+                >
+                  {publish.isLoading && publish.variables === item.moment_id
+                    ? localize('com_life_moment_adding')
+                    : publish.isSuccess && publish.variables === item.moment_id
+                      ? localize('com_life_moment_added')
+                      : localize('com_life_add_moment_to_memories')}
+                </Button>
+                {publish.isError && publish.variables === item.moment_id ? (
+                  <p role="alert" className="text-sm text-red-700">
+                    {localize('com_life_moment_add_error')}
+                  </p>
+                ) : null}
+              </div>
+            ) : null}
+          </article>
+        ))}
+      </div>
+      {notice ? (
+        <p role="status" className="text-sm text-emerald-700">
+          {notice}
+        </p>
+      ) : null}
+    </section>
+  );
+}
+
+export default function MomentDetail() {
+  const { momentId = '' } = useParams();
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const [publishedMemoryId, setPublishedMemoryId] = useState('');
+  const refresh = () => {
+    void cache.invalidateQueries([QueryKeys.lifeMoment, user?.id, momentId]);
+    void cache.invalidateQueries([QueryKeys.lifeMoments, user?.id]);
+    void cache.invalidateQueries([QueryKeys.lifeChatLinks, user?.id]);
+  };
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeMoment, user?.id, momentId],
+    queryFn: () => lifeService.moment(momentId),
+    retry: false,
+    refetchInterval: (data) =>
+      data && ['queued', 'generating'].includes(data.moment.status) ? 3000 : false,
+  });
+  const adminStatus = useQuery({
+    queryKey: [QueryKeys.lifeDirectMomentTest, user?.id],
+    queryFn: ({ signal }) => lifeService.directMomentTestStatus(signal),
+    enabled: Boolean(user?.id),
+    retry: false,
+  });
+  const retry = useMutation(() => lifeService.retryMoment(momentId), { onSuccess: refresh });
+  const remove = useMutation(() => lifeService.deleteMoment(momentId), { onSuccess: refresh });
+  const publish = useMutation(() => lifeService.publishMoment(momentId), {
+    onSuccess: async (result) => {
+      setPublishedMemoryId(result.memory.event_id);
+      await Promise.all([
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMemories] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMemory] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMoments] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeMoment, user?.id, momentId] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeChatLinks] }),
+        cache.invalidateQueries({ queryKey: [QueryKeys.lifeKnowledge] }),
+      ]);
+    },
+  });
+  const item = query.data?.moment;
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-5">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/memories">
+          {localize('com_life_back')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_view_moment')}</h1>
+        {query.isLoading ? <Spinner /> : null}
+        {query.isError ? <p role="alert">{localize('com_life_entity_unavailable')}</p> : null}
+        {item ? (
+          <>
+            <p>{localize('com_life_ai_moment')}</p>
+            <p role="status">
+              {localize('com_life_entity_status')}: {statusLabel(item.status, localize)}
+            </p>
+            <p>
+              {formatMomentWindow(item.window_start, item.timezone)} →{' '}
+              {formatMomentWindow(item.window_end, item.timezone)}
+            </p>
+            {item.image_data ? (
+              <img
+                className="h-auto w-full rounded-2xl"
+                src={item.image_data}
+                alt={localize('com_life_ai_moment')}
+              />
+            ) : (
+              <p>{localize('com_life_moment_pending')}</p>
+            )}
+            <p className="break-words leading-8">{item.caption}</p>
+            {adminStatus.data?.enabled && item.status !== 'cancelled' ? (
+              <div className="flex flex-wrap items-center gap-3">
+                <Button
+                  variant="outline"
+                  disabled={publish.isLoading}
+                  onClick={() => publish.mutate()}
+                >
+                  {publish.isLoading
+                    ? localize('com_life_moment_adding')
+                    : publish.isSuccess
+                      ? localize('com_life_moment_added')
+                      : localize('com_life_add_moment_to_memories')}
+                </Button>
+                {publishedMemoryId ? (
+                  <Link
+                    className="inline-flex min-h-11 items-center text-link underline"
+                    to={`/memories/${publishedMemoryId}`}
+                  >
+                    {localize('com_life_view_memories')}
+                  </Link>
+                ) : null}
+              </div>
+            ) : null}
+            {publish.isError ? (
+              <p role="alert" className="text-sm text-red-700">
+                {localize('com_life_moment_add_error')}
+              </p>
+            ) : null}
+            {item.source_memory_ids.map((id) => (
+              <Link key={id} className="block min-h-11 text-link underline" to={`/knowledge/${id}`}>
+                {localize('com_life_view_knowledge')}
+              </Link>
+            ))}
+            <details>
+              <summary className="min-h-11 cursor-pointer">
+                {localize('com_life_selection_reason')}
+              </summary>
+              <pre className="overflow-auto text-sm">{JSON.stringify(item.selection, null, 2)}</pre>
+            </details>
+            {['failed', 'unknown', 'pending_provider'].includes(item.status) &&
+            item.attempts < 3 ? (
+              <>
+                <p>{localize('com_life_moment_retry_notice')}</p>
+                <Button disabled={retry.isLoading} onClick={() => retry.mutate()}>
+                  {localize('com_ui_retry')}
+                </Button>
+              </>
+            ) : null}
+            {item.status !== 'cancelled' ? (
+              <Button variant="outline" disabled={remove.isLoading} onClick={() => remove.mutate()}>
+                {localize('com_life_delete_moment')}
+              </Button>
+            ) : null}
+            <Link className="block min-h-11 text-link underline" to="/moments/settings">
+              {localize('com_life_moment_settings')}
+            </Link>
+          </>
+        ) : null}
+        {retry.isError || remove.isError ? <p role="alert">{localize('com_life_error')}</p> : null}
+      </div>
+    </main>
+  );
+}
