+import { useEffect, useMemo, useRef, useState } from 'react';
+import {
+  ChatContainer,
+  MainContainer,
+  Message,
+  MessageList,
+  TypingIndicator,
+} from '@chatscope/chat-ui-kit-react';
+import '@chatscope/chat-ui-kit-styles/dist/default/styles.min.css';
+import { Button } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery } from '@tanstack/react-query';
+import { ArrowLeft, Bot, Send, ShieldCheck, UsersRound } from 'lucide-react';
+import { Link, useParams } from 'react-router-dom';
+import { useAuthContext } from '~/hooks';
+import './SpaceRoom.css';
+
+function errorCode(error: unknown) {
+  const value = error as {
+    response?: { data?: { detail?: { code?: string } | string } };
+    message?: string;
+  };
+  const detail = value.response?.data?.detail;
+  return typeof detail === 'string'
+    ? detail
+    : detail?.code || value.message || 'REQUEST_FAILED';
+}
+
+function messageTime(value: string) {
+  return new Intl.DateTimeFormat('zh-CN', {
+    hour: '2-digit',
+    minute: '2-digit',
+  }).format(new Date(value));
+}
+
+export default function SpaceRoom() {
+  const { spaceId = '' } = useParams();
+  const { user } = useAuthContext();
+  const [draft, setDraft] = useState('');
+  const [error, setError] = useState('');
+  const [aiPending, setAiPending] = useState(false);
+  const eventCursor = useRef(0);
+  const scopeKey = `space:${spaceId}`;
+
+  const me = useQuery({
+    queryKey: [QueryKeys.lifeCollaborationMe, user?.id],
+    queryFn: ({ signal }) => lifeService.collaborationMe(signal),
+    retry: false,
+  });
+  const space = useQuery({
+    queryKey: [QueryKeys.lifeSpace, user?.id, spaceId],
+    queryFn: ({ signal }) => lifeService.space(spaceId, signal),
+    enabled: Boolean(spaceId),
+    retry: false,
+  });
+  const messages = useQuery({
+    queryKey: [QueryKeys.lifeSpaceMessages, user?.id, spaceId],
+    queryFn: ({ signal }) => lifeService.spaceMessages(spaceId, undefined, signal),
+    enabled: Boolean(spaceId),
+    retry: false,
+  });
+
+  useEffect(() => {
+    if (!spaceId) {
+      return;
+    }
+    let stopped = false;
+    const controller = new AbortController();
+    const run = async () => {
+      while (!stopped) {
+        try {
+          const result = await lifeService.waitCollaborationEvents(
+            scopeKey,
+            eventCursor.current,
+            15,
+            controller.signal,
+          );
+          if (result.events.length > 0) {
+            eventCursor.current = Math.max(
+              eventCursor.current,
+              ...result.events.map((event) => event.event_id),
+            );
+            await messages.refetch();
+          }
+        } catch (requestError) {
+          if (controller.signal.aborted || stopped) {
+            break;
+          }
+          setError(`实时连接暂时中断：${errorCode(requestError)}`);
+          await new Promise((resolve) => window.setTimeout(resolve, 1200));
+        }
+      }
+    };
+    void run();
+    return () => {
+      stopped = true;
+      controller.abort();
+      eventCursor.current = 0;
+    };
+  }, [scopeKey, spaceId]);
+
+  const send = useMutation(
+    async (text: string) => {
+      const clientMessageId = crypto.randomUUID();
+      const aiQuery = text.match(/^@ai\s+([\s\S]+)$/i);
+      if (aiQuery) {
+        setAiPending(true);
+        return lifeService.agentSpaceQuery(spaceId, { query: aiQuery[1].trim() });
+      }
+      return lifeService.sendSpaceMessage(spaceId, {
+        body: text,
+        client_message_id: clientMessageId,
+      });
+    },
+    {
+      onMutate: () => setError(''),
+      onSuccess: async () => {
+        setDraft('');
+        await messages.refetch();
+        await space.refetch();
+      },
+      onError: (requestError) => {
+        setError(`发送失败，草稿已保留：${errorCode(requestError)}`);
+      },
+      onSettled: () => setAiPending(false),
+    },
+  );
+
+  const memberNames = useMemo(
+    () =>
+      Object.fromEntries(
+        (space.data?.space.members ?? []).map((member) => [
+          member.user_id,
+          member.display_name,
+        ]),
+      ),
+    [space.data?.space.members],
+  );
+
+  const submit = () => {
+    const text = draft.trim();
+    if (!text || send.isLoading) {
+      return;
+    }
+    send.mutate(text);
+  };
+
+  if (space.isError || messages.isError) {
+    return (
+      <main className="flex min-h-0 flex-1 items-center justify-center bg-surface-primary p-6">
+        <div role="alert" className="max-w-md rounded-2xl border border-border-medium p-6">
