+import { Link, useParams } from 'react-router-dom';
+import { Button, Spinner } from '@librechat/client';
+import { lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function ReminderDetail() {
+  const { reminderId = '' } = useParams();
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const query = useQuery({
+    queryKey: ['life-reminder-detail', user?.id, reminderId],
+    queryFn: ({ signal }) => lifeService.reminder(reminderId, signal),
+    retry: false,
+  });
+  const cancel = useMutation(() => lifeService.cancelReminder(reminderId), {
+    onSuccess: () => void cache.invalidateQueries(),
+  });
+  const item = query.data?.reminder;
+  const format = (value: string) =>
+    new Intl.DateTimeFormat('zh-CN', {
+      dateStyle: 'full',
+      timeStyle: 'short',
+      timeZone: item?.timezone,
+    }).format(new Date(value));
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <article className="mx-auto max-w-3xl space-y-5 rounded-2xl border border-border-light bg-surface-primary-alt p-5">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/reminders">
+          {localize('com_life_reminders')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_view_reminder')}</h1>
+        {query.isLoading ? <Spinner /> : null}
+        {query.isError ? <p role="alert">{localize('com_life_entity_unavailable')}</p> : null}
+        {item ? (
+          <>
+            <h2 className="break-words text-xl">{item.title}</h2>
+            <p>
+              {localize('com_life_draft_remind_at')}：{format(item.scheduled_at)} · {item.timezone}
+            </p>
+            {item.source?.fields.event_date && item.source.fields.event_time ? (
+              <p>
+                {localize('com_life_draft_event_at')}：{item.source.fields.event_date}{' '}
+                {item.source.fields.event_time}
+              </p>
+            ) : null}
+            <p role="status">
+              {localize('com_life_entity_status')}：{item.status}
+            </p>
+            <p className="text-sm text-text-secondary">{localize('com_life_draft_delivery')}</p>
+            {item.source ? (
+              <Link
+                className="inline-flex min-h-11 items-center text-link underline"
+                to={`/c/${encodeURIComponent(item.source.conversation_id)}?message=${encodeURIComponent(item.source.source_message_id)}`}
+              >
+                {localize('com_life_open_chat')}
+              </Link>
+            ) : (
+              <p>{localize('com_life_source_unavailable')}</p>
+            )}
+            {item.status === 'scheduled' || item.status === 'due' ? (
+              <Button
+                className="min-h-11"
+                variant="outline"
+                disabled={cancel.isLoading}
+                onClick={() => cancel.mutate()}
+              >
+                {localize('com_life_reminder_cancel')}
+              </Button>
+            ) : null}
+          </>
+        ) : null}
+        {cancel.isError ? <p role="alert">{localize('com_life_reminder_error')}</p> : null}
+      </article>
+    </main>
+  );
+}
diff --git a/client/src/components/Life/Reminders.tsx b/client/src/components/Life/Reminders.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..a202969dcecddf70200aa745018374e19f8923d7
--- /dev/null
+++ b/client/src/components/Life/Reminders.tsx
@@ -0,0 +1,362 @@
+import { useMemo, useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Button, Spinner, Switch } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { CalendarClock, Check, Pencil, Plus, X } from 'lucide-react';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { LifeReminder } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+import Provisioning from './Provisioning';
+
+function toLocalInput(value?: string) {
+  const date = value ? new Date(value) : new Date(Date.now() + 60 * 60 * 1000);
+  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000);
+  return local.toISOString().slice(0, 16);
+}
+
+function toIso(value: string) {
+  return new Date(value).toISOString();
+}
+
+function formatDate(value: string, locale: string) {
+  return new Intl.DateTimeFormat(locale, {
+    dateStyle: 'medium',
+    timeStyle: 'short',
+  }).format(new Date(value));
+}
+
+function statusLabel(status: LifeReminder['status']) {
+  if (status === 'completed') {
+    return 'com_life_reminder_completed' as const;
+  }
+  if (status === 'due') {
+    return 'com_life_reminder_due' as const;
+  }
+  if (status === 'cancelled') {
+    return 'com_life_reminder_cancelled_status' as const;
+  }
+  return 'com_life_reminder_scheduled' as const;
+}
+
+export default function Reminders() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const locale = useMemo(() => navigator.language || 'zh-CN', []);
+  const [title, setTitle] = useState('');
+  const [scheduledAt, setScheduledAt] = useState(() => toLocalInput());
+  const [editing, setEditing] = useState<string | null>(null);
+  const [editTitle, setEditTitle] = useState('');
+  const [editTime, setEditTime] = useState('');
+  const [notice, setNotice] = useState('');
+
+  const permissions = useQuery({
+    queryKey: [QueryKeys.lifePermissions, user?.id],
+    queryFn: lifeService.permissions,
+    retry: false,
+  });
+  const consent = useMutation(lifeService.setPermissions, {
+    onSuccess: () => void cache.invalidateQueries([QueryKeys.lifePermissions, user?.id]),
+  });
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeReminders, user?.id],
+    queryFn: ({ signal }) => lifeService.reminders(signal),
+    refetchInterval: 30_000,
+    retry: false,
+  });
+  const notifications = useQuery({
+    queryKey: [QueryKeys.lifeReminderNotifications, user?.id],
+    queryFn: ({ signal }) => lifeService.reminderNotifications(signal),
+    enabled: Boolean(query.data?.configured && permissions.data?.notification_consent),
+    refetchInterval: 15_000,
+    retry: false,
+  });
+  const refresh = () => {
+    void cache.invalidateQueries([QueryKeys.lifeReminders, user?.id]);
+  };
+  const create = useMutation(lifeService.createReminder, {
+    onSuccess: () => {
+      setTitle('');
+      setScheduledAt(toLocalInput());
+      setNotice(localize('com_life_reminder_created'));
+      refresh();
+    },
+  });
+  const update = useMutation(
+    ({ id, value, at }: { id: string; value: string; at: string }) =>
+      lifeService.updateReminder(id, {
+        title: value,
+        scheduled_at: toIso(at),
+        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC',
+      }),
+    {
+      onSuccess: () => {
+        setEditing(null);
+        setNotice(localize('com_life_reminder_updated'));
+        refresh();
+      },
+    },
+  );
+  const cancel = useMutation(lifeService.cancelReminder, {
+    onSuccess: () => {
+      setNotice(localize('com_life_reminder_cancelled'));
+      refresh();
+    },
+  });
+  const complete = useMutation((id: string) => lifeService.updateReminder(id, { done: true }), {
+    onSuccess: () => {
+      setNotice(localize('com_life_reminder_completed'));
+      refresh();
+    },
+  });
+  const pending =
+    create.isLoading ||
+    update.isLoading ||
+    cancel.isLoading ||
+    consent.isLoading ||
+    complete.isLoading;
+  const failed =
+    query.isError ||
+    create.isError ||
+    update.isError ||
+    cancel.isError ||
+    consent.isError ||
+    permissions.isError ||
+    notifications.isError ||
+    complete.isError;
+
+  const beginEdit = (item: LifeReminder) => {
+    setEditing(item.reminder_id);
+    setEditTitle(item.title);
+    setEditTime(toLocalInput(item.scheduled_at));
+    setNotice('');
+  };
+
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-6">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/c/new">
+          {localize('com_life_chat')}
+        </Link>
+        <header className="flex items-start gap-4">
+          <span className="grid size-12 shrink-0 place-items-center rounded-2xl bg-surface-primary-alt text-accent-primary">
+            <CalendarClock aria-hidden="true" className="size-6" />
+          </span>
+          <div>
+            <h1 className="font-serif text-3xl">{localize('com_life_reminders')}</h1>
+            <p className="mt-2 leading-7 text-text-secondary">
+              {localize('com_life_reminder_intro')}
+            </p>
+          </div>
+        </header>
+        {permissions.data ? (
+          <label className="flex min-h-11 items-center justify-between gap-4">
+            <span>{localize('com_life_notification_consent')}</span>
+            <Switch
+              aria-label={localize('com_life_notification_consent')}
+              checked={permissions.data.notification_consent}
+              disabled={pending}
+              onCheckedChange={(value) => consent.mutate({ notification_consent: value })}
+            />
+          </label>
+        ) : null}
+        {query.isSuccess ? <Provisioning availability={query.data} /> : null}
+
+        <details>
+          <summary className="cursor-pointer py-3 text-link">
+            {localize('com_life_reminder_manual')}
+          </summary>
+          <form
+            className="grid gap-4 rounded-2xl border border-border-light bg-surface-primary-alt p-4 sm:grid-cols-[1fr_13rem_auto] sm:items-end"
+            onSubmit={(event) => {
+              event.preventDefault();
+              setNotice('');
+              create.mutate({
+                title: title.trim(),
+                scheduled_at: toIso(scheduledAt),
+                timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC',
+                delivery_channel: 'push',
+              });
+            }}
+          >
+            <label className="grid gap-2">
+              <span className="text-sm font-medium">{localize('com_life_reminder_title')}</span>
+              <input
+                autoComplete="off"
+                className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                maxLength={200}
+                onChange={(event) => setTitle(event.target.value)}
+                required
+                value={title}
+              />
+            </label>
+            <label className="grid gap-2">
+              <span className="text-sm font-medium">{localize('com_life_reminder_time')}</span>
+              <input
+                className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                onChange={(event) => setScheduledAt(event.target.value)}
+                required
+                type="datetime-local"
+                min={toLocalInput(new Date().toISOString())}
+                value={scheduledAt}
+              />
+            </label>
+            <Button
+              className="min-h-11"
+              disabled={
+                pending ||
+                !query.data?.configured ||
+                !permissions.data?.notification_consent ||
+                !title.trim() ||
+                !scheduledAt
+              }
+              type="submit"
+            >
+              <Plus aria-hidden="true" className="mr-2 size-4" />
+              {localize('com_life_reminder_add')}
+            </Button>
+          </form>
+        </details>
+
+        {notice ? <p role="status">{notice}</p> : null}
+        {failed ? (
+          <div className="space-y-2" role="alert">
+            <p>{localize('com_life_reminder_error')}</p>
+            {query.isError ? (
+              <Button onClick={() => void query.refetch()}>{localize('com_ui_retry')}</Button>
+            ) : null}
+          </div>
+        ) : null}
+        {query.isLoading ? <Spinner /> : null}
+        {notifications.data?.messages.length ? (
+          <section
+            aria-label={localize('com_life_notifications_received')}
+            aria-live="polite"
