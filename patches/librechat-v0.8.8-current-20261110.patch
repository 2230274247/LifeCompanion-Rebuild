+import { useEffect, useMemo, useRef, useState } from 'react';
+import { Button } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import type { LifeSharedMemoryMessage } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import {
+  ArrowLeft,
+  BookHeart,
+  HeartHandshake,
+  Image as ImageIcon,
+  ShieldCheck,
+  Sparkles,
+  UsersRound,
+} from 'lucide-react';
+import { Link, useParams } from 'react-router-dom';
+import { useAuthContext } from '~/hooks';
+import ParlorMemoryPanel from './ParlorMemoryPanel';
+
+function errorCode(error: unknown) {
+  const value = error as {
+    response?: { data?: { detail?: { code?: string } | string } };
+    message?: string;
+  };
+  const detail = value.response?.data?.detail;
+  return typeof detail === 'string'
+    ? detail
+    : detail?.code || value.message || 'REQUEST_FAILED';
+}
+
+export default function SharedMemory() {
+  const { sharedId = '' } = useParams();
+  const { user } = useAuthContext();
+  const cache = useQueryClient();
+  const [error, setError] = useState('');
+  const [agentPending, setAgentPending] = useState(false);
+  const [contribution, setContribution] = useState('');
+  const [parlorOpen, setParlorOpen] = useState(true);
+  const eventCursor = useRef(0);
+  const scopeKey = `shared:${sharedId}`;
+  const queryKey = useMemo(
+    () => [QueryKeys.lifeSharedMemory, user?.id, sharedId],
+    [sharedId, user?.id],
+  );
+
+  const me = useQuery({
+    queryKey: [QueryKeys.lifeCollaborationMe, user?.id],
+    queryFn: ({ signal }) => lifeService.collaborationMe(signal),
+    retry: false,
+  });
+  const detail = useQuery({
+    queryKey,
+    queryFn: ({ signal }) => lifeService.sharedMemory(sharedId, signal),
+    enabled: Boolean(sharedId),
+    retry: false,
+  });
+
+  useEffect(() => {
+    if (!sharedId) {
+      return;
+    }
+    let stopped = false;
+    const controller = new AbortController();
+    const run = async () => {
+      while (!stopped) {
+        try {
+          const result = await lifeService.waitCollaborationEvents(
+            scopeKey,
+            eventCursor.current,
+            15,
+            controller.signal,
+          );
+          if (result.events.length > 0) {
+            eventCursor.current = Math.max(
+              eventCursor.current,
+              ...result.events.map((event) => event.event_id),
+            );
+            await cache.invalidateQueries(queryKey);
+          }
+        } catch (requestError) {
+          if (controller.signal.aborted || stopped) {
+            break;
+          }
+          setError(`共同回忆实时连接暂时中断：${errorCode(requestError)}`);
+          await new Promise((resolve) => window.setTimeout(resolve, 1200));
+        }
+      }
+    };
+    void run();
+    return () => {
+      stopped = true;
+      controller.abort();
+      eventCursor.current = 0;
+    };
+  }, [cache, queryKey, scopeKey, sharedId]);
+
+  const addContribution = useMutation(
+    () => lifeService.addSharedMemoryContribution(sharedId, { content: contribution.trim() }),
+    {
+      onSuccess: async () => {
+        setContribution('');
+        setError('');
+        await cache.invalidateQueries(queryKey);
+      },
+      onError: (requestError) =>
+        setError(`补充未保存，内容已保留：${errorCode(requestError)}`),
+    },
+  );
+
+  const react = useMutation(
+    ({
+      messageId,
+      emoji,
+    }: {
+      messageId: string;
+      emoji: '❤️' | '👍' | '😂' | '✨' | '👀';
+    }) => lifeService.reactToSharedMemoryMessage(sharedId, messageId, emoji),
+    {
+      onSuccess: async () => {
+        setError('');
+        await cache.invalidateQueries(queryKey);
+      },
+      onError: (requestError) => setError(`回应未保存：${errorCode(requestError)}`),
+    },
+  );
+
+  const send = async (body: string) => {
+    setError('');
+    const aiQuery = body.match(/^@ai\s+([\s\S]+)$/i);
+    if (aiQuery) {
+      setAgentPending(true);
+      try {
+        await lifeService.agentSharedMemoryQuery(sharedId, {
+          query: aiQuery[1].trim(),
+        });
+      } finally {
+        setAgentPending(false);
+      }
+    } else {
+      await lifeService.sendSharedMemoryMessage(sharedId, {
+        body,
+        client_message_id: crypto.randomUUID(),
+      });
+    }
+    await cache.invalidateQueries(queryKey);
+  };
+
+  const memberNames = useMemo(
+    () =>
+      Object.fromEntries(
+        (detail.data?.members ?? []).map((member) => [
+          member.user_id,
+          member.display_name,
+        ]),
+      ),
+    [detail.data?.members],
+  );
+
+  if (detail.isLoading) {
+    return (
+      <main className="flex min-h-0 flex-1 items-center justify-center bg-surface-primary p-6">
+        <p role="status" className="text-sm text-text-secondary">
+          正在打开共同回忆…
+        </p>
+      </main>
+    );
+  }
+
+  if (detail.isError || !detail.data) {
+    return (
+      <main className="flex min-h-0 flex-1 items-center justify-center bg-surface-primary p-6">
+        <div role="alert" className="max-w-md rounded-2xl border border-border-medium p-6">
+          <h1 className="text-xl font-semibold">无法打开这段共同回忆</h1>
+          <p className="mt-2 text-sm leading-6 text-text-secondary">
+            它可能已被归档、你已不再是成员，或当前账号没有访问权限。
+          </p>
+          <Link className="mt-5 inline-flex min-h-11 items-center text-link underline" to="/connections">
+            返回亲友圈
+          </Link>
+        </div>
+      </main>
+    );
+  }
+
+  const shared = detail.data;
+  const messages: LifeSharedMemoryMessage[] = shared.messages.map((message) => ({
+    ...message,
+    sender_display_name:
+      memberNames[message.sender_id] || message.sender_display_name || '共同回忆成员',
+  }));
+
+  return (
+    <main className="min-h-0 flex-1 overflow-y-auto bg-surface-primary">
+      <div className="mx-auto w-full max-w-[1180px] px-4 py-6 sm:px-6 lg:px-8">
+        <section className="min-w-0">
+          <Link
+            to="/connections"
+            className="inline-flex min-h-11 items-center gap-2 text-sm text-link underline underline-offset-4"
+          >
+            <ArrowLeft className="size-4" aria-hidden="true" />
+            返回亲友圈
+          </Link>
+
+          <header className="mt-4 rounded-[1.75rem] border border-border-light bg-surface-primary-alt p-5 sm:p-6">
+            <p className="flex items-center gap-2 text-xs font-semibold tracking-[0.16em] text-text-secondary">
+              <BookHeart className="size-4" aria-hidden="true" />
+              SHARED MEMORY · {shared.role === 'owner' ? '发起人' : '成员'}
+            </p>
+            <h1 className="font-serif mt-3 break-words text-3xl leading-tight sm:text-4xl">
+              {shared.shared_memory.title}
+            </h1>
+            <div className="mt-4 flex flex-wrap gap-2 text-xs">
+              <span className="inline-flex items-center gap-1.5 rounded-full bg-surface-active px-3 py-1.5">
+                <UsersRound className="size-3.5" aria-hidden="true" />
+                {shared.members.length} 位成员
+              </span>
+              <span className="inline-flex items-center gap-1.5 rounded-full bg-surface-active px-3 py-1.5">
+                <Sparkles className="size-3.5" aria-hidden="true" />
+                {shared.contributions.length} 条补充
+              </span>
+            </div>
+            <p className="mt-4 flex items-start gap-2 rounded-xl border border-border-light bg-surface-primary p-3 text-xs leading-5 text-text-secondary">
+              <ShieldCheck className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
+              源回忆仍受个人权限保护。这里只显示你有权查看的来源快照，成员补充独立保存。
+            </p>
+          </header>
+
+          <section className="mt-5 rounded-2xl border border-border-light bg-surface-primary-alt p-5">
+            <h2 className="text-lg font-semibold">回忆来源</h2>
+            <div className="mt-3 space-y-3">
+              {shared.sources.map((source) => (
+                <article
+                  key={`${source.owner_user_id}:${source.source_kind}:${source.source_id}`}
+                  className="rounded-xl border border-border-light bg-surface-primary p-4"
+                >
+                  {source.image_data ? (
+                    <img
+                      src={source.image_data}
+                      alt=""
+                      className="mb-3 aspect-[16/9] w-full rounded-lg object-cover"
+                    />
+                  ) : (
+                    <ImageIcon className="mb-2 size-5 text-text-secondary" aria-hidden="true" />
+                  )}
+                  <h3 className="font-medium">{source.title}</h3>
+                  <p className="mt-1 whitespace-pre-wrap text-sm leading-6 text-text-secondary">
+                    {source.summary || '来源内容暂不可用。'}
+                  </p>
+                  {!source.available ? (
+                    <p className="mt-2 rounded-lg bg-surface-active px-3 py-2 text-xs">
+                      来源所有者当前不可用或已离开这段共同回忆。
+                    </p>
+                  ) : null}
+                </article>
+              ))}
+            </div>
+          </section>
+
+          <section className="mt-5 rounded-2xl border border-border-light bg-surface-primary-alt p-5">
+            <h2 className="text-lg font-semibold">成员补充</h2>
+            <form
+              className="mt-3"
+              onSubmit={(event) => {
+                event.preventDefault();
+                if (contribution.trim()) {
+                  addContribution.mutate();
+                }
+              }}
+            >
+              <label>
+                <span className="sr-only">补充共同回忆</span>
+                <textarea
+                  className="min-h-24 w-full resize-y rounded-xl border border-border-medium bg-surface-primary px-3 py-2 text-sm leading-6"
+                  maxLength={4000}
+                  value={contribution}
+                  placeholder="补充一个细节，不会修改原始回忆…"
+                  onChange={(event) => setContribution(event.target.value)}
+                />
+              </label>
+              <div className="mt-2 flex justify-end">
+                <Button
+                  type="submit"
+                  size="sm"
+                  disabled={!contribution.trim() || addContribution.isLoading}
+                >
+                  保存补充
+                </Button>
+              </div>
+            </form>
+            <div className="mt-4 space-y-3">
+              {shared.contributions.map((item) => (
+                <article key={item.contribution_id} className="rounded-xl bg-surface-primary p-3">
+                  <p className="text-xs font-medium text-text-secondary">
+                    {item.author_display_name}
+                  </p>
+                  <p className="mt-1 whitespace-pre-wrap text-sm leading-6">{item.content}</p>
+                </article>
+              ))}
+              {shared.contributions.length === 0 ? (
+                <p className="text-sm text-text-secondary">还没有额外补充。</p>
+              ) : null}
+            </div>
+          </section>
+        </section>
+      </div>
+
+      {parlorOpen ? (
+        <div
+          className="lc-parlor-float"
+          role="region"
+          aria-label={`${shared.shared_memory.title} 的共同回忆协作窗口`}
+        >
+          <ParlorMemoryPanel
+            title={shared.shared_memory.title}
+            members={shared.members}
+            currentUserId={me.data?.profile.user_id}
+            messages={messages}
+            pending={agentPending}
+            error={error}
+            onClose={() => setParlorOpen(false)}
+            onSend={send}
+            onReact={async (messageId, emoji) => {
+              await react.mutateAsync({ messageId, emoji });
+            }}
+          />
+        </div>
+      ) : (
+        <button
+          type="button"
+          className="lc-parlor__invite-button lc-parlor-float-toggle"
+          onClick={() => setParlorOpen(true)}
+        >
+          <HeartHandshake size={16} aria-hidden="true" />
+          打开共同回忆（{shared.members.length} 位成员）
+        </button>
+      )}
+    </main>
+  );
+}
