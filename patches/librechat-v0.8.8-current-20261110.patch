+          </p>
+          <Link className="mt-5 inline-flex min-h-11 items-center text-link underline" to="/connections">
+            返回亲友圈
+          </Link>
+        </div>
+      </main>
+    );
+  }
+
+  return (
+    <main className="min-h-0 flex-1 overflow-y-auto bg-surface-primary">
+      <div className="mx-auto grid w-full max-w-[1400px] gap-5 px-3 py-5 sm:px-6 lg:grid-cols-[minmax(0,1fr)_280px] lg:px-8">
+        <section className="life-space-chat flex min-h-[calc(100dvh-10rem)] flex-col overflow-hidden rounded-[1.5rem] border border-border-light bg-surface-primary-alt">
+          <header className="border-b border-border-light bg-surface-primary-alt px-4 py-4 sm:px-5">
+            <div className="flex flex-wrap items-center gap-3">
+              <Link
+                to="/connections"
+                aria-label="返回亲友圈"
+                className="grid size-11 place-items-center rounded-xl border border-border-light bg-surface-primary text-text-primary hover:bg-surface-hover"
+              >
+                <ArrowLeft className="size-5" aria-hidden="true" />
+              </Link>
+              <div className="min-w-0 flex-1">
+                <p className="text-xs font-semibold tracking-[0.16em] text-text-secondary">
+                  SHARED SPACE · {space.data?.space.kind ?? 'team'}
+                </p>
+                <h1 className="truncate text-xl font-semibold">
+                  {space.data?.space.title ?? '共享空间'}
+                </h1>
+              </div>
+              <span className="inline-flex items-center gap-2 rounded-full bg-surface-active px-3 py-1.5 text-xs">
+                <UsersRound className="size-4" aria-hidden="true" />
+                {space.data?.space.members?.length ?? 0} 位成员
+              </span>
+            </div>
+            <p className="mt-3 flex items-center gap-2 text-xs leading-5 text-text-secondary">
+              <ShieldCheck className="size-4 shrink-0" aria-hidden="true" />
+              消息先保存再同步。@AI 的回答只向你展示，并只使用你有权访问的空间材料。
+            </p>
+          </header>
+
+          <div className="min-h-[440px] flex-1">
+            <MainContainer>
+              <ChatContainer>
+                <MessageList
+                  typingIndicator={
+                    aiPending ? <TypingIndicator content="拾光 AI 正在核对授权…" /> : null
+                  }
+                  autoScrollToBottom
+                  scrollBehavior="smooth"
+                >
+                  {(messages.data?.messages ?? []).map((item) => {
+                    const outgoing = item.sender_id === me.data?.profile.user_id;
+                    const sender =
+                      item.sender_kind === 'ai'
+                        ? '拾光 AI'
+                        : memberNames[item.sender_id] || '空间成员';
+                    return (
+                      <Message
+                        key={item.message_id}
+                        model={{
+                          message: item.deleted ? '这条消息已被发送者删除。' : item.body,
+                          sentTime: messageTime(item.created_at),
+                          sender,
+                          direction: outgoing ? 'outgoing' : 'incoming',
+                          position: 'single',
+                        }}
+                        avatarPosition={outgoing ? 'top-right' : 'top-left'}
+                      >
+                        <Message.Footer sentTime={messageTime(item.created_at)} sender={sender} />
+                      </Message>
+                    );
+                  })}
+                </MessageList>
+              </ChatContainer>
+            </MainContainer>
+          </div>
+
+          {error ? (
+            <div role="alert" className="border-t border-border-light bg-surface-active px-4 py-2 text-sm">
+              {error}
+            </div>
+          ) : null}
+          <form
+            className="border-t border-border-light bg-surface-primary p-3 sm:p-4"
+            onSubmit={(event) => {
+              event.preventDefault();
+              submit();
+            }}
+          >
+            <div className="flex items-end gap-2">
+              <label className="min-w-0 flex-1">
+                <span className="sr-only">消息内容</span>
+                <textarea
+                  className="min-h-12 w-full resize-none rounded-xl border border-border-medium bg-surface-primary-alt px-3 py-3 text-sm leading-6 text-text-primary"
+                  rows={1}
+                  maxLength={4000}
+                  value={draft}
+                  placeholder="输入消息，或输入 @AI 提问…"
+                  onChange={(event) => setDraft(event.target.value)}
+                  onKeyDown={(event) => {
+                    if (event.key === 'Enter' && !event.shiftKey) {
+                      event.preventDefault();
+                      submit();
+                    }
+                  }}
+                />
+              </label>
+              <Button
+                type="submit"
+                className="min-h-12 px-4"
+                disabled={!draft.trim() || send.isLoading || aiPending}
+              >
+                <Send className="size-4" aria-hidden="true" />
+                发送
+              </Button>
+            </div>
+          </form>
+        </section>
+
+        <aside className="space-y-4">
+          <section className="rounded-2xl border border-border-light bg-surface-primary-alt p-4">
+            <h2 className="text-sm font-semibold">成员</h2>
+            <ul className="mt-3 space-y-2">
+              {(space.data?.space.members ?? []).map((member) => (
+                <li
+                  key={member.user_id}
+                  className="flex items-center justify-between gap-2 rounded-lg border border-border-light bg-surface-primary px-3 py-2 text-sm"
+                >
+                  <span className="truncate">{member.display_name}</span>
+                  <span className="text-xs text-text-secondary">{member.role}</span>
+                </li>
+              ))}
+            </ul>
+          </section>
+          <section className="rounded-2xl border border-border-light bg-surface-primary-alt p-4">
+            <h2 className="flex items-center gap-2 text-sm font-semibold">
+              <Bot className="size-4" aria-hidden="true" />
+              Team Agent
+            </h2>
+            <p className="mt-2 text-xs leading-6 text-text-secondary">
+              输入 <code>@AI 小满什么时候方便接电话？</code>
+              时，服务端先检查对应空闲时间授权，再决定是否提供工具结果。
+            </p>
+            <Button
+              className="mt-3 w-full"
+              size="sm"
+              variant="outline"
+              disabled={!space.data?.space.members?.length}
+              onClick={() => setDraft('@AI 请根据已授权材料，整理最近一次共同活动。')}
+            >
+              使用 Agent 整理
+            </Button>
+          </section>
+          <section className="rounded-2xl border border-border-light bg-surface-primary-alt p-4 text-xs leading-6 text-text-secondary">
+            退出空间后，服务端会拒绝后续历史读取和实时订阅。刷新页面不会恢复已失效的房间权限。
+          </section>
+        </aside>
+      </div>
+    </main>
+  );
+}
