+++ b/client/src/components/Life/MemoryStatus.tsx
@@ -0,0 +1,67 @@
+import { Button } from '@librechat/client';
+import { useQuery } from '@tanstack/react-query';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+const statusKeys = {
+  queued: 'com_life_pipeline_queued', saved: 'com_life_pipeline_saved',
+  rejected: 'com_life_pipeline_rejected', failed: 'com_life_pipeline_failed',
+  retrying: 'com_life_pipeline_retrying', matched: 'com_life_pipeline_matched',
+  no_match: 'com_life_pipeline_no_match', permission_denied: 'com_life_pipeline_permission',
+  injected: 'com_life_pipeline_injected', unavailable: 'com_life_pipeline_unavailable',
+  excluded: 'com_life_pipeline_excluded', expired: 'com_life_pipeline_expired',
+  disabled: 'com_life_pipeline_disabled', empty_input: 'com_life_pipeline_empty',
+  not_attempted: 'com_life_pipeline_not_attempted',
+  published: 'com_life_pipeline_published',
+  user_not_mapped: 'com_life_pipeline_user_not_mapped',
+} as const;
+
+const stageKeys = {
+  enqueue: 'com_life_pipeline_stage_enqueue',
+  extraction: 'com_life_pipeline_stage_extraction',
+  recall: 'com_life_pipeline_stage_recall',
+  delivery: 'com_life_pipeline_stage_delivery',
+  publication: 'com_life_pipeline_stage_publication',
+} as const;
+
+export default function MemoryStatus() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const status = useQuery({
+    queryKey: [QueryKeys.lifeMemoryStatus, user?.id],
+    queryFn: lifeService.memoryStatus,
+    enabled: Boolean(user?.id),
+    retry: false,
+  });
+  return (
+    <section aria-label={localize('com_life_pipeline_title')} className="space-y-3 rounded-2xl border border-border-light p-5">
+      <div className="flex items-center justify-between gap-3">
+        <h2 className="text-lg font-semibold">{localize('com_life_pipeline_title')}</h2>
+        <Button variant="outline" disabled={status.isFetching} onClick={() => void status.refetch()}>
+          {localize('com_life_pipeline_refresh')}
+        </Button>
+      </div>
+      <p className="text-sm text-text-secondary">{localize('com_life_pipeline_notice')}</p>
+      {status.isLoading ? <p role="status">{localize('com_life_pipeline_loading')}</p> : null}
+      {status.isError ? <p role="alert">{localize('com_life_pipeline_unavailable')}</p> : null}
+      {status.data ? (
+        <>
+          <p>{localize(status.data.permissions.recall_consent ? 'com_life_pipeline_recall_on' : 'com_life_pipeline_recall_off')}</p>
+          {status.data.traces.length === 0 ? <p>{localize('com_life_pipeline_no_records')}</p> : null}
+          <ol className="space-y-2">
+            {status.data.traces.slice(0, 8).map((trace) => (
+              <li key={trace.trace_id} className="flex flex-wrap justify-between gap-2 border-t border-border-light pt-2 text-sm">
+                <span>
+                  {localize(stageKeys[trace.stage as keyof typeof stageKeys] ?? 'com_life_pipeline_title')}
+                  {' · '}
+                  {localize(statusKeys[trace.status as keyof typeof statusKeys] ?? 'com_life_pipeline_not_attempted')}
+                </span>
+                <time dateTime={trace.created_at} className="text-text-secondary">{new Date(trace.created_at).toLocaleString()}</time>
+              </li>
+            ))}
+          </ol>
+        </>
+      ) : null}
+    </section>
+  );
+}
diff --git a/client/src/components/Life/MomentSettings.tsx b/client/src/components/Life/MomentSettings.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..f5b52401d805c5b6fc5ad06d31b443c8a863c7ad
--- /dev/null
+++ b/client/src/components/Life/MomentSettings.tsx
@@ -0,0 +1,132 @@
+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Button, Spinner, Switch } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import type { LifeMomentSettings } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function MomentSettings() {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const [edited, setEdited] = useState<LifeMomentSettings>();
+  const query = useQuery({
+    queryKey: [QueryKeys.lifeMomentSettings, user?.id],
+    queryFn: lifeService.momentSettings,
+    retry: false,
+  });
+  const permissions = useQuery({
+    queryKey: [QueryKeys.lifePermissions, user?.id],
+    queryFn: lifeService.permissions,
+    retry: false,
+  });
+  const settings = edited ?? query.data;
+  const refresh = () => void cache.invalidateQueries([QueryKeys.lifePermissions, user?.id]);
+  const consent = useMutation(lifeService.setPermissions, { onSuccess: refresh });
+  const save = useMutation(lifeService.saveMomentSettings, {
+    onSuccess: (value) => {
+      setEdited(undefined);
+      cache.setQueryData([QueryKeys.lifeMomentSettings, user?.id], value);
+    },
+  });
+  const pending = consent.isLoading || save.isLoading;
+  return (
+    <main className="flex-1 overflow-y-auto bg-presentation px-4 py-8 text-text-primary sm:px-8">
+      <div className="mx-auto max-w-3xl space-y-5">
+        <Link className="inline-flex min-h-11 items-center text-link underline" to="/memories">
+          {localize('com_life_back')}
+        </Link>
+        <h1 className="font-serif text-3xl">{localize('com_life_moment_settings')}</h1>
+        <p className="leading-8">{localize('com_life_moment_consent_notice')}</p>
+        {query.isLoading || permissions.isLoading ? <Spinner /> : null}
+        {query.isError || permissions.isError ? (
+          <p role="alert">{localize('com_life_error')}</p>
+        ) : null}
+        {permissions.data
+          ? (
+              [
+                ['memory_consent', 'com_life_auto_memory'],
+                ['image_consent', 'com_life_image_consent'],
+              ] as const
+            ).map(([key, label]) => (
+              <label key={key} className="flex min-h-11 items-center justify-between gap-3">
+                <span>{localize(label)}</span>
+                <Switch
+                  aria-label={localize(label)}
+                  checked={permissions.data[key]}
+                  disabled={pending}
+                  onCheckedChange={(value) => consent.mutate({ [key]: value })}
+                />
+              </label>
+            ))
+          : null}
+        {settings ? (
+          <form
+            className="space-y-5 rounded-2xl border border-border-light bg-surface-primary-alt p-5"
+            onSubmit={(event) => {
+              event.preventDefault();
+              save.mutate(settings);
+            }}
+          >
+            <label className="flex min-h-11 items-center justify-between gap-3">
+              {localize('com_life_automatic_moments')}
+              <Switch
+                aria-label={localize('com_life_automatic_moments')}
+                checked={settings.enabled}
+                disabled={pending}
+                onCheckedChange={(value) => setEdited({ ...settings, enabled: value })}
+              />
+            </label>
+            <p className="leading-7">{localize('com_life_moment_windows_notice')}</p>
+            <label className="grid gap-2">
+              {localize('com_life_draft_timezone')}
+              <input
+                className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                value={settings.timezone}
+                required
+                onChange={(event) => setEdited({ ...settings, timezone: event.target.value })}
+              />
+            </label>
+            <div className="grid gap-3 sm:grid-cols-3">
+              {settings.ends.map((end, index) => (
+                <label className="grid gap-2" key={index}>
+                  {localize(
+                    index === 0
+                      ? 'com_life_morning'
+                      : index === 1
+                        ? 'com_life_noon'
+                        : 'com_life_evening',
+                  )}
+                  <input
+                    type="time"
+                    className="min-h-11 rounded-lg border border-border-medium bg-surface-primary px-3"
+                    value={end}
+                    required
+                    onChange={(event) =>
+                      setEdited({
+                        ...settings,
+                        ends: settings.ends.map((value, i) =>
+                          i === index ? event.target.value : value,
+                        ),
+                      })
+                    }
+                  />
+                </label>
+              ))}
+            </div>
+            <Button type="submit" disabled={pending}>
+              {localize('com_ui_save')}
+            </Button>
+            {save.isSuccess && !edited ? (
+              <p role="status">{localize('com_life_moment_settings_saved')}</p>
+            ) : null}
+          </form>
+        ) : null}
+        {save.isError || consent.isError ? (
+          <p role="alert">{localize('com_life_moment_settings_error')}</p>
+        ) : null}
+      </div>
+    </main>
+  );
+}
diff --git a/client/src/components/Life/Moments.tsx b/client/src/components/Life/Moments.tsx
