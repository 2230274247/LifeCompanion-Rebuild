diff --git a/packages/api/src/memory/life.spec.ts b/packages/api/src/memory/life.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5eaf31dc7177fde99f6c361376685c57989c38f4
--- /dev/null
+++ b/packages/api/src/memory/life.spec.ts
@@ -0,0 +1,655 @@
+import { logger } from '@librechat/data-schemas';
+import { queueLifeMemory, withLifeMemory, withLifeReminder } from './life';
+
+jest.mock('@librechat/data-schemas', () => ({
+  logger: { info: jest.fn() },
+}));
+
+describe('Life Companion memory boundary', () => {
+  const connection = { endpoint: 'http://life.invalid', token: 'server-only', userId: 'alice' };
+  const response = (body: object, status = 200) =>
+    ({ ok: status >= 200 && status < 300, status, json: async () => body }) as Response;
+  const current = {
+    text: '今天想喝茶',
+    isCreatedByUser: true,
+    messageId: 'u1',
+    conversationId: 'c1',
+  };
+  const matched = {
+    status: 'matched',
+    items: [
+      { memory_id: 'tea', text: '喜欢喝龙井茶', valid_from: '2026-11-01', url: '/knowledge/tea' },
+    ],
+    profile: [],
+  };
+  function mockRecall(body: object = matched) {
+    return jest
+      .spyOn(global, 'fetch')
+      .mockImplementation(async (url) =>
+        String(url).endsWith('/memory/telemetry') ? response({}, 204) : response(body),
+      );
+  }
+  const planned = {
+    status: 'planned',
+    tasks: [{ action: 'search_memory', query: '今天想喝茶' }],
+  };
+  const executed = {
+    status: 'executed',
+    results: [{ action: 'search_memory', status: 'matched', items: matched.items }],
+  };
+  function mockPlanner(executeBody: object = executed) {
+    return jest.spyOn(global, 'fetch').mockImplementation(async (url) => {
+      const path = String(url);
+      if (path.endsWith('/memory/telemetry')) return response({}, 204);
+      if (path.endsWith('/assistant/plan')) return response(planned);
+      if (path.endsWith('/assistant/execute')) return response(executeBody);
+      return response(executeBody);
+    });
+  }
+  function mockPlannerUnavailable(body: object = matched) {
+    return jest.spyOn(global, 'fetch').mockImplementation(async (url) => {
+      const path = String(url);
+      if (path.endsWith('/memory/telemetry')) return response({}, 204);
+      if (path.endsWith('/assistant/plan'))
+        return response({ status: 'planner_unavailable', tasks: [] });
+      return response(body);
+    });
+  }
+  function requestBody(request: jest.SpiedFunction<typeof fetch>, suffix: string) {
+    const call = request.mock.calls.find(([url]) => String(url).endsWith(suffix));
+    expect(call).toBeDefined();
+    return JSON.parse(String(call?.[1]?.body));
+  }
+  afterEach(() => {
+    jest.restoreAllMocks();
+    jest.clearAllMocks();
+    jest.useRealTimers();
+  });
+
+  it('keeps event occurrence ranges separate from recording time in model evidence', async () => {
+    mockPlanner({
+      status: 'executed',
+      results: [
+        {
+          action: 'overview',
+          status: 'matched',
+          items: [
+            {
+              memory_id: 'month',
+              text: '上个月搬家',
+              kind: 'life_event',
+              valid_from: '2026-11-02T10:00:00+08:00',
+              occurrence_start: '2026-10-01',
+              occurrence_end: '2026-10-31',
+              occurrence_precision: 'month',
+            },
+            {
+              memory_id: 'unknown',
+              text: '参加了陶艺展览',
+              kind: 'life_event',
+              valid_from: '2026-11-02T10:00:00+08:00',
+            },
+          ],
+        },
+      ],
+    });
+    const output = await withLifeMemory([{ ...current }], connection, current.text);
+    expect(output[0].text).toContain('"recorded_at":"2026-11-02T10:00:00+08:00"');
+    expect(output[0].text).toContain('"occurrence_precision":"month"');
+    expect(output[0].text).toContain('"occurrence_precision":"unknown"');
+    expect(output[0].text).not.toContain('"since"');
+    expect(output[0].text).toContain('never infer occurrence from recording time');
+  });
+
+  it('recalls a nonempty turn through the planner and reports actual injection', async () => {
+    const request = mockPlanner();
+    const messages = [{ ...current }];
+    const output = await withLifeMemory(messages, connection, current.text);
+    expect(messages[0].text).toBe(current.text);
+    expect(output[0].text).toContain('喜欢喝龙井茶');
+    expect(output[0].text).toContain('untrusted evidence');
+    expect(output[0].text).toContain('/knowledge/tea');
+    expect(output[0].text).not.toContain('server-only');
+    expect(requestBody(request, '/assistant/plan')).toEqual({
+      source_user_id: 'alice',
+      query: current.text,
+      conversation_id: 'c1',
+      source_message_id: 'u1',
+      recent_messages: [],
+    });
+    expect(requestBody(request, '/assistant/execute').query).toBe(current.text);
+    expect(requestBody(request, '/memory/telemetry')).toEqual({
+      source_user_id: 'alice',
+      source_message_id: 'u1',
+      conversation_id: 'c1',
+      stage: 'delivery',
+      status: 'injected',
+      item_count: 1,
+      elapsed_ms: expect.any(Number),
+    });
+    expect(logger.info).toHaveBeenCalledWith('[life-memory]', {
+      stage: 'recall',
+      status: 'injected',
+      item_count: 1,
+      reason: undefined,
+    });
+  });
+
+  it('runs semantic forgetting only after the current user message is durable', async () => {
+    const request = jest
+      .spyOn(global, 'fetch')
+      .mockImplementation(async (url) =>
+        String(url).endsWith('/assistant/plan')
+          ? response({ status: 'planned', tasks: [{ action: 'forget_memory' }] })
+          : response({ status: 'forgotten', item_count: 2, cleanup: 'complete' }),
+      );
+    const operations: { forgetRequested?: boolean } = {};
+    const message = { ...current, text: '请清除我的居住资料' };
+    await withLifeMemory([message], connection, message.text, operations);
+    expect(operations.forgetRequested).toBe(true);
+    expect(request).toHaveBeenCalledTimes(1);
+    let resolve: (value: object) => void = () => {};
+    const durable = new Promise<object>((done) => {
+      resolve = done;
+    });
+    const pending = withLifeReminder(
+      [{ role: 'user', content: message.text }],
+      connection,
