+import { useEffect, useState } from 'react';
+import { ImageOff } from 'lucide-react';
+import { Link, useLocation } from 'react-router-dom';
+import { motion, useReducedMotion } from 'framer-motion';
+import type { LifeMemory } from 'librechat-data-provider';
+import { occurrenceDay, occurrenceLabel } from './occurrence';
+import { useLocalize } from '~/hooks';
+
+export default function MemoryCard({ memory, index = 0 }: { memory: LifeMemory; index?: number }) {
+  const localize = useLocalize();
+  const location = useLocation();
+  const reduceMotion = useReducedMotion();
+  const [imageFailed, setImageFailed] = useState(false);
+  const image = memory.media?.thumbnail_data;
+
+  useEffect(() => {
+    setImageFailed(false);
+  }, [image]);
+
+  return (
+    <motion.article
+      initial={reduceMotion ? false : { opacity: 0, y: 12 }}
+      animate={reduceMotion ? undefined : { opacity: 1, y: 0 }}
+      transition={{ duration: 0.24, delay: Math.min(index * 0.04, 0.2) }}
+      className="min-w-0"
+    >
+      <Link
+        to={`/memories/${encodeURIComponent(memory.event_id)}${location.search}`}
+        className="group flex h-full min-h-11 flex-col overflow-hidden rounded-[1.4rem] border border-border-light bg-surface-primary-alt text-text-primary no-underline shadow-sm transition-[border-color,box-shadow,transform] hover:-translate-y-0.5 hover:border-border-heavy hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring-primary motion-reduce:transform-none motion-reduce:transition-none"
+        aria-label={`${memory.title} · ${localize('com_life_read')}`}
+      >
+        <div className="relative aspect-[4/3] overflow-hidden bg-surface-secondary">
+          {image && !imageFailed ? (
+            <img
+              src={image}
+              alt={memory.media?.disclaimer ?? localize('com_life_ai_moment')}
+              loading="lazy"
+              decoding="async"
+              width={memory.media?.width ?? undefined}
+              height={memory.media?.height ?? undefined}
+              onError={() => setImageFailed(true)}
+              className="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transform-none motion-reduce:transition-none"
