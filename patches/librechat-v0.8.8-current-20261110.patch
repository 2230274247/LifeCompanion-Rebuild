diff --git a/e2e/v03-browser-acceptance.cjs b/e2e/v03-browser-acceptance.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..2547687c80c62001754516fc3a741f04df542067
--- /dev/null
+++ b/e2e/v03-browser-acceptance.cjs
@@ -0,0 +1,115 @@
+/* Browser-level V0.3 acceptance: three isolated incognito contexts. */
+const { chromium } = require('@playwright/test');
+const fs = require('fs');
+const path = require('path');
+
+const root = path.resolve(__dirname, '..', '..', '..');
+const base = 'http://127.0.0.1:3001';
+const accounts = JSON.parse(
+  fs.readFileSync(path.join(root, 'infra/runtime/v03-acceptance/accounts.json'), 'utf8'),
+);
+const ids = JSON.parse(
+  fs.readFileSync(path.join(root, 'evidence/v03-acceptance/collaboration-ids.json'), 'utf8'),
+);
+const outDir = path.join(root, 'evidence/v03-acceptance/browser');
+fs.mkdirSync(outDir, { recursive: true });
+
+const results = [];
+
+function record(name, ok, detail = '') {
+  results.push({ step: name, pass: ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'} | ${name}${detail ? ` | ${detail}` : ''}`);
+}
+
+async function login(page, account) {
+  await page.goto(`${base}/login`, { waitUntil: 'domcontentloaded' });
+  await page.locator('#email').waitFor({ timeout: 20000 });
+  await page.locator('#email').fill(account.email);
+  await page.locator('#password').fill(account.password);
+  await page.locator('[data-testid="login-button"]').click();
+  await page.waitForURL((url) => !url.pathname.startsWith('/login'), { timeout: 30000 });
+}
+
+(async () => {
+  const browser = await chromium.launch({ headless: true });
+  try {
+    // A: own memory detail shows the Parlor companion next to the private memory.
+    const ctxA = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+    const pageA = await ctxA.newPage();
+    await login(pageA, accounts.a);
+    await pageA.goto(`${base}/memories/${encodeURIComponent(ids.memory_event_id)}`, {
+      waitUntil: 'domcontentloaded',
+    });
+    await pageA.getByText('一起看银杏', { exact: false }).first().waitFor({ timeout: 20000 });
+    await pageA.locator('.lc-parlor').first().waitFor({ state: 'attached', timeout: 20000 });
+    const parlorA = await pageA.locator('.lc-parlor').count();
+    record('A 的回忆详情右侧出现 Parlor 小窗', parlorA > 0, `parlor=${parlorA}`);
+    await pageA.screenshot({ path: path.join(outDir, 'a-memory-detail-desktop.png'), fullPage: true });
+    await ctxA.close();
+
+    // B: shared memory detail opens with the Parlor discussion panel.
+    const ctxB = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+    const pageB = await ctxB.newPage();
+    await login(pageB, accounts.b);
+    await pageB.goto(`${base}/shared-memories/${encodeURIComponent(ids.shared_id)}`, {
+      waitUntil: 'domcontentloaded',
+    });
+    await pageB.getByText('一起看银杏', { exact: false }).first().waitFor({ timeout: 20000 });
+    await pageB.locator('.lc-parlor').first().waitFor({ state: 'attached', timeout: 20000 });
+    const parlorB = await pageB.locator('.lc-parlor').count();
+    record('B 的共同回忆页渲染 Parlor 讨论窗', parlorB > 0, `parlor=${parlorB}`);
+    await pageB.screenshot({ path: path.join(outDir, 'b-shared-memory-desktop.png'), fullPage: true });
+    await ctxB.close();
+
+    // C: no membership, so the shared memory is blocked server-side.
+    const ctxC = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+    const pageC = await ctxC.newPage();
+    await login(pageC, accounts.c);
+    await pageC.goto(`${base}/shared-memories/${encodeURIComponent(ids.shared_id)}`, {
+      waitUntil: 'domcontentloaded',
+    });
+    await pageC.getByText('无法打开', { exact: false }).first().waitFor({ timeout: 20000 });
+    const parlorC = await pageC.locator('.lc-parlor').count();
+    record('越权账户 C 被服务端阻止且无 Parlor 内容', parlorC === 0, `parlor=${parlorC}`);
+    await pageC.screenshot({ path: path.join(outDir, 'c-forbidden-shared-memory.png'), fullPage: true });
+    await ctxC.close();
+
+    // A on mobile: Parlor is a bottom sheet, not an always-visible right column.
+    const ctxM = await browser.newContext({ viewport: { width: 390, height: 844 } });
+    const pageM = await ctxM.newPage();
+    await login(pageM, accounts.a);
+    await pageM.goto(`${base}/memories/${encodeURIComponent(ids.memory_event_id)}`, {
+      waitUntil: 'domcontentloaded',
+    });
+    await pageM.getByText('一起看银杏', { exact: false }).first().waitFor({ timeout: 20000 });
+    await pageM.screenshot({ path: path.join(outDir, 'a-memory-detail-mobile.png'), fullPage: true });
+    const openButton = pageM.getByRole('button', { name: /^打开共同回忆/ });
+    if (await openButton.count()) {
+      await openButton.first().click();
+      await pageM.locator('.lc-parlor').first().waitFor({ state: 'attached', timeout: 10000 });
+      await pageM.waitForTimeout(700);
+      await pageM.screenshot({ path: path.join(outDir, 'a-parlor-mobile-sheet.png'), fullPage: true });
+      record('手机端 Parlor 以底部抽屉打开', (await pageM.locator('.lc-parlor').count()) > 0);
+    } else {
+      record('手机端 Parlor 以底部抽屉打开', false, 'no open button found');
+    }
+    await ctxM.close();
+  } finally {
+    await browser.close();
+  }
+
+  const summary = {
+    checked_at: new Date().toISOString(),
+    total: results.length,
+    passed: results.filter((r) => r.pass).length,
+    failed: results.filter((r) => !r.pass).length,
+    results,
+  };
+  fs.writeFileSync(
+    path.join(outDir, 'summary.json'),
+    JSON.stringify(summary, null, 2),
+    'utf8',
+  );
+  console.log(`\nSUMMARY: ${summary.passed}/${summary.total} passed`);
+  process.exit(summary.failed ? 1 : 0);
+})();
diff --git a/e2e/v03-browser-fullflow.cjs b/e2e/v03-browser-fullflow.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..1e5b830de1584e2be93377240328a0359dee7c28
--- /dev/null
+++ b/e2e/v03-browser-fullflow.cjs
@@ -0,0 +1,340 @@
+/* V0.3 browser acceptance: three isolated incognito contexts drive the full
+   collaboration loop through real UI interactions. No mocks; every step hits
+   the live gateway, life-core, Memos and model APIs. */
+const { chromium } = require('@playwright/test');
+const fs = require('fs');
+const path = require('path');
+const crypto = require('crypto');
+
+const root = path.resolve(__dirname, '..', '..', '..');
+const base = 'http://127.0.0.1:3001';
+const accounts = JSON.parse(
+  fs.readFileSync(path.join(root, 'infra/runtime/v03-browser/accounts.json'), 'utf8'),
+);
+const ids = JSON.parse(
+  fs.readFileSync(path.join(root, 'infra/runtime/v03-browser/ids.json'), 'utf8'),
+);
+const outDir = path.join(root, 'evidence/v03-acceptance/browser-fullflow');
+fs.mkdirSync(outDir, { recursive: true });
+
+const results = [];
+
+function record(name, ok, detail = '') {
+  results.push({ step: name, pass: ok, detail });
+  console.log(`${ok ? 'PASS' : 'FAIL'} | ${name}${detail ? ` | ${detail}` : ''}`);
+}
+
+function loadEnv() {
+  const env = {};
+  for (const file of [path.join(root, 'infra/.env'), path.join(root, 'products/librechat-custom/.env')]) {
+    for (const line of fs.readFileSync(file, 'utf8').split(/\r?\n/)) {
+      if (line && !line.startsWith('#') && line.includes('=')) {
+        const idx = line.indexOf('=');
+        env[line.slice(0, idx).trim()] = line.slice(idx + 1).trim();
+      }
+    }
+  }
+  return env;
+}
+
+function mintToken(librechatUserId, secret) {
+  const b64 = (obj) => Buffer.from(JSON.stringify(obj)).toString('base64url');
+  const signing = `${b64({ alg: 'HS256', typ: 'JWT' })}.${b64({ id: librechatUserId, exp: Math.floor(Date.now() / 1000) + 1800 })}`;
+  return `${signing}.${crypto.createHmac('sha256', secret).update(signing).digest('base64url')}`;
+}
+
+async function login(page, account) {
+  for (let attempt = 1; attempt <= 3; attempt += 1) {
+    try {
+      await page.goto(`${base}/login`, { waitUntil: 'domcontentloaded', timeout: 60000 });
+      await page.locator('#email').waitFor({ timeout: 30000 });
+      break;
+    } catch (err) {
+      if (attempt === 3) throw err;
+      await page.waitForTimeout(3000);
+    }
+  }
+  await page.locator('#email').fill(account.email);
+  await page.locator('#password').fill(account.password);
+  await page.locator('[data-testid="login-button"]').click();
+  await page.waitForURL((url) => !url.pathname.startsWith('/login'), { timeout: 30000 });
+}
+
+async function openConnections(page) {
+  await page.goto(`${base}/connections`, { waitUntil: 'domcontentloaded' });
+  await page.getByRole('tab', { name: '亲友圈' }).waitFor({ timeout: 30000 });
+}
+
+async function tab(page, name) {
+  await page.getByRole('tab', { name }).click();
+}
+
+(async () => {
+  const browser = await chromium.launch({ headless: true });
+  try {
+    const ctxD = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+    const ctxE = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+    const ctxF = await browser.newContext({ viewport: { width: 1440, height: 900 } });
+    const d = await ctxD.newPage();
+    const e = await ctxE.newPage();
+    const f = await ctxF.newPage();
+
+    try {
+      await login(d, accounts.d);
+      await login(e, accounts.e);
+      await login(f, accounts.f);
+      record('三个独立浏览器账户登录成功', true, 'd/e/f 三个 incognito Context');
+
+      // D searches E by display name and sends a friend request.
+      await openConnections(d);
+      await d.getByPlaceholder('显示名或认证 ID').fill('拾光验收·奶奶');
+      await d.getByRole('button', { name: '搜索' }).click();
+      const sendRequest = d.getByRole('button', { name: '发送申请' }).first();
+      await sendRequest.waitFor({ timeout: 20000 });
+      await sendRequest.click();
+      await d.getByText('好友申请已保存', { exact: false }).waitFor({ timeout: 20000 });
+      record('D 在页面搜索并发送好友申请', true, '发给 拾光验收·奶奶');
+
+      // E accepts the friend request from the care tab.
+      await openConnections(e);
+      await tab(e, '关怀通知');
+      await e.getByText('希望加你为好友', { exact: false }).first().waitFor({ timeout: 20000 });
+      await e.getByRole('button', { name: '接受' }).first().click();
+      await e.getByText('邀请已处理', { exact: false }).waitFor({ timeout: 20000 });
+      record('E 亲自接受好友申请', true, 'E 点接受后才成为好友');
+
+      // D creates a family space and invites E.
+      await openConnections(d);
+      await tab(d, '共享空间');
+      const spaceTitle = d.locator('input[value="我们的日常"]').first();
+      await spaceTitle.fill('我们的家');
+      await d.getByRole('button', { name: '创建空间' }).click();
+      await d.getByText('空间已创建', { exact: false }).waitFor({ timeout: 20000 });
+      const spaceSelect = d.locator('select', {
+        has: d.locator('option', { hasText: '选择空间' }),
+      });
+      const friendSelect = d.locator('select', {
+        has: d.locator('option', { hasText: '选择好友' }),
+      });
+      await spaceSelect.waitFor({ timeout: 20000 });
+      await friendSelect.locator(`option[value="${ids.e_user_id}"]`).waitFor({
+        state: 'attached',
+        timeout: 20000,
+      });
+      const spaceOption = spaceSelect.locator('option', { hasText: '我们的家' }).last();
+      await spaceOption.waitFor({ state: 'attached', timeout: 20000 });
+      const spaceId = await spaceOption.getAttribute('value');
+      await spaceSelect.selectOption(spaceId);
+      await friendSelect.selectOption(ids.e_user_id);
+      const inviteButton = d.getByRole('button', { name: '发出邀请' }).first();
+      await d.waitForFunction(
+        () => {
+          const btn = Array.from(document.querySelectorAll('button')).find(
+            (b) => b.textContent?.trim() === '发出邀请',
+          );
+          return Boolean(btn && !btn.disabled);
+        },
+        { timeout: 15000 },
+      );
+      await inviteButton.click();
+      await d.getByText('邀请已发出', { exact: false }).waitFor({ timeout: 20000 });
+      record('D 创建家庭空间并邀请 E', true, '空间：我们的家');
+
+      // E accepts the space invite.
+      await e.reload({ waitUntil: 'domcontentloaded' });
