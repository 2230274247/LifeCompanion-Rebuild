+      apiKey: ${DEEPSEEK_API_KEY}
+      baseURL: ${DEEPSEEK_BASE_URL}
+      models:
+        default:
+          - deepseek-chat
+        fetch: false
+      titleConvo: true
+      titleModel: deepseek-chat
+      modelDisplayLabel: DeepSeek
+      addParams:
+        model: deepseek-chat
+        thinking:
+          type: disabled
