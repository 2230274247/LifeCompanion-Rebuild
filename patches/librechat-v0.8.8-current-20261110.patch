index 0000000000000000000000000000000000000000..e16e609f7eebe027f2f367932ee140a7d4b6b2e3
--- /dev/null
+++ b/client/src/components/Life/SharedMemoryCompanion.tsx
@@ -0,0 +1,168 @@
+import { useEffect, useState } from 'react';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import type { LifeMemory } from 'librechat-data-provider';
+import { useQuery } from '@tanstack/react-query';
+import { HeartHandshake } from 'lucide-react';
+import { useAuthContext } from '~/hooks';
+import ShareMemoryDialog from './ShareMemoryDialog';
+import SharedMemoryPanel from './SharedMemoryPanel';
+import './ParlorMemoryPanel.css';
+
+function useIsDesktop() {
+  const [desktop, setDesktop] = useState(() => window.matchMedia('(min-width: 1024px)').matches);
+  useEffect(() => {
+    const media = window.matchMedia('(min-width: 1024px)');
+    const update = () => setDesktop(media.matches);
+    update();
+    media.addEventListener('change', update);
+    return () => media.removeEventListener('change', update);
+  }, []);
+  return desktop;
+}
+
+export default function SharedMemoryCompanion({ memory }: { memory: LifeMemory }) {
+  const { user } = useAuthContext();
+  const isDesktop = useIsDesktop();
+  const [selectedId, setSelectedId] = useState('');
+  const [shareOpen, setShareOpen] = useState(false);
+  const [collapsed, setCollapsed] = useState(false);
+  const [mobileOpen, setMobileOpen] = useState(false);
+  const bySource = useQuery({
+    queryKey: [QueryKeys.lifeSharedMemoriesBySource, user?.id, memory.event_id],
+    queryFn: ({ signal }) => lifeService.sharedMemoriesBySource('memory', memory.event_id, signal),
+    retry: false,
+  });
+
+  const items = bySource.data?.shared_memories ?? [];
+
+  useEffect(() => {
+    if (items.length > 0 && !items.some((item) => item.shared_memory_id === selectedId)) {
+      setSelectedId(items[0].shared_memory_id);
+    }
+  }, [items, selectedId]);
+
+  if (bySource.isLoading) {
+    return (
+      <div
+        role="status"
+        className="lc-parlor"
+        style={{ alignItems: 'center', justifyContent: 'center', minHeight: 360 }}
+      >
+        <p className="lc-parlor__empty">正在查找共同回忆…</p>
+      </div>
+    );
+  }
+
+  if (items.length === 0) {
+    const invite = (
+      <section className="lc-parlor lc-parlor--invite" aria-label="共同回忆入口">
+        <header className="lc-parlor__header">
+          <div className="lc-parlor__title">
+            <strong>共同回忆</strong>
+            <span>Parlor · 邀请亲友一起补充</span>
+          </div>
+        </header>
+        <div className="lc-parlor__invite-body">
+          <p>这段回忆还只有你自己。邀请一位亲友，你们就能在右侧小窗里共同回忆、补充细节。</p>
+          <p className="muted">只有对方在站内亲自接受后才会看到；原始回忆不会被复制或改写。</p>
+          <button
+            type="button"
+            className="lc-parlor__invite-button"
+            onClick={() => setShareOpen(true)}
+          >
+            <HeartHandshake size={16} aria-hidden="true" />
+            邀请亲友共同回忆
+          </button>
+        </div>
+      </section>
+    );
+    return (
+      <>
+        {isDesktop ? (
+          invite
+        ) : (
+          <button
+            type="button"
+            className="lc-parlor__invite-button w-full"
+            onClick={() => setShareOpen(true)}
+          >
+            <HeartHandshake size={16} aria-hidden="true" />
+            邀请亲友共同回忆
+          </button>
+        )}
+        <ShareMemoryDialog
+          open={shareOpen}
+          onOpenChange={setShareOpen}
+          memoryId={memory.event_id}
+          memoryTitle={memory.title}
+        />
+      </>
+    );
+  }
+
+  const activeId = selectedId || items[0].shared_memory_id;
+  const panel = (
+    <>
+      {items.length > 1 ? (
+        <div className="lc-parlor__picker">
+          <label htmlFor="lc-parlor-shared-select">这段回忆有</label>
+          <select
+            id="lc-parlor-shared-select"
+            value={activeId}
+            onChange={(event) => setSelectedId(event.target.value)}
+          >
+            {items.map((item) => (
+              <option key={item.shared_memory_id} value={item.shared_memory_id}>
+                {item.title}
+              </option>
+            ))}
+          </select>
+        </div>
+      ) : null}
+      <SharedMemoryPanel
+        sharedId={activeId}
+        onClose={() => {
+          if (isDesktop) {
+            setCollapsed(true);
+          } else {
+            setMobileOpen(false);
+          }
+        }}
+      />
+    </>
+  );
+
+  if (!isDesktop) {
+    return (
+      <>
+        {mobileOpen ? (
+          <div className="fixed inset-0 z-[85] bg-black/35" onClick={() => setMobileOpen(false)} />
+        ) : null}
+        <button
+          type="button"
+          className="lc-parlor__invite-button w-full"
+          onClick={() => setMobileOpen(true)}
+        >
+          <HeartHandshake size={16} aria-hidden="true" />
+          打开共同回忆（{items[0]?.member_count ?? 0} 位成员）
+        </button>
+        {mobileOpen ? panel : null}
+      </>
+    );
+  }
+
+  if (collapsed) {
+    return (
+      <button
+        type="button"
+        className="lc-parlor__invite-button w-full"
+        onClick={() => setCollapsed(false)}
+      >
+        <HeartHandshake size={16} aria-hidden="true" />
+        重新打开共同回忆
+      </button>
+    );
+  }
+
+  return panel;
+}
diff --git a/client/src/components/Life/SharedMemoryPanel.tsx b/client/src/components/Life/SharedMemoryPanel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..b2d8f43392260d82a2a8123766870e450c3d376a
--- /dev/null
+++ b/client/src/components/Life/SharedMemoryPanel.tsx
@@ -0,0 +1,170 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import type { LifeSharedMemoryMessage } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useAuthContext } from '~/hooks';
+import ParlorMemoryPanel from './ParlorMemoryPanel';
+import './ParlorMemoryPanel.css';
+
+function errorCode(error: unknown) {
+  const value = error as {
+    response?: { data?: { detail?: { code?: string } | string } };
+    message?: string;
+  };
+  const detail = value.response?.data?.detail;
+  return typeof detail === 'string' ? detail : detail?.code || value.message || 'REQUEST_FAILED';
+}
+
+type Props = {
+  sharedId: string;
+  onClose?: () => void;
+};
+
+export default function SharedMemoryPanel({ sharedId, onClose }: Props) {
+  const { user } = useAuthContext();
+  const cache = useQueryClient();
+  const [error, setError] = useState('');
+  const [agentPending, setAgentPending] = useState(false);
+  const eventCursor = useRef(0);
+  const scopeKey = `shared:${sharedId}`;
+  const queryKey = useMemo(
+    () => [QueryKeys.lifeSharedMemory, user?.id, sharedId],
+    [sharedId, user?.id],
+  );
+
+  const me = useQuery({
+    queryKey: [QueryKeys.lifeCollaborationMe, user?.id],
+    queryFn: ({ signal }) => lifeService.collaborationMe(signal),
+    retry: false,
+  });
+  const detail = useQuery({
+    queryKey,
+    queryFn: ({ signal }) => lifeService.sharedMemory(sharedId, signal),
+    enabled: Boolean(sharedId),
+    retry: false,
+  });
+
+  useEffect(() => {
+    if (!sharedId) {
+      return;
+    }
+    let stopped = false;
+    const controller = new AbortController();
+    const run = async () => {
+      while (!stopped) {
+        try {
+          const result = await lifeService.waitCollaborationEvents(
+            scopeKey,
+            eventCursor.current,
+            15,
+            controller.signal,
+          );
+          if (result.events.length > 0) {
+            eventCursor.current = Math.max(
+              eventCursor.current,
+              ...result.events.map((event) => event.event_id),
+            );
+            await cache.invalidateQueries(queryKey);
+          }
+        } catch (requestError) {
+          if (controller.signal.aborted || stopped) {
+            break;
+          }
+          setError(`共同回忆实时连接暂时中断：${errorCode(requestError)}`);
+          await new Promise((resolve) => window.setTimeout(resolve, 1200));
+        }
+      }
+    };
+    void run();
+    return () => {
+      stopped = true;
+      controller.abort();
+      eventCursor.current = 0;
+    };
+  }, [cache, queryKey, scopeKey, sharedId]);
+
+  const react = useMutation(
+    ({ messageId, emoji }: { messageId: string; emoji: '❤️' | '👍' | '😂' | '✨' | '👀' }) =>
+      lifeService.reactToSharedMemoryMessage(sharedId, messageId, emoji),
+    {
+      onSuccess: async () => {
+        setError('');
+        await cache.invalidateQueries(queryKey);
+      },
+      onError: (requestError) => setError(`回应未保存：${errorCode(requestError)}`),
+    },
+  );
+
+  const send = async (body: string) => {
+    setError('');
+    const aiQuery = body.match(/^@ai\s+([\s\S]+)$/i);
+    if (aiQuery) {
+      setAgentPending(true);
+      try {
+        await lifeService.agentSharedMemoryQuery(sharedId, {
+          query: aiQuery[1].trim(),
+        });
+      } finally {
+        setAgentPending(false);
+      }
+    } else {
+      await lifeService.sendSharedMemoryMessage(sharedId, {
+        body,
+        client_message_id: crypto.randomUUID(),
+      });
+    }
+    await cache.invalidateQueries(queryKey);
+  };
+
+  if (detail.isLoading) {
+    return (
+      <div
+        role="status"
+        className="lc-parlor"
+        style={{ alignItems: 'center', justifyContent: 'center', minHeight: 360 }}
+      >
+        <p className="lc-parlor__empty">正在打开共同回忆…</p>
+      </div>
+    );
+  }
+
+  if (detail.isError || !detail.data) {
+    return (
+      <div
+        role="alert"
+        className="lc-parlor"
+        style={{ alignItems: 'center', justifyContent: 'center', minHeight: 360 }}
+      >
+        <p className="lc-parlor__empty">
+          无法打开这段共同回忆。它可能已被归档、你已不再是成员，或当前账号没有访问权限。
+        </p>
+      </div>
+    );
+  }
+
+  const shared = detail.data;
+  const memberNames = Object.fromEntries(
+    (shared.members ?? []).map((member) => [member.user_id, member.display_name]),
+  );
+  const messages: LifeSharedMemoryMessage[] = shared.messages.map((message) => ({
+    ...message,
+    sender_display_name:
+      memberNames[message.sender_id] || message.sender_display_name || '共同回忆成员',
+  }));
+
+  return (
+    <ParlorMemoryPanel
+      title={shared.shared_memory.title}
+      members={shared.members}
+      currentUserId={me.data?.profile.user_id}
+      messages={messages}
+      pending={agentPending}
+      error={error}
+      onClose={onClose ?? (() => undefined)}
+      onSend={send}
+      onReact={async (messageId, emoji) => {
+        await react.mutateAsync({ messageId, emoji });
+      }}
+    />
+  );
+}
