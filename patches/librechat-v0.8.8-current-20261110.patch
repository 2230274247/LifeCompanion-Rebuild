index 0000000000000000000000000000000000000000..7de78adbf870eeead98e45dd30e525769028fcce
--- /dev/null
+++ b/client/src/components/Life/OtisPet/OtisPet.tsx
@@ -0,0 +1,184 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useLocalize } from '~/hooks';
+import { faces } from './content';
+import { FaceCanvas } from './face/FaceCanvas';
+import type { Mood } from './face/FaceCanvas';
+import './otis-pet.css';
+
+/** Otis's own cobalt disc; part of the character, not a theme surface. */
+const DISC = '#2f4bf0';
+const COLLAPSE_KEY = 'life-otis-pet-collapsed';
+
+function readCollapsed() {
+  try {
+    return localStorage.getItem(COLLAPSE_KEY) === '1';
+  } catch {
+    return false;
+  }
+}
+
+function writeCollapsed(value: boolean) {
+  try {
+    localStorage.setItem(COLLAPSE_KEY, value ? '1' : '0');
+  } catch {
+    /* preferences are optional */
+  }
+}
+
+/**
+ * The hit layer is a square, but Otis only occupies the middle of it. Read the
+ * base cut-out's alpha mask so pixels around the head fall through to the page
+ * instead of swallowing clicks.
+ */
+function useFacePassthrough(enabled: boolean) {
+  useEffect(() => {
+    if (!enabled) {
+      return;
+    }
+    const size = 256;
+    const canvas = document.createElement('canvas');
+    canvas.width = size;
+    canvas.height = size;
+    const context = canvas.getContext('2d', { willReadFrequently: true });
+    if (!context) {
+      return;
+    }
+    let alpha: Uint8Array | null = null;
+    const image = new Image();
+    image.decoding = 'async';
+    image.onload = () => {
+      context.drawImage(image, 0, 0, size, size);
+      const data = context.getImageData(0, 0, size, size).data;
+      alpha = new Uint8Array(size * size);
+      for (let i = 0; i < alpha.length; i++) {
+        alpha[i] = data[i * 4 + 3];
+      }
+    };
+    image.src = faces.base.src;
+
+    const hit = () => document.querySelector<HTMLElement>('.otis-pet [role="img"]');
+    const onMove = (event: PointerEvent) => {
+      if (event.buttons || !alpha) {
+        return;
+      }
+      const element = hit();
+      if (!element) {
+        return;
+      }
+      const rect = element.getBoundingClientRect();
+      const x = event.clientX - rect.left;
+      const y = event.clientY - rect.top;
+      if (x < 0 || y < 0 || x >= rect.width || y >= rect.height) {
+        return;
+      }
+      const px = Math.min(size - 1, Math.floor((x / rect.width) * size));
+      const py = Math.min(size - 1, Math.floor((y / rect.height) * size));
+      element.style.pointerEvents = alpha[py * size + px] > 16 ? 'auto' : 'none';
+    };
+    document.addEventListener('pointermove', onMove, { passive: true });
+    return () => {
+      document.removeEventListener('pointermove', onMove);
+      const element = hit();
+      if (element) {
+        element.style.pointerEvents = 'none';
+      }
+    };
+  }, [enabled]);
+}
+
+/**
+ * Otis lives inside the app shell, bottom-right, and only exists while the
+ * page is open. The face engine is the portfolio's, unchanged; this file adds
+ * the widget chrome and the collapse affordance.
+ */
+export default function OtisPet() {
+  const localize = useLocalize();
+  const stageRef = useRef<HTMLDivElement>(null);
+  const [mood, setMood] = useState<Mood>({ face: 'base', patience: 100, pulls: 0 });
+  const [collapsed, setCollapsed] = useState(readCollapsed);
+  const onMood = useCallback((next: Mood) => setMood(next), []);
+  useFacePassthrough(!collapsed);
+
+  const toggle = () => {
+    setCollapsed((current) => {
+      writeCollapsed(!current);
+      return !current;
+    });
+  };
+
+  return (
+    <div className={`otis-pet${collapsed ? ' is-collapsed' : ''}`} data-testid="otis-pet">
+      {collapsed ? (
+        <button
+          type="button"
+          className="otis-pet-bubble border border-border-light bg-surface-primary shadow-lg"
+          onClick={toggle}
+          aria-label={localize('com_ui_otis_open')}
+          title={localize('com_ui_otis_open')}
+        >
+          <img src={faces.base.src} alt="" aria-hidden />
+        </button>
+      ) : (
+        <>
+          <div className="otis-pet-face">
+            <div ref={stageRef} className="otis-pet-stage">
+              <p
+                className={`otis-pet-hint text-text-primary${mood.pulls ? ' is-off' : ''}`}
+                aria-hidden
+              >
+                {localize('com_ui_otis_hint')}
+                <svg viewBox="0 0 60 40" className="otis-pet-arrow" fill="none">
+                  <path
+                    d="M4 4c18 2 34 12 44 30"
+                    stroke="currentColor"
+                    strokeWidth="1.6"
+                    strokeLinecap="round"
+                  />
+                  <path
+                    d="M40 31l8 4 1-9"
+                    stroke="currentColor"
+                    strokeWidth="1.6"
+                    strokeLinecap="round"
+                    strokeLinejoin="round"
+                  />
+                </svg>
+              </p>
+            </div>
+            <FaceCanvas
+              stageRef={stageRef}
+              discColor={DISC}
+              onMood={onMood}
+              ariaLabel={localize('com_ui_otis_aria')}
+            />
+          </div>
+          <div
+            className="otis-pet-meter border border-border-light bg-surface-primary/85 shadow-lg"
+            aria-live="polite"
+          >
+            <div className="otis-pet-mood">
+              <span className="text-text-secondary">{localize('com_ui_otis_mood')}</span>
+              <strong className="text-text-primary">{faces[mood.face].mood}</strong>
+            </div>
+            <div className="otis-pet-bar bg-border-light">
+              <i
+                style={{
+                  width: `${mood.patience}%`,
+                  background: `color-mix(in oklab, ${DISC} ${mood.patience}%, #e8412c)`,
+                }}
+              />
+            </div>
+            <button
+              type="button"
+              className="otis-pet-hide text-text-secondary hover:text-text-primary"
+              onClick={toggle}
+              aria-label={localize('com_ui_otis_hide')}
+              title={localize('com_ui_otis_hide')}
+            >
+              ×
+            </button>
+          </div>
+        </>
+      )}
+    </div>
+  );
+}
