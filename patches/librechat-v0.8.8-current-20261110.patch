@@ -0,0 +1,172 @@
+import { useEffect, useState } from 'react';
+import { Button } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery } from '@tanstack/react-query';
+import * as DialogPrimitive from '@radix-ui/react-dialog';
+import { HeartHandshake, ShieldCheck, X } from 'lucide-react';
+import { Link } from 'react-router-dom';
+import { useAuthContext } from '~/hooks';
+
+type Props = {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  memoryId: string;
+  memoryTitle: string;
+};
+
+function errorCode(error: unknown) {
+  const value = error as {
+    response?: { data?: { detail?: { code?: string } | string } };
+    message?: string;
+  };
+  const detail = value.response?.data?.detail;
+  return typeof detail === 'string'
+    ? detail
+    : detail?.code || value.message || 'REQUEST_FAILED';
+}
+
+export default function ShareMemoryDialog({
+  open,
+  onOpenChange,
+  memoryId,
+  memoryTitle,
+}: Props) {
+  const { user } = useAuthContext();
+  const [friendId, setFriendId] = useState('');
+  const [message, setMessage] = useState('想和你一起记住这段回忆。');
+  const [notice, setNotice] = useState('');
+  const friends = useQuery({
+    queryKey: [QueryKeys.lifeFriends, user?.id],
+    queryFn: ({ signal }) => lifeService.friends(signal),
+    enabled: open,
+    retry: false,
+  });
+  const invite = useMutation(
+    () =>
+      lifeService.inviteToSharedMemory({
+        source_kind: 'memory',
+        source_id: memoryId,
+        target_user_id: friendId,
+        message: message.trim(),
+      }),
+    {
+      onSuccess: () => {
+        setNotice('邀请已保存。对方接受前不会看到这段回忆。');
+      },
+      onError: (error) => setNotice(`邀请未发出：${errorCode(error)}`),
+    },
+  );
+
+  useEffect(() => {
+    if (!open) {
+      setNotice('');
+      setFriendId('');
+      setMessage('想和你一起记住这段回忆。');
+    }
+  }, [open]);
+
+  return (
+    <DialogPrimitive.Root open={open} onOpenChange={onOpenChange}>
+      <DialogPrimitive.Portal>
+        <DialogPrimitive.Overlay className="fixed inset-0 z-[100] bg-black/45 backdrop-blur-[2px]" />
+        <DialogPrimitive.Content className="fixed left-1/2 top-1/2 z-[101] max-h-[92dvh] w-[calc(100%-1.5rem)] max-w-lg -translate-x-1/2 -translate-y-1/2 overflow-y-auto rounded-[1.75rem] border border-border-light bg-surface-primary-alt p-5 shadow-2xl outline-none sm:p-7">
+          <DialogPrimitive.Title className="pr-10 text-xl font-semibold">
+            邀请亲友共同回忆
+          </DialogPrimitive.Title>
+          <DialogPrimitive.Description className="mt-2 text-sm leading-6 text-text-secondary">
+            《{memoryTitle}》仍保存在你的个人回忆中。接受邀请后，共同回忆只保存来源指针和新的补充，不会复制或改写原始记录。
+          </DialogPrimitive.Description>
+          <DialogPrimitive.Close
+            className="absolute right-4 top-4 grid size-10 place-items-center rounded-xl border border-border-light bg-surface-primary hover:bg-surface-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring-primary"
+            aria-label="关闭邀请窗口"
+          >
+            <X className="size-5" aria-hidden="true" />
+          </DialogPrimitive.Close>
+
+          <div className="mt-5 rounded-xl border border-border-light bg-surface-primary p-3 text-sm leading-6">
+            <p className="flex items-start gap-2">
+              <ShieldCheck className="mt-1 size-4 shrink-0" aria-hidden="true" />
+              对方需要在站内亲自接受邀请；你的私人回忆列表不会因此向其他人开放。
+            </p>
+          </div>
+
+          {friends.isLoading ? (
+            <p role="status" className="mt-5 text-sm text-text-secondary">
+              正在读取好友名单…
+            </p>
+          ) : null}
+          {friends.isError ? (
+            <p role="alert" className="mt-5 rounded-xl bg-surface-active p-3 text-sm">
+              好友名单读取失败：{errorCode(friends.error)}
+            </p>
+          ) : null}
+          {friends.isSuccess && (friends.data.friends.length ?? 0) === 0 ? (
+            <div className="mt-5 rounded-xl border border-dashed border-border-medium p-5 text-center text-sm">
+              <p>还没有可以邀请的好友。</p>
+              <Link
+                className="mt-2 inline-flex min-h-10 items-center text-link underline"
+                to="/connections"
+              >
+                先去添加亲友
+              </Link>
+            </div>
+          ) : null}
+
+          <form
+            className="mt-5 grid gap-4"
+            onSubmit={(event) => {
+              event.preventDefault();
+              if (friendId) {
+                invite.mutate();
+              }
+            }}
+          >
+            <label className="grid gap-2 text-sm font-medium">
+              邀请谁
+              <select
+                className="min-h-11 rounded-xl border border-border-medium bg-surface-primary px-3 font-normal"
+                value={friendId}
+                onChange={(event) => setFriendId(event.target.value)}
+              >
+                <option value="">选择一位好友</option>
+                {(friends.data?.friends ?? []).map((friend) => (
+                  <option key={friend.user_id} value={friend.user_id}>
+                    {friend.display_name}
+                  </option>
+                ))}
+              </select>
+            </label>
+            <label className="grid gap-2 text-sm font-medium">
+              邀请留言
+              <textarea
+                className="min-h-24 resize-y rounded-xl border border-border-medium bg-surface-primary px-3 py-2 font-normal leading-6"
+                value={message}
+                maxLength={240}
+                onChange={(event) => setMessage(event.target.value)}
+              />
+            </label>
+            {notice ? (
+              <p role="status" className="rounded-xl bg-surface-active px-3 py-2 text-sm leading-6">
+                {notice}
+              </p>
+            ) : null}
+            <div className="flex flex-wrap justify-end gap-2">
+              <DialogPrimitive.Close asChild>
+                <Button type="button" variant="outline">
+                  稍后再说
+                </Button>
+              </DialogPrimitive.Close>
+              <Button
+                type="submit"
+                disabled={!friendId || invite.isLoading || Boolean(notice && invite.isSuccess)}
+              >
+                <HeartHandshake className="size-4" aria-hidden="true" />
+                {invite.isSuccess ? '邀请已发出' : '发出邀请'}
+              </Button>
+            </div>
+          </form>
+        </DialogPrimitive.Content>
+      </DialogPrimitive.Portal>
+    </DialogPrimitive.Root>
+  );
+}
