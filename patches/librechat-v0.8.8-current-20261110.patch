@@ -0,0 +1,153 @@
+import { useRef, useState } from 'react';
+import { ImageOff } from 'lucide-react';
+import { Link } from 'react-router-dom';
+import type { LifeMemory } from 'librechat-data-provider';
+import { occurrenceDay, occurrenceLabel } from './occurrence';
+import SharedMemoryCompanion from './SharedMemoryCompanion';
+import MemoryImageDialog from './MemoryImageDialog';
+import ShareMemoryDialog from './ShareMemoryDialog';
+import { useLocalize } from '~/hooks';
+
+function readableContent(content: string, title: string) {
+  const footer = content.indexOf('\n\n> AI 生活伙伴记录 · 事件 `');
+  if (footer < 0) {
+    return content;
+  }
+  const body = content.slice(0, footer);
+  const heading = `# ${title}\n\n`;
+  return body.startsWith(heading) ? body.slice(heading.length) : body;
+}
+
+export default function MemoryDetail({ memory, backTo }: { memory: LifeMemory; backTo: string }) {
+  const localize = useLocalize();
+  const [imageOpen, setImageOpen] = useState(false);
+  const [imageFailed, setImageFailed] = useState(false);
+  const [shareOpen, setShareOpen] = useState(false);
+  const triggerRef = useRef<HTMLButtonElement>(null);
+  const image = memory.media?.image_data ?? memory.media?.thumbnail_data;
+
+  return (
+    <div className="mx-auto w-full max-w-[1180px]">
+      <div className="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-start">
+        <div className="min-w-0">
+          <Link
+            className="mb-6 inline-flex min-h-11 items-center text-link underline underline-offset-4"
+            to={backTo}
+          >
+            {localize('com_life_back')}
+          </Link>
+          <article className="overflow-hidden rounded-[1.75rem] border border-border-light bg-surface-primary-alt shadow-sm">
+            {image && !imageFailed ? (
+              <button
+                ref={triggerRef}
+                type="button"
+                className="group relative block w-full cursor-zoom-in bg-surface-secondary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-ring-primary"
+                onClick={() => setImageOpen(true)}
+                aria-label={localize('com_life_view_large_image')}
+              >
+                <img
+                  src={image}
+                  alt={memory.title}
+                  className="aspect-[4/3] h-auto w-full object-cover sm:aspect-[16/9]"
+                  width={memory.media?.width ?? undefined}
+                  height={memory.media?.height ?? undefined}
+                  onError={() => setImageFailed(true)}
+                />
+                <span className="absolute right-4 top-4 rounded-full bg-black/65 px-3 py-1.5 text-xs text-white">
+                  {localize('com_life_view_large_image')}
+                </span>
+              </button>
+            ) : (
+              <div className="flex aspect-[16/9] flex-col items-center justify-center gap-3 bg-surface-secondary px-6 text-text-secondary">
+                <ImageOff className="size-9" aria-hidden="true" />
+                <p className="text-center text-sm leading-6">
+                  {imageFailed
+                    ? localize('com_life_image_unavailable')
+                    : localize('com_life_no_image')}
+                </p>
+              </div>
+            )}
+            <div className="p-6 sm:p-9">
+              <div className="mb-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-text-secondary">
+                <time dateTime={occurrenceDay(memory)}>
+                  {occurrenceLabel(memory, localize('com_life_date_unknown'))}
+                </time>
+                {memory.media?.ai_generated ? (
+                  <span className="rounded-full bg-surface-active px-3 py-1 text-xs font-medium text-text-primary">
+                    {localize('com_life_ai_image')}
+                  </span>
+                ) : null}
+              </div>
+              <h1 className="font-serif mb-4 break-words text-3xl leading-tight sm:text-4xl">
+                {memory.title}
+              </h1>
+              <p className="mb-8 break-words text-base leading-8 text-text-secondary">
+                {memory.summary}
+              </p>
+              <section className="rounded-2xl border border-border-light bg-surface-primary p-5">
+                <h2 className="mb-3 text-sm font-semibold">{localize('com_life_memory_facts')}</h2>
+                <div className="whitespace-pre-wrap break-words text-base leading-8">
+                  {readableContent(memory.content, memory.title)}
+                </div>
+              </section>
+              {memory.media?.ai_generated ? (
+                <p className="mt-6 rounded-xl bg-surface-secondary px-4 py-3 text-sm leading-6 text-text-secondary">
+                  {localize('com_life_ai_image_notice')}
+                </p>
+              ) : null}
+              <ul aria-label={localize('com_life_tags')} className="mt-6 flex flex-wrap gap-2">
+                {memory.tags.map((tag) => (
+                  <li key={tag} className="rounded-full bg-surface-active px-3 py-1 text-xs">
+                    #{tag}
+                  </li>
+                ))}
+              </ul>
+              <div className="mt-8 flex flex-wrap items-center gap-3">
+                {memory.conversation_id ? (
+                  <Link
+                    className="inline-flex min-h-11 items-center rounded-lg border border-border-medium px-4 py-2 text-sm text-text-primary no-underline hover:bg-surface-hover"
+                    to={`/c/${encodeURIComponent(memory.conversation_id)}`}
+                  >
+                    {localize('com_life_open_chat')}
+                  </Link>
+                ) : null}
+                <Link
+                  className="inline-flex min-h-11 items-center px-2 text-sm text-link underline underline-offset-4"
+                  to="/memory-settings"
+                >
+                  {localize('com_life_manage_permissions')}
+                </Link>
+                <button
+                  type="button"
+                  className="inline-flex min-h-11 items-center rounded-lg border border-border-medium px-4 py-2 text-sm text-text-primary hover:bg-surface-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring-primary"
+                  onClick={() => setShareOpen(true)}
+                >
+                  {localize('com_life_shared_invite')}
+                </button>
+              </div>
+            </div>
+          </article>
+          {image ? (
+            <MemoryImageDialog
+              open={imageOpen}
+              onOpenChange={setImageOpen}
+              src={image}
+              title={memory.title}
+              disclaimer={memory.media?.disclaimer ?? localize('com_life_ai_image_notice')}
+              triggerRef={triggerRef}
+            />
+          ) : null}
+          <ShareMemoryDialog
+            open={shareOpen}
+            onOpenChange={setShareOpen}
+            memoryId={memory.event_id}
+            memoryTitle={memory.title}
+          />
+        </div>
+        <aside className="min-w-0 lg:sticky lg:top-4 lg:self-start">
+          <SharedMemoryCompanion memory={memory} />
+        </aside>
+      </div>
+    </div>
+  );
+}
