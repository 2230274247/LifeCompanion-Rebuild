+              <h2 className="text-lg font-semibold">共同回忆</h2>
+              <p className="mt-1 text-sm leading-6 text-text-secondary">
+                共同回忆只是关联个人来源，并单独保存成员补充；不会改写原始记录。
+              </p>
+              <div className="mt-4 space-y-2">
+                {(shared.data?.shared_memories ?? []).map((memory) => (
+                  <Link
+                    key={memory.shared_memory_id}
+                    className="block rounded-xl border border-border-light bg-surface-primary p-4 no-underline hover:bg-surface-hover"
+                    to={`/shared-memories/${encodeURIComponent(memory.shared_memory_id)}`}
+                  >
+                    <h3 className="font-medium text-text-primary">{memory.title}</h3>
+                    <p className="mt-1 text-xs text-text-secondary">
+                      {memory.member_count} 位成员 · {memory.contribution_count} 条补充
+                    </p>
+                  </Link>
+                ))}
+                {shared.isSuccess && (shared.data?.shared_memories.length ?? 0) === 0 ? (
+                  <p className="rounded-xl border border-dashed border-border-medium px-4 py-10 text-center text-sm text-text-secondary">
+                    从一条个人回忆详情页发出邀请后，会出现在这里。
+                  </p>
+                ) : null}
+              </div>
+            </section>
+          </div>
+        ) : null}
+      </div>
+    </main>
+  );
+}
+
+function actionLabel(result: unknown) {
+  if (
+    result &&
+    typeof result === 'object' &&
+    'shared_memory_id' in result &&
+    result.shared_memory_id
+  ) {
+    return '邀请已接受，共同回忆已建立。';
+  }
+  return '邀请已处理。';
+}
diff --git a/client/src/components/Life/DirectMessage.tsx b/client/src/components/Life/DirectMessage.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..22f860e0e738538eb3ea350456d1095be044483d
--- /dev/null
+++ b/client/src/components/Life/DirectMessage.tsx
@@ -0,0 +1,212 @@
+import { useEffect, useMemo, useRef, useState } from 'react';
+import {
+  ChatContainer,
+  MainContainer,
+  Message,
+  MessageList,
+} from '@chatscope/chat-ui-kit-react';
+import '@chatscope/chat-ui-kit-styles/dist/default/styles.min.css';
+import { Button } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery } from '@tanstack/react-query';
+import { ArrowLeft, Send, ShieldCheck } from 'lucide-react';
+import { Link, useParams } from 'react-router-dom';
+import { useAuthContext } from '~/hooks';
+import './SpaceRoom.css';
+
+function errorCode(error: unknown) {
+  const value = error as {
+    response?: { data?: { detail?: { code?: string } | string } };
+    message?: string;
+  };
+  const detail = value.response?.data?.detail;
+  return typeof detail === 'string'
+    ? detail
+    : detail?.code || value.message || 'REQUEST_FAILED';
+}
+
+function messageTime(value: string) {
+  return new Intl.DateTimeFormat('zh-CN', {
+    hour: '2-digit',
+    minute: '2-digit',
+  }).format(new Date(value));
+}
+
+export default function DirectMessage() {
+  const { peerId = '' } = useParams();
+  const { user } = useAuthContext();
+  const [draft, setDraft] = useState('');
+  const [error, setError] = useState('');
+  const listRef = useRef<HTMLDivElement>(null);
+
+  const me = useQuery({
+    queryKey: [QueryKeys.lifeCollaborationMe, user?.id],
+    queryFn: ({ signal }) => lifeService.collaborationMe(signal),
+    retry: false,
+  });
+  const friends = useQuery({
+    queryKey: [QueryKeys.lifeFriends, user?.id],
+    queryFn: ({ signal }) => lifeService.friends(signal),
+    retry: false,
+  });
+  const messages = useQuery({
+    queryKey: [QueryKeys.lifeDirectMessages, user?.id, peerId],
+    queryFn: ({ signal }) => lifeService.directMessages(peerId, undefined, signal),
+    enabled: Boolean(peerId),
+    retry: false,
+    refetchInterval: 4_000,
+  });
+  const send = useMutation(
+    (body: string) =>
+      lifeService.sendDirectMessage(peerId, {
+        body,
+        client_message_id: crypto.randomUUID(),
+      }),
+    {
+      onMutate: () => setError(''),
+      onSuccess: async () => {
+        setDraft('');
+        await messages.refetch();
+      },
+      onError: (requestError) =>
+        setError(`发送失败，草稿已保留：${errorCode(requestError)}`),
+    },
+  );
+
+  useEffect(() => {
+    const element = listRef.current?.querySelector('.cs-message-list__scroll-wrapper');
+    if (element instanceof HTMLElement) {
+      element.scrollTop = element.scrollHeight;
+    }
+  }, [messages.data?.messages]);
+
+  const peer = useMemo(
+    () => friends.data?.friends.find((friend) => friend.user_id === peerId),
+    [friends.data?.friends, peerId],
+  );
+
+  const submit = () => {
+    const text = draft.trim();
+    if (text && !send.isLoading) {
+      send.mutate(text);
+    }
+  };
+
+  if (friends.isError || messages.isError) {
+    return (
+      <main className="flex min-h-0 flex-1 items-center justify-center bg-surface-primary p-6">
+        <div role="alert" className="max-w-md rounded-2xl border border-border-medium p-6">
+          <h1 className="text-xl font-semibold">无法打开这段私信</h1>
+          <p className="mt-2 text-sm leading-6 text-text-secondary">
+            只有互相确认且未拉黑的好友可以收发私信。
+          </p>
+          <Link className="mt-5 inline-flex min-h-11 items-center text-link underline" to="/connections">
+            返回亲友圈
+          </Link>
+        </div>
+      </main>
+    );
+  }
+
+  return (
+    <main className="min-h-0 flex-1 overflow-y-auto bg-surface-primary">
+      <div className="mx-auto w-full max-w-5xl px-3 py-5 sm:px-6 lg:px-8">
+        <section className="life-space-chat flex min-h-[calc(100dvh-10rem)] flex-col overflow-hidden rounded-[1.5rem] border border-border-light bg-surface-primary-alt">
+          <header className="flex flex-wrap items-center gap-3 border-b border-border-light px-4 py-4 sm:px-5">
+            <Link
+              to="/connections"
+              aria-label="返回亲友圈"
+              className="grid size-11 place-items-center rounded-xl border border-border-light bg-surface-primary hover:bg-surface-hover"
+            >
+              <ArrowLeft className="size-5" aria-hidden="true" />
+            </Link>
+            <div className="min-w-0 flex-1">
+              <p className="text-xs font-semibold tracking-[0.16em] text-text-secondary">
+                PRIVATE MESSAGE
+              </p>
+              <h1 className="truncate text-xl font-semibold">
+                {peer?.display_name || '好友私信'}
+              </h1>
+            </div>
+            <span className="inline-flex items-center gap-2 rounded-full bg-surface-active px-3 py-1.5 text-xs">
+              <ShieldCheck className="size-4" aria-hidden="true" />
+              仅双方可见
+            </span>
+          </header>
+
+          <div ref={listRef} className="min-h-[440px] flex-1">
+            <MainContainer>
+              <ChatContainer>
+                <MessageList autoScrollToBottom scrollBehavior="smooth">
+                  {(messages.data?.messages ?? []).map((item) => {
+                    const outgoing = item.sender_id === me.data?.profile.user_id;
+                    const sender = peer?.display_name || '好友';
+                    return (
+                      <Message
+                        key={item.message_id}
+                        model={{
+                          message: item.deleted ? '这条消息已被发送者删除。' : item.body,
+                          sentTime: messageTime(item.created_at),
+                          sender: outgoing ? '我' : sender,
+                          direction: outgoing ? 'outgoing' : 'incoming',
+                          position: 'single',
+                        }}
+                        avatarPosition={outgoing ? 'top-right' : 'top-left'}
+                      >
+                        <Message.Footer
+                          sentTime={messageTime(item.created_at)}
+                          sender={outgoing ? '我' : sender}
+                        />
+                      </Message>
+                    );
+                  })}
+                </MessageList>
+              </ChatContainer>
+            </MainContainer>
+          </div>
+
+          {error ? (
+            <div role="alert" className="border-t border-border-light bg-surface-active px-4 py-2 text-sm">
+              {error}
+            </div>
+          ) : null}
+          <form
+            className="border-t border-border-light bg-surface-primary p-3 sm:p-4"
+            onSubmit={(event) => {
+              event.preventDefault();
+              submit();
+            }}
+          >
+            <div className="flex items-end gap-2">
+              <label className="min-w-0 flex-1">
+                <span className="sr-only">私信内容</span>
+                <textarea
+                  className="min-h-12 w-full resize-none rounded-xl border border-border-medium bg-surface-primary-alt px-3 py-3 text-sm leading-6"
+                  rows={1}
+                  maxLength={4000}
+                  value={draft}
+                  placeholder="写一条只有你们两人能看到的私信…"
+                  onChange={(event) => setDraft(event.target.value)}
+                  onKeyDown={(event) => {
+                    if (event.key === 'Enter' && !event.shiftKey) {
+                      event.preventDefault();
+                      submit();
+                    }
+                  }}
+                />
+              </label>
+              <Button
+                type="submit"
+                className="min-h-12 px-4"
+                disabled={!draft.trim() || send.isLoading}
+              >
+                <Send className="size-4" aria-hidden="true" />
+                发送
+              </Button>
+            </div>
+          </form>
+        </section>
+      </div>
+    </main>
+  );
+}
diff --git a/client/src/components/Life/DirectMomentTestActions.tsx b/client/src/components/Life/DirectMomentTestActions.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..c216816ba67240cae27f2cedc4defb027a7fd407
--- /dev/null
+++ b/client/src/components/Life/DirectMomentTestActions.tsx
@@ -0,0 +1,125 @@
+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Button } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { useAuthContext } from '~/hooks';
+
+type Props = {
+  conversationId?: string | null;
+  sourceMessageId?: string | null;
+  text?: string | null;
+  isSubmitting?: boolean;
+};
+
+function errorCode(error: unknown) {
+  const value = error as { response?: { data?: { detail?: { code?: string } } } };
+  return value.response?.data?.detail?.code ?? 'DIRECT_TEST_FAILED';
+}
+
+function errorMessage(error: unknown) {
+  const code = errorCode(error);
+  const messages: Record<string, string> = {
+    CONSENT_REQUIRED: '请先在“记忆与权限”中开启回忆和生图授权。',
+    SOURCE_VERIFICATION_UNAVAILABLE: '聊天服务暂时不可用，无法核验原始消息，请稍后重试。',
+    SOURCE_MESSAGE_UNAVAILABLE: '原始消息不存在，或当前账号无权访问。',
+    SOURCE_MESSAGE_CHANGED_OR_DELETED: '原始消息已变更或删除，请从当前消息重新操作。',
+    MEMORY_WITHDRAWN: '这条记忆已撤回，不能再次加入。',
+    ADMIN_DIRECT_TEST_REQUIRED: '当前账号没有管理员测试权限。',
+  };
+  return messages[code] ?? `测试操作失败（${code}）`;
+}
+
+export default function DirectMomentTestActions({
+  conversationId,
+  sourceMessageId,
+  text,
+  isSubmitting = false,
+}: Props) {
+  const { user } = useAuthContext();
+  const queryClient = useQueryClient();
+  const [lastResult, setLastResult] = useState<string>('');
+  const enabled = Boolean(
+    user?.id && conversationId && conversationId !== 'new' && sourceMessageId && text?.trim() && !isSubmitting,
+  );
+  const status = useQuery({
+    queryKey: [QueryKeys.lifeDirectMomentTest, user?.id],
+    queryFn: ({ signal }) => lifeService.directMomentTestStatus(signal),
+    enabled: Boolean(user?.id),
+    retry: false,
+  });
+  const extract = useMutation(
+    (action: 'memory' | 'image') =>
+      lifeService.createDirectMomentTest({
+        conversation_id: conversationId ?? '',
+        source_message_id: sourceMessageId ?? '',
+        text: text ?? '',
+        action,
+      }),
+    {
+      onSuccess: async (result) => {
+        if (result.moment?.moment_id) {
+          setLastResult('图片已生成，可在“时段回忆”中查看。');
+        } else if (result.memory?.memory_id) {
+          setLastResult('已加入“我的回忆”。');
+        } else {
+          setLastResult('测试操作成功');
+        }
+        await queryClient.invalidateQueries({ queryKey: [QueryKeys.lifeMoments] });
+        await queryClient.invalidateQueries({ queryKey: [QueryKeys.lifeMemories] });
+        await queryClient.invalidateQueries({ queryKey: [QueryKeys.lifeMemory] });
+        await queryClient.invalidateQueries({ queryKey: [QueryKeys.lifeKnowledge] });
+        await queryClient.invalidateQueries({ queryKey: [QueryKeys.lifeChatLinks] });
+        await queryClient.invalidateQueries({ queryKey: [QueryKeys.lifeDirectMomentTest] });
+      },
+    },
+  );
+
+  if (!enabled || !status.data?.enabled) {
+    return null;
+  }
+
+  return (
+    <section
+      aria-label="管理员测试"
+      data-testid="direct-moment-test-actions"
+      className="mt-3 rounded-2xl border border-amber-300/70 bg-amber-50/80 p-4 text-sm text-amber-950"
+    >
+      <h3 className="font-serif text-base font-semibold">管理员测试</h3>
+      <p className="mt-1 text-amber-800">使用当前用户消息直接测试生图链路。</p>
+      <div className="mt-3 flex flex-wrap gap-2">
+        <Button
+          variant="outline"
+          size="sm"
+          disabled={extract.isLoading}
+          onClick={() => extract.mutate('memory')}
+        >
+          {extract.isLoading && extract.variables === 'memory' ? '正在纳入回忆…' : '一键纳入回忆'}
+        </Button>
+        <Button
+          variant="outline"
+          size="sm"
+          disabled={!status.data.provider_ready || extract.isLoading}
+          onClick={() => extract.mutate('image')}
+        >
+          {extract.isLoading && extract.variables === 'image' ? '正在生成图片…' : '一键生图'}
+        </Button>
+        <Link
+          className="inline-flex min-h-9 items-center rounded-lg border border-amber-400 px-3 font-medium underline-offset-4 hover:underline"
+          to="/memories"
+        >
+          查看回忆
+        </Link>
+      </div>
+      {status.data.provider_ready ? null : (
+        <p className="mt-2 text-red-700">生图 Provider 未配置</p>
+      )}
+      {lastResult ? <p className="mt-2 text-emerald-700">{lastResult}</p> : null}
+      {extract.isError ? (
+        <p role="alert" className="mt-2 text-red-700">
+          测试操作失败：{errorMessage(extract.error)}
+        </p>
+      ) : null}
+    </section>
+  );
+}
