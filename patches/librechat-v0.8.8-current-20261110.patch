+import { readFileSync } from 'fs';
+import path from 'path';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import type { LifeSharedMemoryMessage } from 'librechat-data-provider';
+import ParlorMemoryPanel from '../ParlorMemoryPanel';
+
+const message: LifeSharedMemoryMessage = {
+  message_id: 'shmsg_test',
+  shared_memory_id: 'shared_test',
+  sender_id: 'life_other',
+  sender_kind: 'user',
+  sender_display_name: '小满',
+  body: '那天我们一起走过海边。',
+  client_message_id: 'client_test',
+  created_at: '2026-11-05T10:00:00+08:00',
+  deleted_at: null,
+  reactions: [{ emoji: '❤️', count: 1, mine: false }],
+};
+
+function renderPanel(overrides: Partial<React.ComponentProps<typeof ParlorMemoryPanel>> = {}) {
+  return render(
+    <ParlorMemoryPanel
+      title="海边的下午"
+      members={[
+        { user_id: 'life_me', display_name: '阿青' },
+        { user_id: 'life_other', display_name: '小满' },
+      ]}
+      currentUserId="life_me"
+      messages={[message]}
+      onClose={jest.fn()}
+      onSend={jest.fn().mockResolvedValue(undefined)}
+      onReact={jest.fn().mockResolvedValue(undefined)}
+      {...overrides}
+    />,
+  );
+}
+
+describe('ParlorMemoryPanel', () => {
+  beforeAll(() => {
+    Object.defineProperty(window, 'matchMedia', {
+      writable: true,
+      value: jest.fn().mockImplementation((query: string) => ({
+        matches: query.includes('prefers-reduced-motion'),
+        media: query,
+        onchange: null,
+        addEventListener: jest.fn(),
+        removeEventListener: jest.fn(),
+        addListener: jest.fn(),
+        removeListener: jest.fn(),
+        dispatchEvent: jest.fn(),
+      })),
+    });
+    Object.defineProperty(HTMLElement.prototype, 'scrollTo', {
+      writable: true,
+      value: jest.fn(),
+    });
+  });
+
+  it('retains the draft and never reports success when sending fails', async () => {
+    const onSend = jest.fn().mockRejectedValue({ response: { data: { detail: { code: 'OFFLINE' } } } });
+    renderPanel({ onSend });
+    const input = screen.getByLabelText('共同回忆消息');
+
+    fireEvent.change(input, { target: { value: '我想补充一个细节' } });
+    fireEvent.click(screen.getByRole('button', { name: '发送' }));
+
+    await waitFor(() => {
+      expect(screen.getByRole('alert')).toHaveTextContent('发送失败，草稿已保留');
+    });
+    expect(input).toHaveValue('我想补充一个细节');
+    expect(screen.getByRole('button', { name: '发送' })).toBeEnabled();
+  });
+
+  it('shows an explicit pending state and disables duplicate sends', () => {
+    renderPanel({ pending: true });
+
+    expect(screen.getByText(/Agent 正在核对权限/)).toBeInTheDocument();
+    expect(screen.getByLabelText('拾光 AI 正在响应')).toBeInTheDocument();
+    expect(screen.getByRole('button', { name: '发送' })).toBeDisabled();
+  });
+
+  it('sends a reaction for the selected message', async () => {
+    const onReact = jest.fn().mockResolvedValue(undefined);
+    renderPanel({ onReact });
+
+    fireEvent.click(screen.getByRole('button', { name: /回应 ❤️/ }));
+    await waitFor(() => expect(onReact).toHaveBeenCalledWith('shmsg_test', '❤️'));
+  });
+
+  it('keeps Parlor styling scoped and includes mobile and reduced-motion rules', () => {
+    const css = readFileSync(path.resolve(__dirname, '../ParlorMemoryPanel.css'), 'utf8');
+
+    expect(css).toContain('@media (max-width: 1023px)');
+    expect(css).toContain('position: fixed');
+    expect(css).toContain('@media (prefers-reduced-motion: reduce)');
+    expect(css).not.toMatch(/(^|\n)\s*(body|html|:root|button|input)\s*[{,]/);
+    expect(css).not.toContain('.cs-');
+  });
+});
