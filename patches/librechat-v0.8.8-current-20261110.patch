@@ -0,0 +1,89 @@
+import { useEffect } from 'react';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { useQuery } from '@tanstack/react-query';
+import { NavLink, useLocation } from 'react-router-dom';
+import { BellRing, BookOpen, HeartHandshake, MessagesSquare } from 'lucide-react';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function Navigation({ compact = false }: { compact?: boolean }) {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const { pathname, search } = useLocation();
+  const storageKey = `life:last-chat:${user?.id ?? ''}`;
+  const notifications = useQuery({
+    queryKey: [QueryKeys.lifeNotifications, user?.id],
+    queryFn: ({ signal }) => lifeService.notifications(signal),
+    enabled: Boolean(user?.id),
+    retry: false,
+    refetchInterval: 30_000,
+  });
+  const unread = (notifications.data?.notifications ?? []).filter(
+    (notification) => !notification.read_at && !notification.muted,
+  ).length;
+  useEffect(() => {
+    if (/^\/c\/[^/]+$/.test(pathname)) {
+      sessionStorage.setItem(storageKey, pathname + search);
+    }
+  }, [pathname, search, storageKey]);
+  const previous = /^\/c\/[^/]+$/.test(pathname)
+    ? pathname + search
+    : sessionStorage.getItem(storageKey);
+  const chatPath = previous && /^\/c\/[^/]+(?:\?.*)?$/.test(previous) ? previous : '/c/new';
+  return (
+    <nav
+      aria-label={localize('com_life_navigation')}
+      className={compact ? 'flex flex-col gap-2' : 'flex gap-2'}
+    >
+      {[
+        {
+          to: chatPath,
+          Icon: MessagesSquare,
+          label: localize('com_life_chat'),
+          active: pathname.startsWith('/c/'),
+        },
+        {
+          to: '/memories',
+          Icon: BookOpen,
+          label: localize('com_life_memories'),
+          active: pathname.startsWith('/memories'),
+        },
+        {
+          to: '/reminders',
+          Icon: BellRing,
+          label: localize('com_life_reminders'),
+          active: pathname.startsWith('/reminders'),
+        },
+        {
+          to: '/connections',
+          Icon: HeartHandshake,
+          label: '亲友与空间',
+          active:
+            pathname.startsWith('/connections') ||
+            pathname.startsWith('/spaces/') ||
+            pathname.startsWith('/messages/') ||
+            pathname.startsWith('/shared-memories/'),
+          badge: unread,
+        },
+      ].map(({ to, Icon, label, active, badge }) => (
+        <NavLink
+          key={label}
+          to={to}
+          aria-current={active ? 'page' : undefined}
+          title={label}
+          className={`relative flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-lg px-2 text-sm text-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring-primary ${active ? 'bg-surface-active' : 'hover:bg-surface-hover'}`}
+        >
+          <Icon className="size-5 shrink-0" aria-hidden="true" />
+          <span className={compact ? 'sr-only' : 'hidden sm:inline'}>{label}</span>
+          {badge ? (
+            <span
+              className="absolute right-0 top-0 grid min-w-5 translate-x-1/4 -translate-y-1/4 place-items-center rounded-full bg-[#b64232] px-1 text-[10px] font-bold leading-5 text-white"
+              aria-label={`${badge} 条未读亲友消息`}
+            >
+              {badge > 9 ? '9+' : badge}
+            </span>
+          ) : null}
+        </NavLink>
+      ))}
+    </nav>
+  );
+}
