@@ -0,0 +1,286 @@
+import { useEffect, useRef, useState } from 'react';
+import { useQuery } from '@tanstack/react-query';
+import { Button, Spinner } from '@librechat/client';
+import { QueryKeys, lifeService } from 'librechat-data-provider';
+import { Link, useLocation, useParams, useSearchParams } from 'react-router-dom';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+const formatTime = (value: string) =>
+  new Intl.DateTimeFormat('zh-CN', {
+    timeZone: 'Asia/Hong_Kong',
+    dateStyle: 'long',
+    timeStyle: 'short',
+  }).format(new Date(value));
+
+function readableContent(content: string, title: string) {
+  const footer = content.indexOf('\n\n> AI 生活伙伴记录 · 事件 `');
+  if (footer < 0) {
+    return content;
+  }
+  const body = content.slice(0, footer);
+  const heading = `# ${title}\n\n`;
+  return body.startsWith(heading) ? body.slice(heading.length) : body;
+}
+
+export default function Memories() {
+  const { user, isAuthenticated } = useAuthContext();
+  const localize = useLocalize();
+  const { memoryId } = useParams();
+  const location = useLocation();
+  const [params, setParams] = useSearchParams();
+  const [search, setSearch] = useState(params.get('q') ?? '');
+  const scrollRef = useRef<HTMLDivElement>(null);
+  const queryString = params.toString();
+  const scrollKey = `life:scroll:${user?.id}:${queryString}`;
+  const list = useQuery({
+    queryKey: [QueryKeys.lifeMemories, user?.id, queryString],
+    queryFn: ({ signal }) => lifeService.memories(queryString, signal),
+    enabled: isAuthenticated && !memoryId,
+    retry: false,
+    staleTime: 0,
+  });
+  const detail = useQuery({
+    queryKey: [QueryKeys.lifeMemory, user?.id, memoryId],
+    queryFn: ({ signal }) => lifeService.memory(memoryId ?? '', signal),
+    enabled: isAuthenticated && !!memoryId,
+    retry: false,
+    staleTime: 0,
+  });
+  const query = memoryId ? detail : list;
