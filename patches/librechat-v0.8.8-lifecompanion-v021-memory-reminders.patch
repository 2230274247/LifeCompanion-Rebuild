@@ -0,0 +1,58 @@
+import { useEffect } from 'react';
+import { NavLink, useLocation } from 'react-router-dom';
+import { BellRing, BookOpen, MessagesSquare } from 'lucide-react';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function Navigation({ compact = false }: { compact?: boolean }) {
+  const { user } = useAuthContext();
+  const localize = useLocalize();
+  const { pathname, search } = useLocation();
+  const storageKey = `life:last-chat:${user?.id ?? ''}`;
+  useEffect(() => {
+    if (/^\/c\/[^/]+$/.test(pathname)) {
+      sessionStorage.setItem(storageKey, pathname + search);
+    }
+  }, [pathname, search, storageKey]);
+  const previous = /^\/c\/[^/]+$/.test(pathname)
+    ? pathname + search
+    : sessionStorage.getItem(storageKey);
+  const chatPath = previous && /^\/c\/[^/]+(?:\?.*)?$/.test(previous) ? previous : '/c/new';
+  return (
+    <nav
+      aria-label={localize('com_life_navigation')}
+      className={compact ? 'flex flex-col gap-2' : 'flex gap-2'}
+    >
+      {[
+        {
+          to: chatPath,
+          Icon: MessagesSquare,
+          label: localize('com_life_chat'),
+          active: pathname.startsWith('/c/'),
+        },
+        {
+          to: '/memories',
+          Icon: BookOpen,
+          label: localize('com_life_memories'),
+          active: pathname.startsWith('/memories'),
+        },
+        {
+          to: '/reminders',
+          Icon: BellRing,
+          label: localize('com_life_reminders'),
+          active: pathname.startsWith('/reminders'),
+        },
+      ].map(({ to, Icon, label, active }) => (
+        <NavLink
+          key={label}
+          to={to}
+          aria-current={active ? 'page' : undefined}
+          title={label}
+          className={`flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-lg px-2 text-sm text-text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-ring-primary ${active ? 'bg-surface-active' : 'hover:bg-surface-hover'}`}
+        >
+          <Icon className="size-5 shrink-0" aria-hidden="true" />
+          <span className={compact ? 'sr-only' : 'hidden sm:inline'}>{label}</span>
+        </NavLink>
+      ))}
+    </nav>
+  );
+}
