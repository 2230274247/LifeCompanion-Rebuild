+import React from 'react';
+import { lifeService } from 'librechat-data-provider';
+import { MemoryRouter, Route, Routes } from 'react-router-dom';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { resolveTheme, validateThemeDefinition } from '@librechat/client';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { lifeTheme } from '../theme';
+import Memories from '../Memories';
+
+jest.mock('~/hooks', () => ({
+  useAuthContext: () => ({ user: { id: 'owner-a' }, isAuthenticated: true }),
+  useLocalize: () => (key: string) => key,
+}));
+
+const memory = {
+  event_id: 'evt_012345678901234567890123',
+  title: '真实生活片段',
+  summary: '原始摘要',
+  content: 'Memos 实际内容',
+  occurred_at: '2026-11-02T15:00:00+08:00',
+  source_type: 'chat',
+  source_message_ids: ['source-message'],
+  conversation_id: 'owned-chat',
+  event_type: 'life_event',
+  tags: ['生活回忆'],
+};
+
+function mount(path = '/memories') {
+  const client = new QueryClient({ defaultOptions: { queries: { retry: false, cacheTime: 0 } } });
+  render(
+    <QueryClientProvider client={client}>
+      <MemoryRouter initialEntries={[path]}>
+        <Routes>
+          <Route path="/memories" element={<Memories />} />
+          <Route path="/memories/:memoryId" element={<Memories />} />
+        </Routes>
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+
+test('loads real content through detail and returns to the filtered list', async () => {
+  const list = jest.spyOn(lifeService, 'memories').mockResolvedValue({
+    memories: [memory],
+    total: 1,
+    page: 1,
+    page_size: 20,
+    has_more: false,
+  });
+  jest.spyOn(lifeService, 'memory').mockResolvedValue({ memory });
+  mount('/memories?q=公园');
+  fireEvent.click(await screen.findByRole('link', { name: /真实生活片段/ }));
+  expect(await screen.findByText('Memos 实际内容')).toBeInTheDocument();
+  expect(screen.getByRole('link', { name: 'com_life_open_chat' })).toHaveAttribute(
+    'href',
+    '/c/owned-chat',
+  );
+  fireEvent.click(screen.getByRole('link', { name: 'com_life_back' }));
+  await waitFor(() => expect(list).toHaveBeenCalledWith('q=%E5%85%AC%E5%9B%AD', expect.anything()));
+});
+
+test('renders a real empty result without fabricating cards', async () => {
+  jest.spyOn(lifeService, 'memories').mockResolvedValue({
+    memories: [],
+    total: 0,
+    page: 1,
+    page_size: 20,
+    has_more: false,
+  });
+  mount();
+  expect(await screen.findByText('com_life_empty')).toBeInTheDocument();
+  expect(screen.queryByText(memory.title)).not.toBeInTheDocument();
+});
+
+test('shows the memo body while keeping generated audit identifiers out of the reading view', async () => {
+  jest.spyOn(lifeService, 'memory').mockResolvedValue({
+    memory: {
+      ...memory,
+      content: `# ${memory.title}\n\n保留这段真实正文。\n\n> AI 生活伙伴记录 · 事件 \`evt_internal\`\n> 来源消息：\`source_internal\`\n\n#生活回忆`,
+    },
+  });
+  mount(`/memories/${memory.event_id}`);
+  expect(await screen.findByText('保留这段真实正文。')).toBeInTheDocument();
+  expect(screen.queryByText(/evt_internal|source_internal/)).not.toBeInTheDocument();
+  expect(screen.getByRole('link', { name: 'com_life_open_chat' })).toHaveAttribute(
+    'href',
+    '/c/owned-chat',
+  );
+});
+
+test('upstream error is visible and retry recovers', async () => {
+  jest
+    .spyOn(lifeService, 'memories')
+    .mockRejectedValueOnce(new Error('upstream unavailable'))
+    .mockResolvedValue({ memories: [memory], total: 1, page: 1, page_size: 20, has_more: false });
+  mount();
+  expect(await screen.findByRole('alert')).toHaveTextContent('com_life_error');
+  fireEvent.click(screen.getByRole('button', { name: 'com_ui_retry' }));
+  expect(await screen.findByText(memory.title)).toBeInTheDocument();
+});
+
+test('brand uses the validated registry and supports dark mode', () => {
+  expect(validateThemeDefinition(lifeTheme)).toEqual([]);
+  expect(resolveTheme(lifeTheme, 'light').colors['rgb-surface-primary']).toBe('250 246 234');
+  expect(resolveTheme(lifeTheme, 'dark').colors['rgb-accent-primary']).toBe('243 216 139');
+});
