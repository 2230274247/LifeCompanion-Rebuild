+                      value={editTime}
+                    />
+                  </label>
+                  <Button aria-label={localize('com_ui_save')} disabled={pending} type="submit">
+                    <Check aria-hidden="true" className="size-4" />
+                  </Button>
+                  <Button
+                    aria-label={localize('com_ui_cancel')}
+                    disabled={pending}
+                    onClick={() => setEditing(null)}
+                    type="button"
+                    variant="ghost"
+                  >
+                    <X aria-hidden="true" className="size-4" />
+                  </Button>
+                </form>
+              ) : (
+                <div className="flex flex-wrap items-center justify-between gap-3">
+                  <div className="min-w-0">
+                    <p className="break-words font-medium">{item.title}</p>
+                    <p className="mt-1 text-sm text-text-secondary">
+                      {formatDate(item.scheduled_at, locale)}
+                      <span className="mx-2" aria-hidden="true">
+                        ·
+                      </span>
+                      {localize(statusLabel(item.status))}
+                    </p>
+                    {item.notification_status === 'accepted' && (
+                      <p className="mt-1 text-sm text-text-secondary">
+                        {localize('com_life_notification_accepted')}
+                      </p>
+                    )}
+                    {(item.notification_status === 'pending' ||
+                      item.notification_status === 'sending') && (
+                      <p className="mt-1 text-sm text-text-secondary">
+                        {localize('com_life_notification_pending')}
+                      </p>
+                    )}
+                  </div>
+                  {item.status === 'scheduled' || item.status === 'due' ? (
+                    <div className="flex gap-2">
+                      <Button
+                        disabled={pending}
+                        onClick={() => complete.mutate(item.reminder_id)}
+                        variant="outline"
+                      >
+                        {localize('com_life_reminder_done')}
+                      </Button>
+                      <Button
+                        aria-label={localize('com_life_reminder_edit')}
+                        className="min-h-11 min-w-11"
+                        disabled={pending}
+                        onClick={() => beginEdit(item)}
+                        variant="outline"
+                      >
+                        <Pencil aria-hidden="true" className="size-4" />
+                      </Button>
+                      <Button
+                        disabled={pending}
+                        onClick={() => {
+                          if (window.confirm(localize('com_life_reminder_cancel_confirm'))) {
+                            cancel.mutate(item.reminder_id);
+                          }
+                        }}
+                        variant="ghost"
+                      >
+                        {localize('com_life_reminder_cancel')}
+                      </Button>
+                    </div>
+                  ) : null}
+                </div>
+              )}
+            </li>
+          ))}
+        </ul>
+      </div>
+    </main>
+  );
+}
