+
+function toLocalInput(value?: string) {
+  const date = value ? new Date(value) : new Date(Date.now() + 60 * 60 * 1000);
+  const local = new Date(date.getTime() - date.getTimezoneOffset() * 60_000);
+  return local.toISOString().slice(0, 16);
+}
+
+function toIso(value: string) {
+  return new Date(value).toISOString();
+}
+
+function formatDate(value: string, locale: string) {
+  return new Intl.DateTimeFormat(locale, {
+    dateStyle: 'medium',
+    timeStyle: 'short',
+  }).format(new Date(value));
+}
+
+function statusLabel(status: LifeReminder['status']) {
+  if (status === 'completed') {
+    return 'com_life_reminder_completed' as const;
+  }
+  if (status === 'due') {
+    return 'com_life_reminder_due' as const;
+  }
+  if (status === 'cancelled') {
+    return 'com_life_reminder_cancelled_status' as const;
+  }
+  return 'com_life_reminder_scheduled' as const;
+}
+
+export default function Reminders() {
+  const { user } = useAuthContext();
