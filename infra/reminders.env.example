# Copy into ignored .env.reminders after resolving the official image digests.
VIKUNJA_IMAGE=vikunja/vikunja:2.7.1@sha256:REPLACE_WITH_VERIFIED_DIGEST
NTFY_IMAGE=binwiederhier/ntfy:v2.36.0@sha256:REPLACE_WITH_VERIFIED_DIGEST
VIKUNJA_JWT_SECRET=GENERATE_A_RANDOM_SERVER_ONLY_SECRET
# life-core reads the following from infra/.env; tokens remain in the ignored file.
LIFE_VIKUNJA_BASE_URL=http://127.0.0.1:3456/api/v2
LIFE_VIKUNJA_USERS_FILE=ABSOLUTE_PATH_TO_IGNORED_PER_USER_MAPPING_JSON
